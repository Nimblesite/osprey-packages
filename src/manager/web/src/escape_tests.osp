namespace registry_web;

/// Escape and identifier hardening: every untrusted byte reaching a
/// document is neutralized in text and attribute contexts before any
/// screen renders it. Implements the browser/cache adversarial row of
/// [PACKAGE-HOSTED-CONFORMANCE] (hostile prose cannot execute or read
/// anything).
module EscapeTests {
    /// `Html::escape` turns `input` into exactly `expected`.
    fn escaped(input, expected) = Html::escape(input) == expected

    /// `Html::id` turns `input` into exactly `expected`.
    fn identified(input, expected) = Html::id(input) == expected

    // Each line is one case: the hostile or plain text, and what it must become.
    fn entities() = checkAll("web: escape neutralizes markup, quotes and control bytes", [
        escaped("<script>alert(1)</script>", "&lt;script&gt;alert(1)&lt;/script&gt;"),
        escaped("AT&T", "AT&amp;T"),
        escaped("'", "&#39;"),
        escaped("\"", "&quot;"),
        escaped("<a href=\"x\">y</a>", "&lt;a href=&quot;x&quot;&gt;y&lt;/a&gt;"),
        escaped((fromCodePoint(27) ?: "?") + "[31m", "?[31m"),
        escaped((fromCodePoint(127) ?: "?") + "x", "?x"),
        escaped("", ""),
        escaped("plain ascii", "plain ascii")
    ])

    fn identifiers() = checkAll("web: heading identifiers collapse to the name grammar", [
        identified("@atlas/util", "-atlas-util"),
        identified("ok-name-1", "ok-name-1"),
        identified("<img src=x>", "-img-src-x-"),
        identified("\" onload=\"alert(1)", "--onload--alert-1-")
    ])

    /// The search value rides in an attribute: quote injection must fail.
    fn attributeInjection() = WebFixtures::shows("web: browse attribute injection",
        Browse::render([WebFixtures::warnedAtlasUtil()], "\" onmouseover=\"alert(1)"),
        fn(html) => contains(html, "value=\"&quot; onmouseover=&quot;alert(1)\"") && !contains(html, "onmouseover=\"alert"))

    /// Hostile warning prose and organization handles come from the
    /// registry join, not the user, and must be escaped just the same.
    fn hostileStrings() = WebFixtures::shows("web: browse hostile strings",
        Browse::render([WebFixtures::hostileOrgHandleListing(), WebFixtures::warnedAtlasUtil()], ""),
        fn(html) => contains(html, "Organization: @atlas&quot; onload=&quot;alert(1)") &&
            !contains(html, "onload=\"alert") &&
            contains(html, "&lt;/code&gt;&lt;script&gt;alert(1)&lt;/script&gt;") &&
            !contains(html, "<script>"))

    /// The suite.
    export fn run() = {
        test("web: escape entities", entities)
        test("web: identifiers", identifiers)
        test("web: browse attribute injection", attributeInjection)
        test("web: browse hostile strings", hostileStrings)
    }
}
