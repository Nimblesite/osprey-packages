namespace registry_web;

// Implements [PACKAGE-HOSTED-ROUTES-CATALOG]. Hosted pages require verified evidence.

/// The home page over the hosted `origin`, or the unavailable catalog when no origin is configured.
fn catalog(origin) = {
    let hosted = origin != ""
    let notice = if hosted { "<p id=\"catalog-status\" role=\"status\" data-error=\"The public catalog is unavailable.\">Loading packages…</p>" } else { "<p role=\"status\">The public catalog is unavailable.</p>" }
    let disabled = if hosted { "" } else { " disabled" }
    let form = "<form role=\"search\" method=\"get\" action=\"/\"><label for=\"q\">Search packages</label><div class=\"prose-search\"><input id=\"q\" name=\"q\" type=\"search\" placeholder=\"Package name or description\"${disabled}><button${disabled}>Search</button></div></form>"
    let navigation = if hosted { browseNav() } else { "" }
    let behavior = if hosted { catalogAdapter(origin) } else { "" }
    Shell::withEscapedTitle("Osprey Packages", "<main><header class=\"prose-intro\"><h1>Osprey Packages</h1><p>The package registry for the Osprey language. Find libraries for your next project, see who published them, and download the source for a specific release.</p></header>${form}<section><h2>Browse packages</h2>${navigation}${notice}<div id=\"results\"></div>${behavior}</section></main>")
}

/// The catalog adapter script tag: reads the adapter, WASI host, guest and content origin names the Makefile hashed.
fn catalogAdapter(origin) = {
    let adapter = trim(input())
    let host = trim(input())
    let guest = trim(input())
    let content = trim(input())
    "<script type=\"module\" src=\"/${adapter}\" data-catalog=\"${origin}/v1/packages\" data-content=\"${content}\" data-host=\"/${host}\" data-guest=\"/${guest}\"></script>"
}

fn hostedPackage() = {
    let origin = trim(input())
    let adapter = catalogAdapter(origin)
    Shell::withEscapedTitle("Package · Osprey Packages", "<main><p id=\"catalog-status\" class=\"prose-cover\" role=\"status\" data-missing=\"Page not found.\" data-error=\"The registry could not load this page.\">Loading packages…</p><div id=\"package-details\"></div>${adapter}</main>")
}

fn publisherAccount(origin) = if origin == "" {
    "<p role=\"status\">Public uploads are unavailable.</p><a href=\"/publishing/\">Publish to a folder registry</a>"
} else { join([
    "<div data-session-url=\"${origin}/v1/auth/session\" data-logout-url=\"${origin}/v1/auth/logout\" data-error=\"The registry could not verify your session. Reload to retry.\" data-active=\"Signed in. Publication requires a package grant and signature.\" data-logout-error=\"Could not sign out. Try again.\" data-signed-out=\"Signed out.\" data-passkey-options=\"${origin}/v1/auth/passkey/options\" data-passkey-verify=\"${origin}/v1/auth/passkey/verify\" data-passkey-error=\"Passkey sign-in did not complete. Sign in with GitHub instead.\">",
    "<p role=\"status\">Checking your registry session…</p><button hidden type=\"button\" class=\"prose-download prose-passkey\" data-passkey>Sign in with a passkey</button><a hidden class=\"prose-secondary\" href=\"${origin}/v1/auth/github/start\">Sign in with GitHub</a>",
    "<button hidden type=\"button\" class=\"prose-download\" data-sign-out>Sign out</button></div>"
], "") }

fn receiptForm() = join([
    "<section data-receipt-panel hidden><h2>Publication review</h2>",
    "<form data-receipt-form><label>Submission ID <input name=\"submission\" required maxlength=\"36\" autocomplete=\"off\"></label><button>Check status</button></form>",
    "<p role=\"status\"></p><ul data-findings></ul><button type=\"button\" data-approve hidden>Approve this version</button></section>"
], "")

fn upload() = {
    let origin = trim(input())
    let adapter = trim(input())
    let form = if origin != "" { releaseForm(origin, adapter) } else { "" }
    let cover = "<header class=\"prose-cover\"><a href=\"/\">Browse packages</a><h1>Upload a package</h1><p>Publish a release from a commit in your package’s linked repository.</p></header>"
    let steps = "<section class=\"prose-releases\"><h2>Publisher account</h2><p>Use the account with publishing permission for this package.</p>${publisherAccount(origin)}</section><aside class=\"prose-facts\"><h2>What you’ll need</h2><ol><li>A package with a linked repository</li><li>The commit you want to release</li><li>Your signing credential to authorize the submission</li></ol></aside>"
    let receipt = if origin == "" { "" } else { receiptForm() }
    Shell::withEscapedTitle("Upload a package · Osprey Packages", "<main>${cover}${form}<div class=\"prose-columns\">${steps}</div>${receipt}</main>")
}

fn releaseForm(origin, adapter) = join([
    "<section><h2>Prepare a release</h2><form data-collection-form data-review=\"review\" data-collection=\"${origin}/v1/packages\" data-empty=\"The registry has no packages.\" data-error=\"Could not load packages from the registry. Reload to retry.\">",
    "<fieldset disabled><label for=\"package\">Package</label><select id=\"package\" name=\"package\" data-collection-key=\"packages\" data-value-key=\"key\" required><option value=\"\">Choose a package</option></select>",
    "<label for=\"commit\">Git commit</label><input id=\"commit\" name=\"commit\" required pattern=\"[a-fA-F0-9]{40}\" maxlength=\"40\" title=\"Enter the full 40-character Git commit hash\"><button class=\"prose-download\">Review release</button></fieldset><p role=\"status\">Loading packages…</p></form>",
    "<article id=\"review\" tabindex=\"-1\" hidden><h3>Review release</h3><p>Package <strong data-field=\"package\"></strong><br>Commit <code data-field=\"commit\"></code></p><p>Publication requires an authorized account and a signature.</p></article></section><script type=\"module\" src=\"/${adapter}\"></script>"
], "")

fn browseNav() = "<nav class=\"prose-browse\" aria-label=\"Browse packages\"><a href=\"/publishers/\">By publisher</a><a href=\"/tags/\">By tag</a></nav>"

fn main() = print(match trim(input()) {
    "missing" => Shell::withEscapedTitle("Page not found · Osprey Packages", "<main><h1>Page not found</h1><a href=\"/\">Browse packages</a></main>")
    "guide" => Guides::packages()
    "publishing" => Guides::publishers()
    "upload" => upload()
    "hosted-package" => hostedPackage()
    "hosted-results" => {
        let path = input()
        let query = input()
        let content = input()
        HostedCatalog::render(path, query, input(), content)
    }
    _ => catalog(trim(input()))
})
