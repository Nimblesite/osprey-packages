namespace registry_web;

/// Shared presentation for the static site and registry screens.
module Shell {
    export let minimumTagPackages = 5
    /// Links for already validated manifest keywords.
    export fn keywordChips(words) = if isEmpty(words) { "None" } else {
        join(mapList(words, fn(word) => "<a class=\"prose-chip\" href=\"/tags/${word}/\">${word}</a>"), "")
    }

    export fn escape(text) = replace(replace(replace(text, "&", "&amp;") ?: "", "<", "&lt;") ?: "", ">", "&gt;") ?: ""

    export fn metadataField(label, value) = "<div><dt>${label}</dt><dd>${value}</dd></div>"

    export fn licenseBadge(expression) = "<span class=\"prose-license\" aria-label=\"License\">${escape(expression)}</span>"

    /// The escaped text of the string member `key` of a notice `item`.
    fn noticeText(item, key) = escape(jsonText(jsonField(item, key) ?: JsonNull) ?: "")

    fn documentName(item) = noticeText(item, "path")

    fn documentText(item) = {
        let text = noticeText(item, "text")
        replace(text, "\n", "&#10;") ?: text
    }

    export fn licenseLink(expression, href) = "<a class=\"prose-license\" href=\"${href}\" aria-label=\"Read license\">${escape(expression)}</a>"

    fn notice(item) = {
        "<details class=\"prose-notice\"><summary>${documentName(item)}</summary><pre>${documentText(item)}</pre></details>"
    }

    export fn noticeLink(version) = "<a href=\"#${version}-notices\">Notices and attribution</a>"

    export fn notices(version, items) = if isEmpty(items) { "" } else {
        "<section class=\"prose-notices\" id=\"${version}-notices\"><h4>Notices and attribution</h4>${join(mapList(items, notice), "")}</section>"
    }

    fn navigation() = {
        let upload = "<a href=\"/signin/\">Sign in</a><a href=\"/upload/\">Upload a package</a>"
        "<nav class=\"prose-desktop-nav\" aria-label=\"Primary\">${upload}</nav><details class=\"prose-mobile-menu\"><summary>Menu</summary><nav aria-label=\"Primary\"><a href=\"/\">Browse packages</a><a href=\"/publishers/\">By publisher</a><a href=\"/tags/\">By tag</a>${upload}</nav></details>"
    }

    let docs = "https://www.ospreylang.dev/"
    let source = "https://github.com/Nimblesite/osprey-packages"
    fn link(pair) = "<a href=\"${listGet(pair, 1) ?: ""}\">${listGet(pair, 0) ?: ""}</a>"
    fn column(heading, links) = "<nav aria-label=\"${heading}\"><h2>${heading}</h2>${join(mapList(links, link), "")}</nav>"

    /// Four link columns, then the mark and copyright [PACKAGE-REGISTRY-WEBSITE].
    fn footer() = join([
            "<footer class=\"prose-footer\"><div class=\"prose-footer-columns\">",
            column("Packages", [["Browse packages", "/"], ["By publisher", "/publishers/"], ["By tag", "/tags/"], ["Upload a package", "/upload/"]]),
            column("Publish", [["Publishing guide", "/publishing/"], ["Package guide", "/guide/"], ["Package manager docs", docs + "docs/package-manager/"]]),
            column("Osprey", [["Website", docs], ["Install", docs + "docs/installation/"], ["Documentation", docs + "docs/"], ["Specification", docs + "spec/"]]),
            column("Community", [["Discord", "https://discord.gg/EGk3XhcGyy"], ["GitHub", source], ["Issues", source + "/issues"]]),
            "</div><a class=\"prose-footer-mark\" href=\"${docs}\"><img src=\"/osprey-mark.svg?v=6efc798a098d\" width=\"56\" height=\"44\" alt=\"\">A package registry for the Osprey language</a>",
            "<p>© 2026 <a href=\"https://nimblesite.co/\">Nimblesite</a></p></footer>"], "")

    /// Shell for an already escaped title or a trusted text literal.
    export fn withEscapedTitle(title, body) = join([
            "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>",
            title, "</title><link rel=\"icon\" type=\"image/svg+xml\" href=\"/registry-mark.svg?v=b3839fb6decc\"><link rel=\"stylesheet\" href=\"/registry.1ac25024ec3a.css\"></head><body>",
            "<header class=\"prose-bar\"><a class=\"prose-brand\" href=\"/\"><img src=\"/registry-mark.svg?v=b3839fb6decc\" width=\"36\" height=\"36\" alt=\"\">Osprey Packages</a>", navigation(), "</header>", body, footer(), "</body></html>"], "")
}
