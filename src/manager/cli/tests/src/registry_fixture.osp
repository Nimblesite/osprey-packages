namespace registry_tests;
import registry_host::Host
import registry_cli::Dispatch
import registry_cli::Lockfile
import registry_cli::Fetch
import registry_cli::Reports
import registry::Bundle
import registry::ManifestJson
import registry::ManifestModel
import registry::Maybe
import registry::Names

/// A small folder registry (`@demo/one` depends on `@demo/two`; `@demo/three`
/// depends on nothing) served through fixture Web/Files handlers, and one
/// routed command run over it that records every write, so a command that
/// rewrites the manifest and relocks reads its own write back. The lock,
/// add, remove and update suites share it ([PACKAGE-FOLDER-REGISTRY] tests).
module RegistryFixture {
    /// The registry base URL the fixture serves its routes under.
    export let base = "http://127.0.0.1:8787"
    /// The absolute project directory every fixture command runs in.
    export let project = "/abs"
    /// The TOML section header every dependency-bearing fixture manifest appends.
    let depsHeader = "\n[dependencies]\n"
    /// The release lock beside the fixture project's manifest: where `lock` writes.
    export let lockPath = "/abs/osprey.lock"
    /// The root manifest of the fixture project, read and rewritten by its commands.
    export let manifestPath = "/abs/osprey.toml"
    /// A digest no served release has: the root manifest digest of every earlier lock.
    export let otherDigest = "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

    /// One `Host::Web.get` the fixture answers: the exact base, path, status and body.
    export type WebRoute = { base: string, path: string, status: int, body: string }
    /// What one run observed: the report, every write, fetch, removal, ensured
    /// directory and command run, each in order.
    export type Attempt = { report: Reports::Report, written: List<Fixture::ReadRoute>, fetched: List<string>, removed: List<string>, ensured: List<string>, ran: List<string> }

    // ---- handlers ----

    /// A route of the fixture registry's base answering 200 with `body`.
    fn webRoute(path, body) = webRouteAt(base, path, 200, body)

    /// A route of `b` answering `status` with `body`.
    export fn webRouteAt(b, path, status, body) = WebRoute { base: b, path: path, status: status, body: body }

    fn webPath(r: WebRoute) = r.path

    fn replyOf(r: WebRoute) = Host::Reply { status: r.status, etag: "", body: r.body }

    /// The reply of the route serving `path` under `b`, else the transport's own refusal.
    export fn replyFor(webs, b, path) = foldList(webs, Error { message: "http.transport: no route ${b}${path}" }, fn(answer, w) => match answer {
        Success => answer
        Error => if w.base == b && webPath(w) == path { Success { value: replyOf(w) } } else { answer }
    })

    /// The writes of a run, latest first: the order a read of a path written twice must meet.
    fn latestFirst(written) = listReverse(written)

    /// The read routes for `files` installed below `dir`.
    export fn readRoutesAt(dir, files) = mapList(files, fn(f) => Fixture::readRoute("${dir}/${f.relPath}", f.content))

    /// The read-only file operations shared by command fixtures.
    export fn readFrom(reads, path) = Fixture::readFor(reads, path)
    export fn existsAmong(reads, path) = Fixture::existsIn(reads, path)
    export fn unexpectedRemove(path) = Error { message: "fixture: unexpected remove ${path}" }

    /// Compose the four fixture handlers around one command.
    export fn runHosted(process, files, tree, web, action) = process(fn() => files(fn() => tree(fn() => web(action))))

    /// Compose the four fixture handlers around `command args`.
    export fn over(process, files, tree, web, command, args) = runHosted(process, files, tree, web, fn() => command(args))

    /// Compose the four fixture handlers around `Dispatch::run(args)`.
    fn dispatchOver(process, files, tree, web, args) = over(process, files, tree, web, Dispatch::run, args)

    /// The last text written to `path`, if any.
    fn latest(written, path) = Fixture::readFor(latestFirst(written), path)

    fn readOf(written, reads, path) = match latest(written, path) {
        Success { value } => Success { value: value }
        Error => Fixture::readFor(reads, path)
    }

    /// Run `args` through `Dispatch::run` over `reads`, `walks` and `webs`,
    /// recording every write and every command run; a read of a path written
    /// earlier in the run answers the written text.
    fn runFault(reads, walks, webs, args, partialPath) = {
        mut partial = false
        mut written: List<Fixture::ReadRoute> = []
        mut fetched: List<string> = []
        mut removed: List<string> = []
        mut ran: List<string> = []
        mut ensured: List<string> = []
        let files = handler Host::Files {
            read path => if listContains(removed, path) { Error { message: "fixture: removed ${path}" } } else { readOf(written, reads, path) }
            exists path => if listContains(removed, path) { Success { value: false } } else { Fixture::existsIn(listConcat(latestFirst(written), reads), path) }
            remove path => {
                removed = listAppend(removed, path)
                written = filterList(written, fn(w: Fixture::ReadRoute) => w.path != path)
                Success { value: 0 }
            }
            write path content => {
                removed = filterList(removed, fn(p) => p != path)
                let damaged = path == partialPath && !partial
                partial = partial || damaged
                written = listAppend(written, Fixture::readRoute(path, if damaged { take(content, 7) } else { content }))
                if damaged { Error { message: "fixture: partial write" } } else { Success { value: byteLength(content) } }
            }
        }
        let tree = handler Host::Tree {
            walk dir => Fixture::walkAfter(latestFirst(written), walks, ensured, dir)
            ensure dir => {
                ensured = listAppend(ensured, dir)
                Success { value: byteLength(dir) }
            }
        }
        let web = handler Host::Web {
            get b path => {
                fetched = listAppend(fetched, path)
                replyFor(webs, b, path)
            }
        }
        let process = handler Host::Process {
            run command => {
                ran = listAppend(ran, command)
                Host::Run { status: 0, stdout: "built\n", stderr: "" }
            }
        }
        let report = dispatchOver(process, files, tree, web, args)
        Attempt { report: report, written: written, fetched: fetched, removed: removed, ensured: ensured, ran: ran }
    }

    /// Run `args` through `Dispatch::run` over `reads`, `walks` and `webs`,
    /// recording every write, removal and command run; a read of a path written
    /// earlier in the run answers the written text.
    export fn runWith(reads, walks, webs, args) = runFault(reads, walks, webs, args, "")

    /// Run the full command with one write that changes bytes before failing.
    export fn runPartial(reads, webs, args, path) = runFault(reads, [], webs, args, path)

    /// `runWith` with no tree to walk.
    export fn run(reads, webs, args) = runWith(reads, [], webs, args)

    /// Run the read-only command `args` over `reads` and `walks`: a write, an
    /// ensure, a fetch or a process run is a fixture failure named after
    /// `label`, so no case can pass on a hidden effect.
    export fn runReadOnly(reads, walks, args, label) = {
        let files = handler Host::Files {
            read path => readFrom(reads, path)
            exists path => existsAmong(reads, path)
            remove path => unexpectedRemove(path)
            write path content => Error { message: "fixture: ${label} never writes ${path} (${byteLength(content)} bytes)" }
        }
        let tree = handler Host::Tree {
            walk dir => if isEmpty(walks) { Error { message: "fixture: ${label} never walks ${dir}" } } else { Fixture::walkFor(walks, dir) }
            ensure dir => Error { message: "fixture: ${label} never ensures ${dir}" }
        }
        let web = handler Host::Web {
            get base path => Error { message: "fixture: ${label} never fetches ${base}${path}" }
        }
        let process = handler Host::Process {
            run command => Host::Run { status: 0, stdout: "", stderr: "fixture: ${label} never runs ${command}" }
        }
        dispatchOver(process, files, tree, web, args)
    }

    /// Every write of the run, in order, as `path=content|`.
    export fn writeLogOf(a: Attempt) = Fixture::writeLog(a.written)

    /// Every directory the run ensured, in order, as `dir|`.
    export fn ensureLogOf(a: Attempt) = Fixture::ensureLog(a.ensured)

    /// The paths the run fetched, in order.
    export fn fetchedOf(a: Attempt) = a.fetched

    /// Whether the run removed `path`.
    export fn removedPath(a: Attempt, path) = listContains(a.removed, path)

    /// The commands the run executed, in order.
    export fn ranOf(a: Attempt) = a.ran

    /// The last text written to `path` during the run, "" when none.
    export fn writtenTo(a: Attempt, path) = match latest(a.written, path) {
        Success { value } => value
        Error => ""
    }

    /// How many writes hit `path`.
    export fn writesTo(a: Attempt, path) = length(filterList(a.written, fn(w: Fixture::ReadRoute) => w.path == path))

    /// The process status the run's report answers.
    export fn statusOf(a: Attempt) = a.report.status

    /// Whether the run was accepted (status 0).
    export fn accepted(a: Attempt) = statusOf(a) == 0

    /// The run's status and its first report line, the pair every refusal asserts.
    export fn reported(a: Attempt, status, code) = statusOf(a) == status && lineOf(a, 0) == code
    /// Every line of the run's report.
    export fn linesOf(a: Attempt) = a.report.lines
    /// Line `i` of the run's report, or "".
    export fn lineOf(a: Attempt, i) = Fixture::line(a.report, i)
    /// Whether every report line is exactly the expected line.
    export fn hasLines(a: Attempt, expected) = structuralEquals(linesOf(a), expected)

    // ---- the registry ----

    /// A manifest with no dependencies.
    export fn manifestText(name) = "[project]\nname = \"${name}\"\nsource_roots = [\"src\"]\n"

    fn depLine(name, epoch, floor) = "\"@demo/${name}\" = { epoch = ${epoch}, min_release = ${floor} }\n"

    fn oneManifest() = manifestText("one") + depsHeader + depLine("two", 1, 1)

    /// The root manifest depending on `@demo/one` e1 at `floor`.
    export fn rootManifest(floor) = manifestText("app") + depsHeader + depLine("one", 1, floor)

    /// The root manifest depending on `@demo/one` at `epoch` e`.r1`.
    export fn rootManifestAt(epoch) = manifestText("app") + depsHeader + depLine("one", epoch, 1)

    /// The manifest and entry file of a small fixture project.
    export fn projectFiles(manifest) = [Fixture::file("osprey.toml", manifest), Fixture::file("src/main.osp", "fn main() = 0\n")]

    fn releaseAt(dir, manifest) = Fixture::served(dir, projectFiles(manifest))

    /// `@demo/one` e1.r1: the release the root depends on, itself depending on
    /// `@demo/two` e1.r1.
    export fn one() = releaseAt("@demo/one/1.1", oneManifest())
    /// `@demo/one` at ordinal 2 of epoch 1: the release an in-epoch `update`
    /// moves to.
    export fn one2() = releaseAt("@demo/one/1.2", oneManifest())
    /// `@demo/one` in a second epoch: what `update --breaking` moves to.
    export fn oneNextEpoch() = releaseAt("@demo/one/2.1", oneManifest())
    /// `@demo/two` e1.r1: the transitive dependency of `@demo/one`.
    export fn two() = releaseAt("@demo/two/1.1", manifestText("two"))
    /// A release nothing depends on: the one a registry can drop without
    /// breaking the graph, which is what `--accept-removals` is for.
    export fn three() = releaseAt("@demo/three/1.1", manifestText("three"))
    /// `@demo/one` e1.r1 with an empty project name: a release whose manifest
    /// is rejected.
    export fn badOne() = releaseAt("@demo/one/1.1", manifestText(""))
    /// A release whose source names `readFile`: its surface is `io/files`.
    export fn ioSource(source) = Fixture::served("@demo/io/1.1", [Fixture::file("osprey.toml", manifestText("io")), Fixture::file("src/io.osp", source)])

    /// A release whose source calls `readFile`, so its surface is `io/files`.
    export fn io() = ioSource("fn load(p) = readFile(p)\n")

    /// An ambient call inside executable string interpolation.
    export fn interpolatedIo() = ioSource("fn load(p) = \"" + "$" + "{readFile(p)}\"\n")

    fn quotedList(words) = join(mapList(words, fn(w) => "\"${w}\""), ", ")

    /// The root manifest depending on `@demo/<name>` e1.r1 with a capability grant.
    export fn rootManifestGranting(name, capabilities) = manifestText("app") + "\n[dependencies]\n\"@demo/${name}\" = { epoch = 1, min_release = 1, capabilities = [${quotedList(capabilities)}] }\n"

    fn rowText(s) = "{\"digest\":\"${Fixture::digestOf(s)}\",\"epoch\":${Fixture::idOf(s).epoch},\"ordinal\":${Fixture::idOf(s).ordinal}}"

    fn releasesOf(served, k) = filterList(served, fn(s) => Fixture::keyText(s) == k)

    fn distinctKeys(served) = foldList(served, [], fn(acc, s) => if listContains(acc, Fixture::keyText(s)) { acc } else { listAppend(acc, Fixture::keyText(s)) })

    fn packageListing(served, k) = "{\"key\":\"${k}\",\"releases\":[${join(mapList(releasesOf(served, k), rowText), ",")}]}"

    fn fullListing(served) = "{\"packages\":[${join(mapList(distinctKeys(served), fn(k) => packageListing(served, k)), ",")}]}"

    fn sourceWeb(s) = sourceRoute(base, s)

    /// The source endpoint of the release with `digest`.
    export fn releaseSourcePath(digest) = "/v1/releases/${digest}/source"

    /// The source endpoint of `s`.
    export fn sourcePath(s) = releaseSourcePath(Fixture::digestOf(s))

    /// A route of `b` answering `path` with the encoded bundle of `s`.
    export fn bundleRouteAt(b, path, s) = webRouteAt(b, path, 200, Bundle::encode(s) ?: "")

    /// A route of `b` serving `s`'s own source bundle.
    export fn sourceRoute(b, s) = bundleRouteAt(b, sourcePath(s), s)

    /// The one listing request plus every release's source bundle.
    export fn websOf(served) = listPrepend(mapList(served, sourceWeb), webRoute(Fetch::packagesListingPath, fullListing(served)))

    fn manifestRead(s) = {
        let first = listGet(Fixture::filesOf(s), 0) ?: Fixture::file("osprey.toml", "")
        Fixture::readRoute("${project}/${Fetch::installDir(Fixture::idOf(s))}/osprey.toml", first.content)
    }

    /// A read route for the fixture project's root manifest.
    export fn rootRead(rootText) = Fixture::readRoute(manifestPath, rootText)

    /// The root manifest plus every served release's installed manifest.
    export fn reads(rootText, served) = listPrepend(mapList(served, manifestRead), rootRead(rootText))

    /// `reads` plus a current lock.
    export fn readsWithLock(rootText, lockText, served) = listPrepend(reads(rootText, served), Fixture::readRoute(lockPath, lockText))

    // ---- expected values ----

    fn runtime(key, epoch, floor) = ManifestModel::Runtime { requirement: ManifestModel::Requirement { package: key, epoch: epoch, minimumOrdinal: floor } }

    /// The lock package of `s` with `deps` as its edges and no pinned surface.
    export fn pkg(s, deps) = Lockfile::Package { release: Fixture::idOf(s), dependencies: deps, surface: [] }

    /// A lock package with a pinned capability surface.
    export fn pkgWith(s, deps, surface) = Lockfile::Package { release: Fixture::idOf(s), dependencies: deps, surface: surface }

    /// The key of the root's one dependency, which the local checkout replaces.
    export fn oneKey() = Names::Key { scope: "demo", name: "one" }

    /// The transitive dependency shared by the fixture releases.
    export fn twoKey() = Names::Key { scope: "demo", name: "two" }

    /// `@demo/one`'s lock package: its Runtime edge on `@demo/two`.
    export fn onePkg(s) = pkg(s, [runtime(twoKey(), 1, 1)])

    /// The release-lock text for root manifest digest `digest`, root edges
    /// `deps` and `packages`, or "" when it does not encode.
    export fn lockText(digest, deps, packages) = Lockfile::encode(Lockfile::release(Lockfile::Root { manifestDigest: digest, dependencies: deps }, packages)) ?: ""

    fn edgesOf(m: ManifestModel::Manifest) = m.dependencies

    /// The lock `lock` must write for `rootText` over `packages`.
    export fn expectedLockOf(rootText, packages) = {
        let m = Fixture::manifestOf(rootText)
        lockText(ManifestJson::digest(m) ?: "", edgesOf(m), packages)
    }

    fn encodedLock(rootText, packages, overrides, python) = {
        let m = Fixture::manifestOf(rootText)
        Lockfile::encode(Lockfile::Lock { root: Lockfile::Root { manifestDigest: ManifestJson::digest(m) ?: "", dependencies: edgesOf(m) }, packages: packages, overrides: overrides, python: python }) ?: ""
    }

    /// The development lock `lock --local` must write for `rootText`.
    export fn devLockText(rootText, packages, overrides) = encodedLock(rootText, packages, overrides, Maybe::none())

    /// The lock `lock` must write for `rootText` over `packages` with the uv plane pinned.
    export fn pythonLockText(rootText, packages, pins) = encodedLock(rootText, packages, [], Maybe::some(pins))

    /// The lock `lock` must write for `rootText` over `one` and `two`.
    export fn expectedLock(rootText, oneServed, twoServed) = expectedLockOf(rootText, [onePkg(oneServed), pkg(twoServed, [])])

    /// A current lock written by an earlier run over `one` and `two`.
    export fn previousLock(oneServed, twoServed) = lockText(otherDigest, [], [onePkg(oneServed), pkg(twoServed, [])])

    /// An earlier lock that also pinned `three`, which the registry since dropped.
    export fn previousLockWithThree() = lockText(otherDigest, [], [onePkg(one()), pkg(three(), []), pkg(two(), [])])

    /// The `@scope/name eE.rR sha256:…` spelling of a served release's identity.
    export fn compact(s) = Lockfile::compact(Fixture::idOf(s))

    /// The report line naming served release `s` under change marker `marker` (`+`, `-`, `=` or `~`).
    export fn deltaLine(marker, s) = "${marker} ${compact(s)}"

    /// `deltaLine` for every package of `pkgs`, in order.
    export fn deltaLines(marker, pkgs) = mapList(pkgs, fn(p) => deltaLine(marker, p))
}
