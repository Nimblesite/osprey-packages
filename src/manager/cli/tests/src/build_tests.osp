namespace registry_tests;
import registry_host::Host
import registry_cli::Build
import registry_cli::Fetch
import registry_cli::Folds
import registry_cli::Lockfile
import registry_cli::Reports
import registry_cli::Project
import registry::ManifestJson

/// `build [--run]` against fixture hosts: the offline verify must pass before
/// the derived project is written and the compiler invoked; the derived
/// `osprey.toml` uses each package's own `source_roots` and `python_sources`
/// ([PACKAGE-HARDENING] C6), and a package whose manifest is rejected fails
/// with `build.manifest` before any compiler run. Implements
/// [PACKAGE-FOLDER-REGISTRY] build tests.
module BuildTests {
    let compilerPath = "osprey"
    let project = "/abs"
    let derivedPath = ".osprey/build/osprey.toml"

    /// What one run observed: the report, the derived project it wrote (an
    /// empty route until then), the ensured directories and the compiler
    /// commands, each "" when none.
    type Attempt = { report: Reports::Report, derived: Fixture::ReadRoute, ensures: string, commands: string }

    fn runWith(entry, reads, walks, args) = {
        mut derived = Fixture::readRoute("", "")
        mut ensures = ""
        mut commands = ""
        let files = handler Host::Files {
            read path => RegistryFixture::readFrom(reads, path)
            remove path => RegistryFixture::unexpectedRemove(path)
            exists path => RegistryFixture::existsAmong(reads, path)
            write path content => {
                derived = Fixture::readRoute(path, content)
                Success { value: byteLength(content) }
            }
        }
        let tree = handler Host::Tree {
            walk dir => Fixture::walkFor(walks, dir)
            ensure dir => {
                ensures = "${ensures}${dir}|"
                Success { value: 0 }
            }
        }
        let web = handler Host::Web {
            get base path => Error { message: "fixture: build never fetches ${base}${path}" }
        }
        let process = handler Host::Process {
            run command => {
                commands = "${commands}${command}|"
                Host::Run { status: 0, stdout: "built\n", stderr: "" }
            }
        }
        let report = RegistryFixture::over(process, files, tree, web, entry, args)
        Attempt { report: report, derived: derived, ensures: ensures, commands: commands }
    }

    fn runBuild(reads, walks, args) = runWith(Build::run, reads, walks, args)

    // ---- the project and its two packages ----

    fn manifestText() = "[project]\nname = \"app\"\nsource_roots = [\"src\"]\ndefault_namespace = \"app\"\nentry = \"src/main.osp\"\n"

    fn oneManifest() = "[project]\nname = \"one\"\nsource_roots = [\"lib\", \"src\"]\npython_sources = [\"src/model.py\"]\n"

    fn twoManifest() = "[project]\nname = \"two\"\nsource_roots = [\"src\"]\ntypescript_sources = [\"src/app.ts\"]\n"

    fn one() = Fixture::served("@demo/one/1.1", [
            Fixture::file("osprey.toml", oneManifest()),
            Fixture::file("lib/one.osp", "fn one() = 1\n"),
            Fixture::file("src/model.py", "# osprey: flavor=python\ndef model():\n    return 1\n")
    ])

    fn two() = Fixture::served("@demo/two/1.1", [Fixture::file("osprey.toml", twoManifest()), Fixture::file("src/two.osp", "fn two() = 2\n")])

    fn bad() = Fixture::served("@demo/one/1.1", [
            Fixture::file("osprey.toml", "[project]\nname = \"\"\nsource_roots = [\"src\"]\n"),
            Fixture::file("src/one.osp", "fn one() = 1\n")
    ])

    fn pkgOf(s) = Lockfile::Package { release: Fixture::idOf(s), dependencies: [], surface: [] }

    /// The lock whose manifest digest matches the project's manifest.
    fn matchingLock(packages) = RegistryFixture::lockText(ManifestJson::digest(Fixture::manifestOf(manifestText())) ?: "", [], packages)

    fn installDir(s) = Fetch::installDirAt(project, Fixture::idOf(s))

    fn readsFor(s) = RegistryFixture::readRoutesAt(installDir(s), Fixture::filesOf(s))

    fn walkOf(s) = InstallTests::installedWalk(installDir(s), s)

    /// The project's manifest and lock, then every package's installed files.
    fn readsOf(lock, packages) = listConcat(
        RegistryFixture::readsWithLock(manifestText(), lock, []),
        Folds::flatMap(packages, readsFor))

    fn walksOf(packages) = mapList(packages, walkOf)

    fn quoted(path) = "\"${path}\""

    fn packagePath(s, path) = quoted("../../${Fetch::installDir(Fixture::idOf(s))}/${path}")

    /// The derived project: the root's own roots first, then each package's
    /// own roots in lock order; the Python and TypeScript sources likewise.
    fn derivedText() = {
        let roots = [quoted("../../src"), packagePath(one(), "lib"), packagePath(one(), "src"), packagePath(two(), "src")]
        let python = [packagePath(one(), "src/model.py")]
        let typescript = [packagePath(two(), "src/app.ts")]
        join([
                "[project]",
                "name = \"app\"",
                "source_roots = [${join(roots, ", ")}]",
                "python_sources = [${join(python, ", ")}]",
                "typescript_sources = [${join(typescript, ", ")}]",
                "default_namespace = \"app\"",
                "entry = " + quoted("../../src/main.osp"),
                "[modules]",
                "allow_wildcard_imports = false"
            ], "\n")
    }

    // ---- cases ----

    /// The plain project build over `packages`: a matching lock, their reads
    /// and walks, `--project`.
    fn buildWith(packages, args) = runBuild(readsOf(matchingLock(mapList(packages, pkgOf)), packages), walksOf(packages), args)

    fn buildAll(packages) = buildWith(packages, ["--project", project])

    fn standardPackages() = [one(), two()]

    /// A passing verify writes the exact derived project and runs the compiler.
    fn derived() = {
        let packages = standardPackages()
        let a = buildAll(packages)
        checkAll("the derived osprey.toml is exact and the compiler runs", [
                a.report.status == 0,
                a.derived.content == derivedText(),
                a.derived.path == "${project}/${derivedPath}",
                a.ensures == "${project}/.osprey/build|",
                a.commands == "'${compilerPath}' build '${project}/.osprey/build' -o '${project}/.osprey/build/app'|",
                Fixture::line(a.report, 0) == "built"
        ])
    }

    /// `build --run` compiles through the run form.
    fn runForm() = {
        let a = buildWith(standardPackages(), ["--run", "--project", project])
        checkAll("build --run invokes the compiler run form", [
                a.report.status == 0,
                a.commands == "'${compilerPath}' '${project}/.osprey/build' --run|"
        ])
    }

    fn relativeBuildAt(dir, args) = {
        let text = manifestText() + "python_sources = [\"src/model.py\"]\ntypescript_sources = [\"src/view.ts\"]\n"
        let lock = RegistryFixture::lockText(ManifestJson::digest(Fixture::manifestOf(text)) ?: "", [], [])
        let reads = [Fixture::readRoute(Project::manifestPathAt(dir), text), Fixture::readRoute(Project::lockPathAt(dir), lock)]
        let a = runBuild(reads, [], args)
        checkAll("relative project ${dir} is rebased from the derived manifest", [
                a.report.status == 0,
                a.derived.path == Project::pathAt(dir, derivedPath),
                containsAll(a.derived.content, ["source_roots = [\"../../src\"]", "python_sources = [\"../../src/model.py\"]", "typescript_sources = [\"../../src/view.ts\"]"]),
                contains(a.derived.content, "entry = \"../../src/main.osp\"")
        ])
    }

    fn relativeBuilds() = {
        relativeBuildAt(".", [])
        relativeBuildAt(".", ["--run"])
        relativeBuildAt("some/project", ["--project", "some/project"])
    }

    fn relativePythonSources() = {
        let a = buildAll(standardPackages())
        checkAll("derived Python sources obey the compiler's manifest-relative path contract", [
                a.report.status == 0,
                !contains(a.derived.content, "python_sources = [\"/"),
                !contains(a.derived.content, "typescript_sources = [\"/")
        ])
    }

    /// A failing verify runs no compiler and writes nothing.
    fn verifyFailure() = {
        let packages = standardPackages()
        let a = runBuild(readsOf(RegistryFixture::lockText(RegistryFixture::otherDigest, [], mapList(packages, pkgOf)), packages), walksOf(packages), ["--project", project])
        checkAll("a verify failure is the build's failure and compiles nothing", [
                a.report.status == 1,
                structuralEquals([Fixture::line(a.report, 0), a.derived.path, a.ensures], ["verify.manifest-digest", "", ""]),
                a.commands == ""
        ])
    }

    /// A package whose installed manifest is rejected is `build.manifest`.
    fn buildManifestRejected() = {
        let packages = [bad(), two()]
        let a = buildAll(packages)
        checkAll("a rejected package manifest is build.manifest with no compiler run", [
                a.report.status == 1,
                startsWith(Fixture::line(a.report, 0), "build.manifest @demo/one manifest.project.name at "),
                structuralEquals([a.derived.path, a.commands], ["", ""])
        ])
    }

    /// Bare `run` and `test` invoke the compiler without network, selecting the
    /// release lock when no override is active and the development lock when an
    /// overlay is active ([PACKAGE-LOCAL-OVERRIDE]).
    fn runAndTestCommands() = {
        let packages = standardPackages()
        let lock = matchingLock(mapList(packages, pkgOf))
        let reads = readsOf(lock, packages)
        let walks = walksOf(packages)
        let ran = runWith(Build::exec, reads, walks, ["--project", project])
        let tested = runWith(Build::runTest, reads, walks, ["--project", project])
        let overlay = Fixture::readRoute("${project}/.osprey/local-overrides.json", "{\"overrides\":[{\"key\":\"@demo/one\",\"path\":\"../one\"}]}")
        let localLock = Fixture::readRoute("${project}/osprey.local.lock", lock)
        let localReads = listConcat([overlay, localLock], reads)
        let ranLocal = runWith(Build::exec, localReads, walks, ["--project", project])
        let testedLocal = runWith(Build::runTest, localReads, walks, ["--project", project])
        checkAll("bare run and test select release or development lock offline", [
                ran.report.status == 0,
                ran.commands == "'${compilerPath}' '${project}/.osprey/build' --run|",
                tested.report.status == 0,
                tested.commands == "'${compilerPath}' test '${project}/.osprey/build'|",
                ranLocal.report.status == 0,
                ranLocal.commands == "'${compilerPath}' '${project}/.osprey/build' --run|",
                testedLocal.report.status == 0,
                testedLocal.commands == "'${compilerPath}' test '${project}/.osprey/build'|"
        ])
    }

    /// Every build test.
    export fn run() = {
        test("build: derived project bytes and compiler invocation", derived)
        test("build: --run invokes the run form", runForm)
        test("build: bare run and test select lock offline", runAndTestCommands)
        test("build: default and relative source paths", relativeBuilds)
        test("build: Python sources remain manifest-relative", relativePythonSources)
        test("build: a verify failure compiles nothing", verifyFailure)
        test("build: a rejected package manifest is build.manifest", buildManifestRejected)
    }
}
