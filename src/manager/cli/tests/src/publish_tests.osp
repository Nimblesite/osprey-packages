namespace registry_tests;

/// `publish --folder` against fixture hosts: the release tree is the
/// manifest plus the files under the source roots (locks, notes and build
/// output stay behind), it lands at the next ordinal of the newest epoch or
/// at `1.1`, `--breaking` opens the next epoch, the printed digest is the
/// one the server will compute, and a project without `[package]` or a run
/// without `--folder` is refused before anything is written.
module PublishTests {
    let project = "/abs"
    /// The manifest's entry file.
    let mainPath = "src/main.osp"
    let folder = "/reg"
    /// What the project directory holds: the release's files among a lock, notes and build caches.
    let projectEntries = ["notes.md", "osprey.lock", "osprey.toml", mainPath, "src/.deslop/cache/fingerprint.bin", "src/.osprey/cache/entry.bin", "src/__pycache__/module.pyc", "src/nested/.git/index"]

    fn manifestText() = "[project]\nname = \"one\"\nsource_roots = [\"src\"]\n\n[package]\nname = \"@demo/one\"\nlicense = \"MIT\"\nsummary = \"one\"\nkeywords = [\"one\"]\n"

    fn files() = RegistryFixture::projectFiles(manifestText())

    /// The project directory holds more than the release: a lock and notes.
    fn projectWalk() = Fixture::walkRoute(project, projectEntries)

    fn projectReads() = listConcat(RegistryFixture::readRoutesAt(project, files()), [
            Fixture::readRoute("${project}/notes.md", "scratch"),
            Fixture::readRoute("${project}/osprey.lock", "{}")
    ])

    fn existingWalk() = Fixture::walkRoute("${folder}/@demo/one", ["1.1/osprey.toml", "1.1/src/main.osp", "1.2/osprey.toml", "1.2/src/main.osp"])

    /// `publish --folder` over `reads` with no existing releases: a new package lands at 1.1.
    fn publish(reads) = RegistryFixture::runWith(reads, [projectWalk()], [], ["publish", "--folder", folder, "--project", project])

    fn publishExisting(args) = RegistryFixture::runWith(projectReads(), [projectWalk(), existingWalk()], [], args)

    fn expectedDigest(dir) = Fixture::digestOf(Fixture::served(dir, files()))

    fn excludedAt(a, dir) = foldList(excludedFiles(), true, fn(ok, path) => ok && RegistryFixture::writesTo(a, "${folder}/${dir}/${path}") == 0)

    /// The project entries the publisher must leave behind: every one that is not the release's own.
    fn excludedFiles() = filterList(projectEntries, fn(p) => !listContains(releasePaths(), p))

    fn releasePaths() = mapList(files(), fn(f) => f.relPath)

    /// The release landed at `dir`: its manifest and entry file, nothing else the project holds.
    fn publishedAt(a, dir) = RegistryFixture::writtenTo(a, "${folder}/${dir}/osprey.toml") == manifestText()
    && RegistryFixture::writtenTo(a, "${folder}/${dir}/src/main.osp") == "fn main() = 0\n"
    && excludedAt(a, dir)

    /// `publishedAt`, and line 0 announces `@demo/one` `release` with the server's digest.
    fn publishedWithDigest(a, dir, release) = publishedAt(a, dir) && RegistryFixture::lineOf(a, 0) == "published @demo/one ${release} ${expectedDigest(dir)}"

    /// The next ordinal of the newest epoch.
    fn nextOrdinal() = {
        let a = publishExisting(["publish", "--folder", folder, "--project", project])
        checkAll("publish places the release at the next ordinal with the server's digest", [
                RegistryFixture::statusOf(a) == 0,
                publishedWithDigest(a, "@demo/one/1.3", "e1.r3"),
                RegistryFixture::lineOf(a, 2) == "files: 2"
        ])
    }

    /// `--breaking` opens the next epoch; a new package starts at 1.1.
    fn epochs() = {
        let breaking = publishExisting(["publish", "--folder", folder, "--breaking", "--project", project])
        let first = publish(projectReads())
        checkAll("--breaking opens epoch 2; a new package is 1.1", [
                structuralEquals([RegistryFixture::statusOf(breaking), RegistryFixture::statusOf(first)], [0, 0]),
                publishedWithDigest(breaking, "@demo/one/2.1", "e2.r1"),
                publishedAt(first, "@demo/one/1.1")
        ])
    }

    /// No `[package]`, no `--folder`, and a tree the source rules refuse.
    fn refusals() = {
        let plain = publish([Fixture::readRoute("${project}/osprey.toml", RegistryFixture::manifestText("app"))])
        let noFolder = RegistryFixture::runWith(projectReads(), [projectWalk()], [], ["publish", "--project", project])
        let badPython = RegistryFixture::runWith(listAppend(projectReads(), Fixture::readRoute("${project}/src/model.py", "print(1)\n")), [Fixture::walkRoute(project, ["osprey.toml", mainPath, "src/model.py"])], [], ["publish", "--folder", folder, "--project", project])
        checkAll("publish.no-package, publish.usage and the source rules refuse before writing", [
                structuralEquals([RegistryFixture::statusOf(plain), RegistryFixture::statusOf(noFolder)], [1, 2]),
                RegistryFixture::statusOf(badPython) == 1,
                RegistryFixture::lineOf(plain, 0) == "publish.no-package",
                RegistryFixture::lineOf(noFolder, 0) == "publish.usage",
                RegistryFixture::lineOf(badPython, 0) == "source.python-flavor-header",
                isEmpty(RegistryFixture::linesOf(plain)) == false && RegistryFixture::writesTo(badPython, "${folder}/@demo/one/1.1/osprey.toml") == 0
        ])
    }

    // Regression for [PACKAGE-CAPABILITY-CONFINEMENT]: raw native calls
    // bypass the named-builtin surface and must not enter a registry.
    fn rejectsRawExtern() = {
        let source = "extern fn puts(text: string) -> int\nfn hello() = puts(\"harmless FFI probe\")\n"
        let reads = [RegistryFixture::rootRead(manifestText()), Fixture::readRoute("${project}/src/main.osp", source)]
        let a = publish(reads)
        checkAll("unclassified native externs are refused before registry writes", [
                RegistryFixture::statusOf(a) == 1,
                RegistryFixture::writesTo(a, "${folder}/@demo/one/1.1/osprey.toml") == 0,
                RegistryFixture::writesTo(a, "${folder}/@demo/one/1.1/src/main.osp") == 0
        ])
    }

    fn legalFiles() = [
        Fixture::file("LICENSE", "MIT: NIMBLESITE PTY LTD, Australia\n"),
        Fixture::file("NOTICE.md", "Osprey port; upstream copyrights retained.\n"),
        Fixture::file("NOTICES", "Originally published by the upstream authors.\n"),
        Fixture::file("LICENSES/upstream.txt", "Upstream BSD conditions and disclaimer.\n")
    ]

    /// License texts and attribution survive the publisher's file selection.
    fn licenses() = {
        let source = listConcat(files(), legalFiles())
        let reads = RegistryFixture::readRoutesAt(project, source)
        let paths = listConcat(mapList(source, fn(f) => f.relPath), ["LICENSES-backup/private.txt", "docs/notes.md"])
        let a = RegistryFixture::runWith(reads, [Fixture::walkRoute(project, paths)], [], ["publish", "--folder", folder, "--project", project])
        checkAll("publishing retains MIT, upstream licenses and modification notices", [
                RegistryFixture::statusOf(a) == 0,
                foldList(legalFiles(), true, fn(ok, f) => ok && RegistryFixture::writtenTo(a, "${folder}/@demo/one/1.1/${f.relPath}") == f.content),
                RegistryFixture::lineOf(a, 0) == "published @demo/one e1.r1 ${Fixture::digestOf(Fixture::served("@demo/one/1.1", source))}",
                RegistryFixture::writesTo(a, "${folder}/@demo/one/1.1/LICENSES-backup/private.txt") == 0
        ])
    }

    /// Every publish test.
    export fn run() = {
        test("publish: the next ordinal", nextOrdinal)
        test("publish: epochs", epochs)
        test("publish: refusals", refusals)
        test("publish: rejects unclassified raw native externs", rejectsRawExtern)
        test("publish: licenses survive publication", licenses)
    }
}
