namespace registry_tests;
import registry_host::Host
import registry_cli::Dispatch
import registry::Capabilities

/// The frontend against fixture hosts: no process, file or terminal is touched.
module DispatchTests {
    fn healthyProcess() = handler Host::Process {
        run command => match command {
            "printf ok" => Host::Run { status: 0, stdout: "ok", stderr: "" }
            "command -v osprey" => Host::Run { status: 0, stdout: "/usr/local/bin/osprey\n", stderr: "" }
            _ => Host::Run { status: 127, stdout: "", stderr: "not found" }
        }
    }

    fn healthyFiles() = handler Host::Files {
        read _path => Success { value: "osprey doctor probe" }
        exists _path => Success { value: true }
        remove path => Error { message: "fixture: unexpected remove ${path}" }
        write _path content => Success { value: byteLength(content) }
    }

    fn brokenProcess() = handler Host::Process {
        run _command => Host::Run { status: 1, stdout: "", stderr: "denied" }
    }

    fn brokenFiles() = handler Host::Files {
        read _path => Error { message: "readFile: denied" }
        exists _path => Error { message: "exists: denied" }
        remove _path => Error { message: "remove: denied" }
        write _path _content => Error { message: "writeFile: denied" }
    }

    fn healthyTree() = handler Host::Tree {
        walk _root => Error { message: "fixture: no walk" }
        ensure _dir => Success { value: 0 }
    }

    fn healthyWeb() = handler Host::Web {
        get _base _path => Error { message: "http.transport: fixture offline" }
    }

    /// The frontend's report for `args` on a healthy host. `Dispatch::run` may
    /// perform host effects on any argument, so every call runs under fixture
    /// handlers even when the command touches none.
    fn reportOf(args) = RegistryFixture::runHosted(healthyProcess(), healthyFiles(), healthyTree(), healthyWeb(), fn() => Dispatch::run(args))

    /// Whether line 0 of `report` is one JSON document opening with `head` and closing with `tail`.
    fn jsonLine(report, head, tail) = startsWith(Fixture::line(report, 0), head) && endsWith(Fixture::line(report, 0), tail)

    fn helpAndUnknown() = {
        let help = reportOf([])
        let explicit = reportOf(["help"])
        let unknown = reportOf(["frobnicate"])
        let planned = reportOf(["audit"])
        let release = reportOf(["build", "--bogus"])
        checkAll("help is the default, unknown commands are usage errors, specified ones say not implemented", [
            structuralEquals([help.status, explicit.status, unknown.status], [0, 0, 2]),
            structuralEquals([planned.status, release.status], [3, 2]),
            Fixture::line(help, 0) == "usage: osprey-pkg [--json] <command>",
            length(explicit.lines) == length(help.lines),
            structuralEquals([Fixture::line(unknown, 0), Fixture::line(unknown, 1)],
                ["unknown command: frobnicate", "usage: osprey-pkg [--json] <command>"]),
            Fixture::line(planned, 0) == "not implemented: audit (plan 0020, Milestone A)",
            Fixture::line(release, 0) == "build.usage"
        ])
    }

    fn doctorHealthy() = {
        let report = reportOf(["doctor"])
        checkAll("doctor reports a healthy host and every blocked capability", [
            report.status == 0,
            structuralEquals(mapList([0, 1, 2, 3], fn(k) => Fixture::line(report, k)),
                ["process: ok", "files: ok", "compiler: /usr/local/bin/osprey", "uv: missing (python/uv: needed only by packages declaring python/interop)"]),
            length(report.lines) == 4 + length(Capabilities::blocked()),
            startsWith(Fixture::line(report, 4), "blocked: process.argv")
        ])
    }

    fn doctorBroken() = {
        let report = RegistryFixture::runHosted(brokenProcess(), brokenFiles(), healthyTree(), healthyWeb(), fn() => Dispatch::run(["doctor"]))
        checkAll("doctor names each failing probe", [
            Fixture::line(report, 0) == "process: failed (status 1)",
            Fixture::line(report, 1) == "files: write failed: writeFile: denied",
            Fixture::line(report, 2) == "compiler: missing (osprey is not on PATH)"
        ])
    }

    /// `--json` renders the same report as one canonical JSON line.
    fn jsonRendering() = {
        let plain = reportOf(["help"])
        let rendered = reportOf(["--json", "help"])
        let failing = reportOf(["--json", "frobnicate"])
        checkAll("--json is the report as one canonical JSON line with the same status", [
            rendered.status == plain.status,
            structuralEquals([length(rendered.lines), failing.status], [1, 2]),
            jsonLine(rendered, "{\"lines\":[\"usage: osprey-pkg [--json] <command>\",", "],\"status\":0}"),
            jsonLine(failing, "{\"lines\":[\"unknown command: frobnicate\",", "],\"status\":2}")
        ])
    }

    /// The frontend over fixture hosts: help and unknown commands, `--json`
    /// rendering, and `doctor` on a healthy and on a broken host.
    export fn run() = {
        test("dispatch: help and unknown commands", helpAndUnknown)
        test("dispatch: --json rendering", jsonRendering)
        test("dispatch: doctor on a healthy host", doctorHealthy)
        test("dispatch: doctor on a broken host", doctorBroken)
    }
}
