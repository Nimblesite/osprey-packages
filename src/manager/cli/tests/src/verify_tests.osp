namespace registry_tests;
import registry_cli::Lockfile
import registry_cli::Fetch
import registry_cli::Reports
import registry::ManifestJson

/// `verify --offline` against fixture hosts: the manifest and lock are read
/// through the files fixture, installed trees through the tree fixture, and
/// the network is never touched. Each stable code is asserted by name.
/// Implements [PACKAGE-FOLDER-REGISTRY] offline-audit tests.
module VerifyTests {
    type Attempt = { report: Reports::Report }

    /// `verify --offline` over `reads` and `walks`: a write, a fetch or a process run is a fixture failure.
    fn runVerify(reads, walks) = Attempt { report: RegistryFixture::runReadOnly(reads, walks, ["verify"], "verify") }

    /// The project's manifest.
    fn manifestText() = "[project]\nname = \"app\"\nsource_roots = [\"src\"]\ndefault_namespace = \"app\"\nentry = \"src/main.osp\"\n\n[dependencies]\n\"@finch/http\" = { epoch = 2, min_release = 17 }\n"

    fn digestOf(m) = ManifestJson::digest(m) ?: ""

    /// The current manifest the project reads.
    fn manifest() = Fixture::manifestOf(manifestText())

    fn pkgFiles() = InstallTests::releaseFiles("key = http\n", "fn get() = 1\n")

    fn pkg() = Fixture::served("@finch/http/2.17", pkgFiles())

    fn pkgOf() = Lockfile::Package { release: pkg().id, dependencies: [], surface: [] }

    /// The same release with a surface the pure tree does not have: a tampered lock.
    fn pkgPinning(surface) = Lockfile::Package { release: pkg().id, dependencies: [], surface: surface }

    fn rootOf(manifestDigest, dependencies) = Lockfile::Root { manifestDigest: manifestDigest, dependencies: dependencies }

    fn lockOf(root) = Lockfile::release(root, [pkgOf()])

    fn lockPinning(root, surface) = Lockfile::release(root, [pkgPinning(surface)])

    fn lockText(lock) = Lockfile::encode(lock) ?: ""

    fn installDir() = Fetch::installDir(pkg().id)

    fn readsForPkg() = RegistryFixture::readRoutesAt(installDir(), pkg().files)

    fn walkForPkg() = InstallTests::installedWalk(installDir(), pkg())

    fn lockRead(text) = Fixture::readRoute("osprey.lock", text)
    fn manifestRead() = Fixture::readRoute("osprey.toml", manifestText())

    fn baseReads(lockText) = [manifestRead(), lockRead(lockText)]

    /// The lock root of the current manifest: its digest and its edges.
    fn currentRoot() = rootOf(digestOf(manifest()), manifest().dependencies)

    /// The lock the current manifest, its edges and the fixture tree resolve to.
    fn currentLock() = lockOf(currentRoot())

    /// The reads of `lock` over the installed fixture tree.
    fn installedReads(lock) = listConcat(baseReads(lockText(lock)), readsForPkg())

    /// `verify --offline` over `lock` on the installed fixture tree.
    fn verifyLock(lock) = runVerify(installedReads(lock), [walkForPkg()])

    /// The run's status and its single report line: the shape of every verdict.
    fn reports(a, label, status, line) = checkAll(label, [a.report.status == status && length(a.report.lines) == 1 && Fixture::line(a.report, 0) == line])

    /// A matching manifest, lock and installed tree: the success line.
    fn success() = reports(verifyLock(currentLock()), "a matching lock verifies", 0, "verified 1 packages")

    /// The lock pins a different manifest than the current one.
    fn manifestDigest() = reports(verifyLock(lockOf(rootOf(RegistryFixture::otherDigest, manifest().dependencies))), "a stale manifest digest is verify.manifest-digest", 1, "verify.manifest-digest")

    /// The lock's root edges disagree with the manifest it pins.
    fn dependencies() = reports(verifyLock(lockOf(rootOf(digestOf(manifest()), []))), "disagreeing edges are verify.dependencies", 1, "verify.dependencies")

    /// A locked package with no installed tree.
    fn missing() = reports(runVerify(baseReads(lockText(currentLock())), []), "a package without a tree is verify.missing", 1, "verify.missing @finch/http")

    /// An installed tree whose digest differs from its release.
    fn digestMismatch() = reports(runVerify(listConcat(baseReads(lockText(currentLock())), InstallTests::tamperedReads(installDir(), pkg())), [walkForPkg()]), "a tampered tree is verify.digest", 1, "verify.digest @finch/http")

    /// A lock pinning a surface the installed tree does not have is
    /// `capability.surface` ([PACKAGE-CAPABILITY-CONFINEMENT]).
    fn surfaceMismatch() = reports(verifyLock(lockPinning(currentRoot(), ["io/files"])), "a pinned surface the tree lacks is capability.surface", 1, "capability.surface @finch/http")

    /// Every verify test.
    export fn run() = {
        test("verify: a pinned surface the tree lacks", surfaceMismatch)
        test("verify: a matching lock verifies", success)
        test("verify: manifest digest mismatch", manifestDigest)
        test("verify: dependency edges differ", dependencies)
        test("verify: missing installed tree", missing)
        test("verify: installed tree digest mismatch", digestMismatch)
    }
}
