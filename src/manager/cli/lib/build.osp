namespace registry_cli;
import registry::Checked
import registry_host::Host
import registry::Manifest
import registry::ManifestModel
import registry::Maybe
import registry::Names

/// `osprey-pkg build [--run] [--release] [--compiler <path>] [--project <dir>]`:
/// run the offline verify first (its failure is the build's failure), then
/// compile through the existing compiler with a derived project whose source
/// roots are the root's own roots plus every locked package's own
/// `source_roots`, in lock order, and whose `python_sources` and
/// `typescript_sources` are the root's plus every package's. A bare `build` selects the development lock while the
/// overlay is active and compiles overridden keys from their local checkouts;
/// `build --release` refuses any override and selects `osprey.lock`
/// ([PACKAGE-LOCAL-OVERRIDE]). Only a dependency's `source_roots`,
/// `python_sources` and `typescript_sources` enter the derived project; its `entry`, `[modules]` and
/// `[system]` never do ([PACKAGE-HARDENING] C6). Implements the build half of
/// [PACKAGE-FOLDER-REGISTRY].
module Build {
    let usageCode = "build.usage"
    let manifestCode = "build.manifest"
    let overridesCode = "build.overrides-active"
    let noLocalLockCode = "build.no-local-lock"
    let defaultCompiler = "osprey"
    let runFlag = "--run"
    let releaseFlag = "--release"
    let compilerFlag = "--compiler"
    let buildDir = ".osprey/build"
    let buildManifest = ".osprey/build/osprey.toml"

    type CommandLine = { run: bool, release: bool, compiler: string, project: string, docsDir: string }
    /// One locked package's tree and its accepted manifest.
    type PackageManifest = { dir: string, manifest: ManifestModel::Manifest }

    let usageText = ["usage: osprey-pkg build [--run] [--release] [--compiler <path>] [--project <dir>]"]

    fn commandLine(parsed) = CommandLine {
        docsDir: Flags::given(parsed, "--docs-dir", ""),
        run: Flags::has(parsed, runFlag),
        release: Flags::has(parsed, releaseFlag),
        compiler: Flags::given(parsed, compilerFlag, defaultCompiler),
        project: Flags::project(parsed)
    }

    fn escaped(text) = replace(text, "\\", "\\\\") ?: text

    /// A TOML basic string: backslashes and quotes escaped, so no manifest
    /// value can break out of the derived document ([PACKAGE-HARDENING] C6).
    fn quote(text) = "\"" + (replace(escaped(text), "\"", "\\\"") ?: escaped(text)) + "\""

    /// The derived manifest lives two directories below the selected project.
    /// Python source paths must remain manifest-relative, even for an absolute project.
    fn rootPath(root) = "../../${root}"

    // Shared field names need typed receivers (issue #273).
    fn dirOf(pm: PackageManifest) = pm.dir
    fn manifestOf(pm: PackageManifest) = pm.manifest
    fn keyText(p) = Names::display(Lockfile::keyOf(p))

    /// `build.manifest @scope/name <code at line:column>`: the one failure
    /// spelling of a package tree whose manifest cannot be used.
    fn manifestFailure(p, message) = Error { message: "${manifestCode} ${keyText(p)} ${message}" }

    /// A package's manifest, or `manifestFailure` for its rejection.
    fn packageManifestAt(dir, p, text) = match Manifest::accepted(Manifest::parse(text)) {
        Error { message } => manifestFailure(p, message)
        Success { value } => Success { value: PackageManifest { dir: dir, manifest: value } }
    }

    fn packageManifestIn(project, lock, p) = {
        let dir = Project::treeDirAt(project, lock, p)
        match perform Host::Files.read("${dir}/osprey.toml") {
            Error { message } => manifestFailure(p, message)
            Success { value } => packageManifestAt(Project::treeDirAt(".", lock, p), p, value)
        }
    }

    /// Every locked package's manifest in lock order; the first rejection stops the build.
    fn packageManifests(project, lock) = Checked::collectAll(Lockfile::packagesOf(lock), fn(p) => packageManifestIn(project, lock, p))

    /// Each package's own `listed` entries, in lock order, each entry of a
    /// package tree rebased like the roots.
    fn packageSources(pms, listed) = Folds::flatMap(pms, fn(pm) => mapList(listed(manifestOf(pm)), fn(p) => rootPath("${dirOf(pm)}/${p}")))

    /// A list the derived manifest takes from the root and every package:
    /// the root's own entries, then each package's.
    fn flavorSources(manifest, pms, listed) = listConcat(mapList(listed(manifest), rootPath), packageSources(pms, listed))

    /// The source roots of the root and of every locked package, in lock order.
    fn derivedRoots(manifest, pms) = flavorSources(manifest, pms, sourceRootsOf)

    fn sourceRootsOf(m: ManifestModel::Manifest) = m.sourceRoots
    fn pythonOf(m: ManifestModel::Manifest) = m.pythonSources
    fn typescriptOf(m: ManifestModel::Manifest) = m.typescriptSources

    fn sourcesLine(key, sources) = "${key} = [${join(mapList(sources, quote), ", ")}]"

    fn rootsLine(roots) = sourcesLine("source_roots", roots)

    /// The `key = "<value>"` line of an optional `[project]` member, none
    /// when the member is absent.
    fn optionLine(member, key, render) = Maybe::fold(member, [], fn(value) => ["${key} = ${quote(render(value))}"])

    fn flavorText(flavor) = toLowerCase(ManifestModel::flavorName(flavor))

    /// The optional `[project]` members the root may carry, in this order:
    /// namespace, entry and flavor.
    fn optionLines(manifest) = listConcat(
        optionLine(manifest.defaultNamespace, "default_namespace", fn(ns) => ns),
        listConcat(optionLine(manifest.entry, "entry", rootPath), optionLine(manifest.flavor, "flavor", flavorText)))

    fn boolText(flag) = if flag { "true" } else { "false" }

    fn projectLines(manifest, pms) = {
        let header = ["[project]", "name = ${quote(manifest.projectName)}", rootsLine(derivedRoots(manifest, pms)), sourcesLine("python_sources", flavorSources(manifest, pms, pythonOf)), sourcesLine("typescript_sources", flavorSources(manifest, pms, typescriptOf))]
        let modules = ["[modules]", "allow_wildcard_imports = ${boolText(manifest.allowWildcardImports)}"]
        listConcat(listConcat(header, optionLines(manifest)), modules)
    }

    fn derivedText(manifest, pms) = join(projectLines(manifest, pms), "\n")

    fn writeDerived(cmd: CommandLine, manifest, pms) = andThen(perform Host::Tree.ensure(Project::pathAt(cmd.project, buildDir)),
        fn(_dir) => andThen(perform Host::Files.write(Project::pathAt(cmd.project, buildManifest), derivedText(manifest, pms)), fn(_written) => Success { value: 0 }))

    /// The compiler and the derived project, each one shell-quoted word ([PACKAGE-HARDENING] C6).
    fn compilerWord(cmd: CommandLine) = Host::shellWord(cmd.compiler)
    fn derivedWord(cmd: CommandLine) = Host::shellWord(Project::pathAt(cmd.project, buildDir))

    /// The compiler invocation, every variable word shell-quoted ([PACKAGE-HARDENING] C6).
    fn command(cmd, manifest) = if cmd.docsDir != "" {
        "${compilerWord(cmd)} --docs ${derivedWord(cmd)} --docs-format html --docs-no-builtins --docs-dir ${Host::shellWord(cmd.docsDir)}"
    } else if cmd.run {
        "${compilerWord(cmd)} ${derivedWord(cmd)} --run"
    } else {
        "${compilerWord(cmd)} build ${derivedWord(cmd)} -o ${Host::shellWord(Project::pathAt(cmd.project, buildDir + "/" + manifest.projectName))}"
    }

    fn stdoutLines(stdout) = filterList(split(stdout, "\n") ?: [], fn(l) => l != "")

    fn runCompiler(cmd, manifest) = {
        let run = perform Host::Process.run(command(cmd, manifest))
        Reports::Report { status: run.status, lines: stdoutLines(run.stdout) }
    }

    fn compileWithPackages(cmd, manifest, pms) = Reports::checked(writeDerived(cmd, manifest, pms), fn(_finished) => runCompiler(cmd, manifest))

    fn compileWithManifest(cmd, lock, manifest) = Reports::checked(packageManifests(cmd.project, lock), fn(value) => compileWithPackages(cmd, manifest, value))

    /// Compile against `lock`, every package's tree where the lock says it is.
    fn compile(cmd, lock) = Project::withManifestAt(cmd.project, fn(value) => compileWithManifest(cmd, lock, value))

    fn afterVerify(verified: Reports::Report, cmd, read) = if verified.status != 0 { verified } else { Reports::checked(read, fn(value) => compile(cmd, value)) }

    /// The release lock, verified, then compiled.
    fn releaseVerified(cmd) = afterVerify(Verify::verifyReleaseAt(cmd.project), cmd, Project::readLockAt(cmd.project))

    /// The release build: `osprey.lock`, verified, after the empty-overlay preflight.
    fn releaseBuild(cmd, mappings) = if Overlay::active(mappings) {
        Reports::failure(["${overridesCode} ${join(mapList(mappings, fn(m) => Names::display(Overlay::keyOf(m))), " ")}", "run `use --clear` or build without --release"])
    } else { releaseVerified(cmd) }

    /// The development build: `osprey.local.lock`, verified, locals from their checkouts.
    fn localBuild(cmd) = Verify::withLocalLockAt(cmd.project, noLocalLockCode, fn(value) =>
        afterVerify(Verify::verifyLocalAt(cmd.project), cmd, Success { value: value }))

    fn withOverlay(cmd, mappings) = if cmd.release { releaseBuild(cmd, mappings) }
    else if Overlay::active(mappings) { localBuild(cmd) }
    else { releaseVerified(cmd) }

    fn build(cmd) = Reports::checked(Overlay::readAt(cmd.project), fn(value) => withOverlay(cmd, value))

    export fn docs(args) = Flags::dispatch(args, [compilerFlag, Flags::projectFlag, "--docs-dir"], [], "docs.usage", ["usage: osprey-pkg docs --docs-dir <directory> [--compiler <path>] [--project <dir>]"],
        fn(parsed) => if Flags::given(parsed, "--docs-dir", "") == "" { Reports::usage(["missing --docs-dir"]) } else { build(commandLine(parsed)) })

    /// The whole command: verify, then compile; `--run` runs the built program.
    export fn run(args) = Flags::dispatchWith(args, [compilerFlag, Flags::projectFlag], [runFlag, releaseFlag], usageCode, usageText, commandLine, build)
}
