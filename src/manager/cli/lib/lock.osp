namespace registry_cli;
import registry::Checked
import registry_host::Host
import registry::Candidates
import registry::Digests
import registry::Identity
import registry::Manifest
import registry::ManifestJson
import registry::ManifestModel
import registry::Maybe
import registry::Names
import registry::Release
import registry::Resolve
import registry::Resolution
import registry::Surface

/// `osprey-pkg lock [--local] [--registry <base-url>] [--project <dir>] [--accept-removals]`:
/// the only command that chooses releases ([PACKAGE-HARDENING] C5). One
/// GET /v1/packages lists every release of the folder registry; each is
/// fetched and verified through `Fetch::fetched`, its manifest parsed and its
/// capability surface recomputed, the one resolver of [PACKAGE-RESOLUTION]
/// run, and `<dir>/osprey.lock` written ([PACKAGE-FOLDER-REGISTRY]). With
/// `--local` the overlay `osprey.local.toml` replaces each overridden key's
/// published candidates with its local checkout and `osprey.local.lock` is
/// written instead ([PACKAGE-LOCAL-OVERRIDE]); the release lock never sees an
/// override. It fails closed, writing nothing, on `lock.release-replaced`, on
/// `lock.release-vanished` without `--accept-removals`, and on a current lock
/// that does not decode.
module Lock {
    let usageCode = "lock.usage"
    let replacedCode = "lock.release-replaced"
    let vanishedCode = "lock.release-vanished"
    let invalidCode = "lock.invalid-manifest"
    let localManifestCode = "lock.local-manifest"
    let localKeyCode = "lock.local-key"
    let lockCodePrefix = "lock."
    let removalsFlag = "--accept-removals"
    let localFlag = "--local"
    let usageText = ["usage: osprey-pkg lock [--local] [--registry <base-url>] [--project <dir>] [--accept-removals]"]

    /// One listed release after its verified fetch: its identity, its verified
    /// files and its activation state (`Yanked` when the listing marks it, else `Eligible`).
    type Fetched = { fetchedRelease: Identity::ReleaseId, bundle: Release::Served, activation: string }
    /// The resolver's catalog plus the warning lines gathered on the way.
    type Catalog = { candidates: List<Resolution::Entry>, warnings: List<string> }
    /// The current lock: its releases and its packages, both empty without a lock.
    type Previous = { current: List<Identity::ReleaseId>, locked: List<Lockfile::Package> }
    /// One overridden key as the resolver and the lock see it.
    type LocalTree = { candidate: Resolution::Entry, override: Lockfile::Override, tree: List<Release::File> }
    /// What local mode adds: the overlay's mappings and their checkouts.
    type Locals = { mappings: List<Overlay::Mapping>, trees: List<LocalTree> }

    /// The command line as relock settings: `--local` targets the development
    /// lock, and `fresh` is never set here (`update` goes through `relock`).
    fn commandLine(parsed) = Transaction::settingsOf(parsed, Flags::has(parsed, removalsFlag), false, Flags::has(parsed, localFlag))

    // Shared field names (`key`, `digest`, `release`, `packages`, `dependencies`,
    // `path`, `epoch`) need typed receivers (issue #273).
    fn freshOf(cmd: Transaction::Settings) = cmd.fresh
    fn systemCapabilities(m: ManifestModel::Manifest) = mapList(m.systemRequirements, fn(s) => s.capability)
    fn candidateOf(t: LocalTree) = t.candidate
    fn overrideOf(t: LocalTree) = t.override
    fn treeFiles(t: LocalTree) = t.tree
    fn bundleOf(f: Fetched) = f.bundle
    fn fetchedRelease(f: Fetched) = f.fetchedRelease
    fn mappingsOf(l: Locals) = l.mappings
    fn treesOf(l: Locals) = l.trees

    /// Same key, epoch and ordinal: the slot a release occupies, digest aside.
    fn sameSpot(a: Identity::ReleaseId, b: Identity::ReleaseId) = Names::same(a.key, b.key) && a.epoch == b.epoch && a.ordinal == b.ordinal

    // ---- the current lock ----

    fn previousOf(lock) = Previous { current: mapList(Lockfile::packagesOf(lock), Lockfile::releaseOf), locked: Lockfile::packagesOf(lock) }

    /// Local mode starts from the development lock when one decodes and from
    /// the release lock otherwise; a damaged development lock is still refused.
    fn devOrRelease(project) = match Project::readLocalLockAt(project) {
        Success { value } => Success { value: value }
        Error { message } => if startsWith(message, lockCodePrefix) { Error { message: message } } else { Project::readLockAt(project) }
    }

    fn currentLockAt(cmd: Transaction::Settings) = if cmd.local { devOrRelease(cmd.project) } else { Project::readLockAt(cmd.project) }

    /// The current lock; a missing file is an empty one, but a file that does
    /// not decode is its `lock.*` refusal, so a damaged lock is never replaced
    /// silently ([PACKAGE-HARDENING] C3).
    fn previousAt(cmd) = match currentLockAt(cmd) {
        Error { message } => if startsWith(message, lockCodePrefix) { Error { message: message } } else { Success { value: Previous { current: [], locked: [] } } }
        Success { value } => Success { value: previousOf(value) }
    }

    // ---- hardening checks ([PACKAGE-HARDENING] C5), published keys only ----

    fn published(current, locals) = filterList(current, fn(c) => !Overlay::overridden(mappingsOf(locals), Identity::keyOf(c)))

    fn replacedBy(current, listed) = foldList(current, "", fn(line, c) =>
        if line != "" || !sameSpot(c, listed) || Identity::digestOf(c) == Identity::digestOf(listed) { line }
        else { "${replacedCode} ${Lockfile::spot(listed)} ${Identity::digestOf(c)} ${Identity::digestOf(listed)}" })

    /// The refusal for the first listed release that re-serves a locked slot
    /// under another digest, else "".
    fn replacedLine(current, listing) = foldList(listing, "", fn(line, l) => if line != "" { line } else { replacedBy(current, l) })

    fn inListing(listing, c) = Folds::any(listing, fn(l) => sameSpot(l, c))

    /// The locked published releases the listing no longer carries.
    fn vanished(current, listing) = filterList(current, fn(c) => !inListing(listing, c))

    fn vanishedLine(c) = "${vanishedCode} ${Lockfile::compact(c)}"

    /// The refusal names the flag that would accept the removal (the Package Management spec "Folder lock").
    fn vanishedRefusal(c) = "${vanishedLine(c)} (rerun with ${removalsFlag} to drop it from the lock)"

    // ---- fetching the listing ----

    /// One listed release fetched, verified and installed under `project`, its files kept.
    fn activationOf(marked, release) = if Listing::isYanked(marked, release) { "Yanked" } else { "Eligible" }

    fn fetchedOne(base, project, marked, release) = Folds::mapped(Fetch::fetched(project, base, Identity::digestOf(release)), fn(value) => Fetched { fetchedRelease: release, bundle: value, activation: activationOf(marked, release) })

    /// Every listed release fetched in listing order, yanked ones included so a
    /// locked yank stays reproducible; the first failure stops the run.
    fn fetchAll(base, project, marked) = Checked::collectAll(Listing::releasesOf(marked), fn(release) => fetchedOne(base, project, marked, release))

    // ---- the catalog ----

    /// A folder registry carries no target data, so every candidate is for the
    /// empty target, Eligible or Yanked as listed (the resolver chooses a yank
    /// only when the current lock holds it); its capabilities are the surface
    /// recomputed from its verified files ([PACKAGE-CAPABILITY-CONFINEMENT]).
    fn entryOf(release, activation, manifest, fileList) = Resolution::Entry {
        release: release,
        activation: activation,
        targets: [""],
        capabilities: Surface::ofRelease(fileList, systemCapabilities(manifest)),
        dependencies: ManifestModel::edgesOf(manifest)
    }

    fn withWarning(acc: Catalog, line) = Catalog { candidates: acc.candidates, warnings: listAppend(acc.warnings, line) }
    fn withCandidate(acc: Catalog, entry) = Catalog { candidates: listAppend(acc.candidates, entry), warnings: acc.warnings }

    /// An accepted manifest is a candidate; a rejected one is excluded with a warning.
    fn classified(acc, f: Fetched) = match Manifest::accepted(Manifest::parse(Install::manifestTextIn(Release::filesOf(f.bundle)))) {
        Error { message } => withWarning(acc, "${invalidCode} ${Lockfile::compact(f.fetchedRelease)} ${message}")
        Success { value } => withCandidate(acc, entryOf(f.fetchedRelease, f.activation, value, Release::filesOf(f.bundle)))
    }

    fn catalogOf(fetched, warnings) = foldList(fetched, Catalog { candidates: [], warnings: warnings }, classified)

    /// The published candidates of an overridden key give way to its local checkout.
    fn withLocals(catalog: Catalog, locals) = Catalog {
        candidates: listConcat(filterList(catalog.candidates, fn(e) => !Overlay::overridden(mappingsOf(locals), Identity::keyOf(Candidates::releaseOf(e)))), mapList(treesOf(locals), candidateOf)),
        warnings: catalog.warnings
    }

    // ---- local checkouts ([PACKAGE-LOCAL-OVERRIDE]) ----

    fn localDir(project, m) = Project::localDirAt(project, Overlay::pathOf(m))

    /// `lock.local-manifest @scope/name <code>`: one spelling for a local
    /// checkout the release lock cannot take.
    fn localFailure(m, message) = Error { message: "${localManifestCode} ${Names::display(Overlay::keyOf(m))} ${message}" }

    fn localFiles(project, m) = match perform Host::Tree.walk(localDir(project, m)) {
        Error { message } => localFailure(m, message)
        Success { value } => Install::filesOfWalked(value, localDir(project, m))
    }

    fn publishedKey(mf: ManifestModel::Manifest) = Maybe::fold(mf.publication, Names::blank(), fn(p) => p.package)

    /// The local manifest must be accepted and name the overridden key as its package.
    fn localManifest(m, fileList) = match Manifest::accepted(Manifest::parse(Install::manifestTextIn(fileList))) {
        Error { message } => localFailure(m, message)
        Success { value } => if Names::same(publishedKey(value), Overlay::keyOf(m)) { Success { value: value } } else { Error { message: "${localKeyCode} ${Names::display(Overlay::keyOf(m))}" } }
    }

    /// A local has its baseline's ordinal, or zero when nothing is published.
    fn baselineOrdinal(m) = Maybe::fold(Overlay::baselineOf(m), 0, fn(id) => id.ordinal)

    fn localRelease(m, digest) = Identity::ReleaseId { key: Overlay::keyOf(m), epoch: Overlay::epochOf(m), ordinal: baselineOrdinal(m), digest: digest }

    fn treeOf(m, fileList, mf, digest, manifestDigest) = LocalTree {
        tree: fileList,
        candidate: entryOf(localRelease(m, digest), "Eligible", mf, fileList),
        override: Lockfile::Override { package: Overlay::keyOf(m), path: Overlay::pathOf(m), epoch: Overlay::epochOf(m), manifestDigest: manifestDigest }
    }

    fn withDigest(m, fileList, mf, digest) = Folds::mapped(ManifestJson::digest(mf), fn(value) => treeOf(m, fileList, mf, digest, value))

    fn withManifestOfLocal(m, fileList, mf) = andThen(Install::digestOfFiles(fileList), fn(value) => withDigest(m, fileList, mf, value))

    fn withLocalFiles(m, fileList) = andThen(localManifest(m, fileList), fn(value) => withManifestOfLocal(m, fileList, value))

    fn localTreeOf(project, m) = andThen(localFiles(project, m), fn(value) => withLocalFiles(m, value))

    /// Every mapping's checkout in overlay order; the first failure stops the walk.
    fn localTrees(project, mappings) = Checked::collectAll(mappings, fn(m) => localTreeOf(project, m))

    fn withMappings(project, mappings) = Folds::mapped(localTrees(project, mappings), fn(value) => Locals { mappings: mappings, trees: value })

    /// The overlay and its checkouts in local mode; nothing otherwise.
    fn localsAt(cmd: Transaction::Settings) = if !cmd.local { Success { value: Locals { mappings: [], trees: [] } } } else { andThen(Overlay::readAt(cmd.project), fn(value) => withMappings(cmd.project, value)) }

    // ---- the lock and its delta ----

    fn entryFor(candidates, release) = Checked::firstMatch(candidates, fn(e) => Identity::same(Candidates::releaseOf(e), release), "none")

    /// The lock package of a selected release: its Runtime/Build edges and its
    /// surface; every selected release is a candidate, so the fallback never prints.
    fn packageOf(candidates, release) = match entryFor(candidates, release) {
        Success { value } => Lockfile::Package { release: release, dependencies: ManifestModel::activeEdges(Candidates::edgesOf(value)), surface: Candidates::capabilitiesOf(value) }
        Error => Lockfile::Package { release: release, dependencies: [], surface: [] }
    }

    /// ` (local <path>)` after an overridden key.
    fn localSuffix(locals, key) = match Folds::byKey(mappingsOf(locals), Overlay::keyOf, key) {
        Success { value } => " (local ${Overlay::pathOf(value)})"
        Error => ""
    }

    fn marked(mark, p, locals) = "${mark} ${Lockfile::compact(Lockfile::releaseOf(p))}${localSuffix(locals, Lockfile::keyOf(p))}"

    /// `+` added, `=` unchanged, `~` another release of a locked key.
    fn deltaOf(previous, p, locals) = match Lockfile::packageFor(previous, Lockfile::keyOf(p)) {
        Error => marked("+", p, locals)
        Success { value } => if Identity::same(Lockfile::releaseOf(value), Lockfile::releaseOf(p)) { marked("=", p, locals) } else { marked("~", p, locals) }
    }

    fn stillLocked(next, p) = Checked::succeeded(Lockfile::packageFor(next, Lockfile::keyOf(p)))

    fn removedLines(previous, next, locals) = mapList(filterList(previous, fn(p) => !stillLocked(next, p)), fn(p) => marked("-", p, locals))

    fn deltaLines(next, previous, locals) = listConcat(mapList(next, fn(p) => deltaOf(previous, p, locals)), removedLines(previous, next, locals))

    fn writeLock(cmd, lock) = andThen(Lockfile::encode(lock), fn(value) => perform Host::Files.write(Transaction::lockPath(cmd), value))

    /// The root's per-dependency grants are the only grants; nothing is granted to every key.
    fn graphOf(manifest, prev: Previous, catalog: Catalog, fresh) = Resolution::Graph { target: "", granted: [], grants: ManifestModel::grantsOf(manifest), rootDeps: ManifestModel::edgesOf(manifest), current: if fresh { [] } else { prev.current }, catalog: catalog.candidates }

    fn lockOf(manifest, digest, packages, locals, python) = Lockfile::Lock { root: Lockfile::Root { manifestDigest: digest, dependencies: ManifestModel::edgesOf(manifest) }, packages: packages, overrides: mapList(treesOf(locals), overrideOf), python: python }

    // ---- the Python plane ([PACKAGE-PYTHON-UV]) ----

    /// The files of a selected release: its checkout when overridden, else its verified bundle.
    fn filesFor(release, locals, fetched) = if Overlay::overridden(mappingsOf(locals), Identity::keyOf(release)) {
        foldList(treesOf(locals), [], fn(found, t) => if Identity::same(Candidates::releaseOf(candidateOf(t)), release) { treeFiles(t) } else { found })
    } else {
        foldList(fetched, [], fn(found, f) => if Identity::same(fetchedRelease(f), release) { Release::filesOf(bundleOf(f)) } else { found })
    }

    /// Where a selected release's tree sits, relative to `.osprey/python`.
    fn pythonPathFor(release, locals) = match Folds::byKey(mappingsOf(locals), Overlay::keyOf, Identity::keyOf(release)) {
        Success { value } => "../../${Overlay::pathOf(value)}"
        Error => "../packages/${Names::display(Identity::keyOf(release))}/${Digests::hexOf(Identity::digestOf(release))}"
    }

    fn memberFor(release, locals, fetched) = {
        let fileList = filesFor(release, locals, fetched)
        andThen(Manifest::accepted(Manifest::parse(Install::manifestTextIn(fileList))), fn(value) => PythonPlane::memberOf(value, pythonPathFor(release, locals), Install::fileNamed(fileList, "pyproject.toml")))
    }

    fn rootMember(cmd: Transaction::Settings, manifest) = PythonPlane::memberOf(manifest, "../..", perform Host::Files.read(Project::pathAt(cmd.project, "pyproject.toml")) ?: "")

    /// Every member of the uv project: the root when it declares the plane, then each selected release that does.
    fn members(cmd, manifest, releases, locals, fetched) = PythonPlane::membersOver(releases, rootMember(cmd, manifest), fn(r) => memberFor(r, locals, fetched))

    /// The plane's pins when any member declares it, none otherwise.
    fn pythonPins(cmd: Transaction::Settings, memberList) = if isEmpty(memberList) { Success { value: Maybe::none() } } else { andThen(PythonPlane::locked(cmd.project, memberList), fn(value) => Success { value: Maybe::some(value) }) }

    fn pythonLines(cmd: Transaction::Settings, python) = Maybe::fold(python, [], fn(_p) => [PythonPlane::lockedLine(cmd.project)])

    /// Everything a solved graph still needs to write the lock: the command,
    /// the root manifest, the previous lock, the catalog and the locals.
    type Plan = { cmd: Transaction::Settings, manifest: ManifestModel::Manifest, prev: Previous, catalog: Catalog, locals: Locals }

    // `Plan.manifest` is a shared field name; issue #273 needs the receiver spelled out.
    fn manifestOf(plan: Plan) = plan.manifest

    fn writtenWith(plan, digest, packages, python) =
    Reports::checked(writeLock(plan.cmd, lockOf(manifestOf(plan), digest, packages, plan.locals, python)),
        fn(_written) => Reports::success(listConcat(listConcat(plan.catalog.warnings, deltaLines(packages, plan.prev.locked, plan.locals)), pythonLines(plan.cmd, python))))

    fn withMembers(plan, digest, packages, memberList) = Reports::checked(pythonPins(plan.cmd, memberList), fn(value) => writtenWith(plan, digest, packages, value))

    fn written(plan, digest, releases, fetched) = {
        let packages = mapList(releases, fn(r) => packageOf(plan.catalog.candidates, r))
        Reports::checked(members(plan.cmd, manifestOf(plan), releases, plan.locals, fetched), fn(value) => withMembers(plan, digest, packages, value))
    }

    fn locked(plan, releases, fetched) = Reports::checked(ManifestJson::digest(manifestOf(plan)), fn(value) => written(plan, value, releases, fetched))

    fn explained(catalog: Catalog, code, packages) = Reports::failure(listConcat(catalog.warnings, listPrepend(mapList(packages, Names::display), code)))

    // ---- the command ----

    fn solved(cmd, manifest, prev, catalog, locals, fetched) = {
        let plan = Plan { cmd: cmd, manifest: manifest, prev: prev, catalog: catalog, locals: locals }
        match Resolve::solve(graphOf(manifest, prev, catalog, freshOf(cmd))) {
            Resolution::Lock { releases } => locked(plan, releases, fetched)
            Resolution::Explain { code, packages } => explained(catalog, code, packages)
        }
    }

    fn resolved(cmd, manifest, prev, locals, listing, warnings) = Reports::checked(fetchAll(cmd.base, cmd.project, listing), fn(value) => solved(cmd, manifest, prev, withLocals(catalogOf(value, warnings), locals), locals, value))

    fn withRemovals(cmd, manifest, prev, locals, listing) = {
        let gone = vanished(published(prev.current, locals), Listing::releasesOf(listing))
        if isEmpty(gone) { resolved(cmd, manifest, prev, locals, listing, []) }
        else if cmd.acceptRemovals { resolved(cmd, manifest, prev, locals, listing, mapList(gone, vanishedLine)) }
        else { Reports::failure(mapList(gone, vanishedRefusal)) }
    }

    fn checked(cmd, manifest, prev, locals, listing) = {
        let replaced = replacedLine(published(prev.current, locals), Listing::releasesOf(listing))
        if replaced == "" { withRemovals(cmd, manifest, prev, locals, listing) } else { Reports::failure([replaced]) }
    }

    fn withLocalsOf(cmd, manifest, prev, locals) = Reports::checked(Listing::fetchMarked(cmd.base), fn(value) => checked(cmd, manifest, prev, locals, value))

    fn withPrevious(cmd, manifest, prev) = Reports::checked(localsAt(cmd), fn(value) => withLocalsOf(cmd, manifest, prev, value))

    fn withManifest(cmd, manifest) = Reports::checked(previousAt(cmd), fn(value) => withPrevious(cmd, manifest, value))

    fn withCommand(cmd) = Project::withManifestAt(cmd.project, fn(value) => withManifest(cmd, value))

    /// The whole command. Implements [PACKAGE-FOLDER-REGISTRY], [PACKAGE-HARDENING] C5 and [PACKAGE-LOCAL-OVERRIDE].
    export fn run(args) = Flags::dispatchWith(args, Transaction::flags, [removalsFlag, localFlag], usageCode, usageText, commandLine, withCommand)

    /// The command as `add`, `remove`, `update` and `use` run it after a file
    /// change: `fresh` makes the current lock's choices non-sticky, `local`
    /// targets the development lock.
    export fn relock(base, project, fresh, acceptRemovals, local) = withCommand(Transaction::Settings { base: base, project: project, acceptRemovals: acceptRemovals, fresh: fresh, local: local })
}
