namespace registry_cli;
import registry::Identity
import registry::Names
import registry::Maybe

/// The folder registry's one listing, `GET /v1/packages`, as release
/// identities, and the choices `add` and `update` make over it: the newest
/// epoch of a key and the newest ordinal inside an epoch
/// ([PACKAGE-FOLDER-REGISTRY], [PACKAGE-API]).
module Listing {
    let unknownCode = "listing.unknown-package"
    let epochCode = "listing.unknown-epoch"

    /// Every release the registry lists, in listing order.
    export fn fetch(base) = andThen(Fetch::getBody(base, Fetch::packagesListingPath), fn(value) => Fetch::parsePackages(value))

    fn ofKey(listing, key) = filterList(listing, fn(r) => Names::same(Identity::keyOf(r), key))

    /// The largest `measure` over `releases`, or `missing` when there are none.
    fn newest(releases, measure, missing) = if isEmpty(releases) { Error { message: missing } } else { Success { value: Folds::largest(releases, measure) } }

    /// The newest epoch of `key`, or `listing.unknown-package`.
    export fn newestEpoch(listing, key) = newest(ofKey(listing, key), Identity::epochOf, "${unknownCode} ${Names::display(key)}")

    /// The newest ordinal of `key` in `epoch`, or `listing.unknown-epoch`.
    export fn newestOrdinal(listing, key, epoch) = newest(filterList(ofKey(listing, key), fn(r) => Identity::epochOf(r) == epoch), Identity::ordinalOf, "${epochCode} ${Names::display(key)} e${epoch}")

    /// The release at one exact slot, or the blank identity.
    export fn releaseIn(listing, key, epoch, ordinal) = foldList(listing, Identity::blank(), fn(found, r: Identity::ReleaseId) =>
        if Names::same(r.key, key) && r.epoch == epoch && r.ordinal == ordinal { r } else { found })

    /// The newest release of `epoch` for `key`, when that epoch lists one.
    export fn newestIn(listing, key, epoch) = match newestOrdinal(listing, key, epoch) {
        Error => Maybe::none()
        Success { value } => Maybe::some(releaseIn(listing, key, epoch, value))
    }
}
