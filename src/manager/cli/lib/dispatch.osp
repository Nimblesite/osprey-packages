namespace registry_cli;

/// Command routing for the Osprey package frontend. Implements the command
/// surface of [PACKAGE-API] one command at a time: a command the
/// specification does not know is a usage error.
module Dispatch {
    let usage = [
        "usage: osprey-pkg [--json] <command>",
        "commands: help, doctor, package init, add, remove, update, use, lock, fetch, verify, audit, build, run, test, docs, tree, why, publish --folder, yank --folder, login"
    ]

    fn unknown(command) = Reports::usage(listPrepend(usage, "unknown command: ${command}"))

    /// A target-less `fetch` (no positional target word) installs the lock.
    fn fetchIsInstall(args) = isEmpty(args) || startsWith(listGet(args, 0) ?: "", "--")

    fn fetchOrInstall(args) = if fetchIsInstall(args) { Install::run(args) } else { Fetch::run(args) }

    /// `package init` is the one `package` subcommand this build has.
    fn packageCommand(args) = {
        let word = listGet(args, 0) ?: ""
        if word == "init" { Init::run(Flags::tail(args)) } else { unknown("package ${word}") }
    }

    /// The same report as one canonical JSON line (`--json <command> …`).
    fn jsonOf(report) = Reports::Report { status: report.status, lines: [Reports::json(report)] }

    fn help(_rest) = Reports::success(usage)

    fn doctor(_rest) = Doctor::report()

    /// The routing table: the function each command word hands the rest of
    /// the command line to; a word it does not know is the usage report.
    fn handlerOf(command) = match command {
        "--json" => fn(rest) => jsonOf(run(rest))
        "help" => help
        "doctor" => doctor
        "package" => packageCommand
        "add" => Add::run
        "remove" => Remove::run
        "update" => Update::run
        "use" => Use::run
        "publish" => Publish::run
        "yank" => Yank::run
        "login" => Login::run
        "fetch" => fetchOrInstall
        "lock" => Lock::run
        "verify" => Verify::run
        "audit" => Audit::run
        "docs" => Build::docs
        "build" => Build::run
        "run" => Build::exec
        "test" => Build::runTest
        "tree" => Tree::run
        "why" => Why::run
        word => fn(_rest) => unknown(word)
    }

    /// Route one argument vector to its command: the first word names the
    /// command, the words after it are that command's own arguments.
    export fn run(args) = handlerOf(listGet(args, 0) ?: "help")(Flags::tail(args))
}
