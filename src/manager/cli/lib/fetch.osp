namespace registry_cli;
import registry::Checked
import registry_host::Host
import registry::Bundle
import registry::Bytes
import registry::Source
import registry::Digests
import registry::Identity
import registry::Json
import registry::JsonRead
import registry::Names
import registry::Order
import registry::Release

/// `osprey-pkg fetch`: download, verify and install one release of a folder
/// registry. The transport is never trusted — the source bundle is decoded
/// and its digest recomputed from the files before anything is written — and
/// every failure is a stable dotted reason code. Implements the client half
/// of [PACKAGE-FOLDER-REGISTRY] ([PLAN-STANDUP]).
module Fetch {
    /// The folder-registry base URL when no `--registry` flag is given.
    export let defaultRegistry = "http://127.0.0.1:8787"
    /// The flag that names a non-default registry base URL.
    export let registryFlag = "--registry"
    /// The root under which every fetched release tree is installed.
    export let packagesRoot = ".osprey/packages"
    let packagesPrefix = "/v1/packages/"
    /// The GET path that lists every package key with its releases.
    export let packagesListingPath = "/v1/packages"
    let sourcePrefix = "/v1/releases/"
    let sourceSuffix = "/source"
    let bundleFlag = "--bundle"
    let okStatus = 200
    let notFoundStatus = 404
    let anyEpoch = -1
    let slashByte = 47
    let digestPrefix = "sha256:"
    let usageCode = "fetch.usage"
    let notFoundCode = "fetch.not-found"
    let statusPrefix = "fetch.registry-status"
    let noReleaseCode = "fetch.no-release"
    let shapeCode = "fetch.package-shape"
    let yankedStatus = "Yanked"
    let writePrefix = "fetch.write"
    let usageText = [
        "usage: osprey-pkg fetch <target> [--registry <base-url>]",
        "target: @scope/name[@e<epoch>] or sha256:<64 hex>; offline: fetch <digest> --bundle <file>"
    ]

    /// One `{"digest","epoch","ordinal"[,"status"]}` row of a package listing;
    /// `yanked` when its status is `Yanked` ([PACKAGE-RESOLUTION]).
    export type Row = { digest: string, epoch: int, ordinal: int, yanked: bool }

    /// One listed release and whether the registry marks it yanked.
    export type Listed = { release: Identity::ReleaseId, yanked: bool }

    /// What the target word asks for: the newest release, the newest ordinal
    /// of one epoch, or the release of one digest.
    type Ask = Newest { key: Names::Key } | InEpoch { key: Names::Key, epoch: int } | ByDigest { digest: string }

    /// A parsed command line: a target to fetch from a registry, or a digest
    /// to take from an offline bundle.
    type CommandLine = FromRegistry { target: string, base: string } | FromBundle { digest: string, path: string }

    fn wordAt(args, i) = listGet(args, i) ?: ""

    /// `<target> [--registry <base-url>]` or `<digest> --bundle <file>`: a
    /// flag, when given, only after the target.
    fn commandLine(args) = match length(args) {
        1 => Success { value: FromRegistry { target: wordAt(args, 0), base: defaultRegistry } }
        3 => flagged(wordAt(args, 0), wordAt(args, 1), wordAt(args, 2))
        _ => Error { message: usageCode }
    }

    /// The command line `target <flag> word` makes: the flag in the middle decides.
    fn flagged(target, flag, word) = if flag == registryFlag { Success { value: FromRegistry { target: target, base: word } } }
    else if flag == bundleFlag { Success { value: FromBundle { digest: target, path: word } } }
    else { Error { message: usageCode } }

    /// One argument parsed as a release selector, or `fetch.usage`.
    fn ask(parsed, make) = match parsed {
        Success { value } => Success { value: make(value) }
        Error => Error { message: usageCode }
    }

    fn digestAsk(text) = ask(Digests::parse(text), fn(value) => ByDigest { digest: value })

    fn newestAsk(text) = ask(Names::parse(text), fn(value) => Newest { key: value })

    fn epochOf(key, versionText) = ask(decimal(drop(versionText, 1)), fn(value) => InEpoch { key: key, epoch: value })

    fn epochAsk(keyText, versionText) = match Names::parse(keyText) {
        Error => Error { message: usageCode }
        Success { value } => epochOf(value, versionText)
    }

    fn keyAsk(text) = match indexOf(drop(text, 1), "@") {
        Error => newestAsk(text)
        Success { value } => epochAsk(take(text, value + 1), drop(text, value + 2))
    }

    /// Non-negative decimal without a sign or leading zero, as the release
    /// directory layout writes it.
    fn decimal(text) = match byteLength(text) == 0 || (startsWith(text, "0") && byteLength(text) > 1) || startsWith(text, "+") || startsWith(text, "-") {
        true => Error { message: usageCode }
        false => parseInt(text)
    }

    fn parseTarget(text) = match startsWith(text, digestPrefix) {
        true => digestAsk(text)
        false => keyAsk(text)
    }

    // `Reply` shares `status` with `Reports::Report` and `Host::Run`; issue
    // #273 needs the receiver spelled out.
    fn bodyOf(reply: Host::Reply) = if reply.status == notFoundStatus {
        Error { message: notFoundCode }
    } else if reply.status == okStatus {
        Success { value: reply.body }
    } else {
        Error { message: "${statusPrefix}: ${reply.status}" }
    }

    /// One GET body, or the stable code of a non-200/404 status; `lock`
    /// reuses this for the listing endpoints.
    export fn getBody(base, path) = andThen(perform Host::Web.get(base, path), fn(value) => bodyOf(value))

    // `Names::Key` shares no field, but the receiver is annotated to match
    // the other shared-field readers below.
    /// The GET path of one key's releases.
    export fn listingPath(key: Names::Key) = "${packagesPrefix}${key.scope}/${key.name}"

    fn sourcePath(digest) = "${sourcePrefix}${digest}${sourceSuffix}"

    /// The optional `status`: absent is Eligible, `Yanked` is yanked, and any
    /// other value is `fetch.package-shape`, so an unknown state never reads as Eligible.
    fn yankedOf(item) = match Json::get(item, "status") {
        Error => Success { value: false }
        Success { value } => match value {
            Json::Str { text } => if text == yankedStatus { Success { value: true } } else { Error { message: shapeCode } }
            _ => Error { message: shapeCode }
        }
    }

    /// One `{"digest","epoch","ordinal"[,"status"]}` row; any member missing or
    /// of another kind is `fetch.package-shape`.
    fn rowOf(item) = andThen(JsonRead::requiredText(item, "digest", shapeCode), fn(digest) =>
        andThen(JsonRead::requiredInt(item, "epoch", shapeCode), fn(epoch) =>
            andThen(JsonRead::requiredInt(item, "ordinal", shapeCode), fn(ordinal) =>
                Folds::mapped(yankedOf(item), fn(yanked) => Row { digest: digest, epoch: epoch, ordinal: ordinal, yanked: yanked }))))

    fn rowsOf(items) = Checked::collectAll(items, rowOf)

    /// `releases` of a package document: its rows, or `fetch.package-shape` when it is not an array.
    fn releasesOf(root) = andThen(JsonRead::requiredItems(root, "releases", shapeCode), rowsOf)

    /// A parsed JSON document handed to `ofRoot`; a document that is not
    /// JSON, or of any other shape, is `"fetch.package-shape"`.
    fn parsedDocument(text, ofRoot) = Checked::orElseCode(Json::parse(text), shapeCode, ofRoot)

    /// `{"key":"@s/n","releases":[{"digest","epoch","ordinal"}]}`.
    export fn parseListing(text) = parsedDocument(text, releasesOf)

    fn releaseOf(key, row: Row) = Identity::ReleaseId { key: key, epoch: row.epoch, ordinal: row.ordinal, digest: row.digest }

    fn listedOf(key, row) = Listed { release: releaseOf(key, row), yanked: row.yanked }

    fn keyedRows(key, rows) = Folds::mapped(rows, fn(value) => mapList(value, fn(row) => listedOf(key, row)))

    /// The `key` member as a package key; one that does not parse is `fetch.package-shape`.
    fn keyOfItem(item) = andThen(JsonRead::requiredText(item, "key", shapeCode), fn(value) => Checked::mapError(Names::parse(value), fn(_reason) => shapeCode))

    /// The releases of one `{"key","releases"}` package item, each with its yank mark.
    fn packageReleases(item) = andThen(keyOfItem(item), fn(value) => keyedRows(value, releasesOf(item)))

    /// The `packages` array of the listing document, every item's releases in order.
    fn packagesOf(root) = andThen(JsonRead::requiredItems(root, "packages", shapeCode), fn(items) =>
        Folds::collect(items, Success { value: [] }, fn(done, item) => Folds::mapped(packageReleases(item), fn(value) => listConcat(done, value))))

    /// Every release of `{"packages":[{"key","releases":[…]}]}` with its yank
    /// mark, in listing order, so `lock` reads the whole registry in one
    /// request; any other shape is `"fetch.package-shape"`.
    export fn parsePackages(text) = parsedDocument(text, packagesOf)

    // `Row` shares `digest`/`epoch`/`ordinal` with `Identity::ReleaseId`;
    // issue #273 needs the receivers spelled out.
    fn missingRow() = Row { digest: "", epoch: 0, ordinal: 0, yanked: false }

    fn later(a: Row, b: Row) = Order::compareSpots(a.epoch, a.ordinal, b.epoch, b.ordinal) > 0

    fn keepBest(best, row) = if later(row, best) { row } else { best }

    fn eligibleRows(rows) = filterList(rows, fn(row: Row) => !row.yanked)

    /// The newest row a fresh fetch may choose: never a yanked one.
    fn bestRow(all) = {
        let rows = eligibleRows(all)
        match isEmpty(rows) {
        true => Error { message: noReleaseCode }
            false => Success { value: foldList(rows, listGet(rows, 0) ?: missingRow(), keepBest) }
        }
    }

    fn rowsOfEpoch(rows, epoch) = filterList(rows, fn(row: Row) => row.epoch == epoch)

    fn chosen(rows, epoch) = match epoch < 0 {
        true => bestRow(rows)
        false => bestRow(rowsOfEpoch(rows, epoch))
    }

    // `Identity::ReleaseId` shares `key` with `Json::Member` and `digest`
    // with `Source::Entry`; issue #273 needs the receiver spelled out.
    /// `.osprey/packages/@scope/name/<hex>` for one release identity.
    export fn installDir(id: Identity::ReleaseId) = "${packagesRoot}/${Names::display(id.key)}/${Digests::hexOf(id.digest)}"

    /// `installDir` under `project`, or the bare cwd path when `project` is
    /// `""` or `"."` ([PACKAGE-HARDENING] C2).
    export fn installDirAt(project, id) = Project::pathAt(project, installDir(id))

    // Reading builds `Release::File` (whose fields no other record shares),
    // then `Source::entryOf` maps them non-recursively exactly as
    // `ReleaseFiles::assemble` does: an effectful recursive function that
    // constructs `Source::Entry` (whose `path` is shared with `Asset`) trips
    // the issue-#273 codegen quarantine.
    fn readNext(dir, relPaths, i, files, rel) = andThen(perform Host::Files.read("${dir}/${rel}"), fn(value) => readFiles(dir, relPaths, i + 1, listAppend(files, Release::File { relPath: rel, content: value })))

    fn readFiles(dir, relPaths, i, files) = if i >= length(relPaths) {
        Success { value: files }
    } else {
        readNext(dir, relPaths, i, files, listGet(relPaths, i) ?: "")
    }

    fn entriesOf(files) = mapList(files, fn(file: Release::File) => Source::entryOf(file.relPath, Bytes::ofString(file.content)))

    fn kindOf(walk: Host::Walk) = if !isEmpty(walk.executable) { Source::kindCode("executable") }
    else if !isEmpty(walk.special) { Source::kindCode("special") }
    else { "" }

    /// The files a walk found, read in walk order; a non-regular entry or an
    /// unreadable file is its stable code.
    export fn filesOfWalked(walk: Host::Walk, dir) = {
        let kind = kindOf(walk)
        if kind != "" { Error { message: kind } } else { readFiles(dir, walk.regular, 0, []) }
    }

    /// `SourceDigest` of a file list, recomputed exactly as the server computed
    /// the release digest ([PACKAGE-SOURCE-CANONICAL]).
    export fn digestOfFiles(fileList) = Source::digest(entriesOf(fileList))

    /// Every regular file under the installed tree `dir`, read in walk order;
    /// a non-regular entry or an unreadable file is its stable code.
    export fn installedFiles(dir) = andThen(perform Host::Tree.walk(dir), fn(value) => filesOfWalked(value, dir))

    fn lastSlash(path) = fold(range(0, byteLength(path)), -1, fn(best, i) => if (byteAt(path, i) ?: 0) == slashByte { i } else { best })

    fn ensureParent(dir, relPath) = {
        let slash = lastSlash(relPath)
        match slash < 0 {
            true => Success { value: 0 }
            false => perform Host::Tree.ensure("${dir}/${take(relPath, slash)}")
        }
    }

    fn put(path, content) = andThen(perform Host::Files.write(path, content), fn(written) => if written == byteLength(content) { Success { value: 0 } }
        else { Error { message: "short write ${path}" } })

    fn writeOne(dir, file) = andThen(ensureParent(dir, file.relPath), fn(_made) => put("${dir}/${file.relPath}", file.content))

    fn writeFileList(dir, files) = Folds::collect(files, Success { value: 0 }, fn(_written, file) => writeOne(dir, file))

    /// Write every file of a tree under `dir`, creating directories first;
    /// Publication uses this writer; installation also checks the disk layout and digest.
    export fn writeFiles(dir, files) = andThen(perform Host::Tree.ensure(dir), fn(_made) => writeFileList(dir, files))

    fn unexpected(walk: Host::Walk, fileList) = {
        let expected = mapList(fileList, fn(file: Release::File) => file.relPath)
        !isEmpty(walk.executable) || !isEmpty(walk.special)
        || Folds::any(walk.regular, fn(path) => !listContains(expected, path))
    }

    fn checkedDigest(served: Release::Served, digest) = if digest == served.id.digest { Success { value: served } }
    else { Error { message: "fetch.install-integrity" } }

    fn checkedTree(dir, served) = match installedFiles(dir) {
        Error { message } => Error { message: "fetch.install-integrity ${message}" }
        Success { value } => match digestOfFiles(value) {
            Success { value } => checkedDigest(served, value)
            Error { message } => Error { message: "fetch.install-integrity ${message}" }
        }
    }

    /// The write step's failure spelling: `fetch.write` and the OS reason.
    fn writeFailed(message) = "${writePrefix}: ${message}"

    fn writtenTree(dir, served) = andThen(Checked::mapError(writeFileList(dir, served.files), writeFailed), fn(_written) => checkedTree(dir, served))

    // A refetch must never claim success from the served bytes alone. Reject
    // conflicting entries before writes, then verify the actual installed tree.
    fn installInto(dir, served) = match perform Host::Tree.walk(dir) {
        Error { message } => Error { message: "fetch.install-integrity ${message}" }
        Success { value } => if unexpected(value, served.files) { Error { message: "fetch.install-integrity" } }
        else { writtenTree(dir, served) }
    }

    fn written(project, served) = {
        let dir = installDirAt(project, served.id)
        andThen(Checked::mapError(perform Host::Tree.ensure(dir), writeFailed), fn(_made) => installInto(dir, served))
    }

    fn verifiedAt(project, body, digest) = andThen(Bundle::verify(body, digest), fn(value) => written(project, value))

    /// Download, verify and install one release by digest under
    /// `<project>/.osprey/packages`, answering the verified release so `lock`
    /// and `Install` can read its files without touching the disk again
    /// ([PACKAGE-HARDENING] C2).
    export fn fetched(project, base, digest) = andThen(getBody(base, sourcePath(digest)), fn(value) => verifiedAt(project, value, digest))

    fn fetchedReport(project, served: Release::Served) = Reports::success([
            Reports::field("fetched", Identity::display(served.id)),
            Reports::field("into", installDirAt(project, served.id)),
            Reports::field("files", "${length(served.files)}")
    ])

    /// Download, verify and install one release by digest under `.osprey/packages`.
    export fn install(base, digest) = installAt("", base, digest)

    /// `fetched` as a report: the `fetch <target>` outcome.
    export fn installAt(project, base, digest) = Reports::checked(fetched(project, base, digest), fn(value) => fetchedReport(project, value))

    fn installRow(base, row: Row) = install(base, row.digest)

    fn withRows(base, rows, epoch) = Reports::checked(chosen(rows, epoch), fn(value) => installRow(base, value))

    fn withListing(base, epoch, text) = Reports::checked(parseListing(text), fn(value) => withRows(base, value, epoch))

    fn installKey(base, key, epoch) = Reports::checked(getBody(base, listingPath(key)), fn(value) => withListing(base, epoch, value))

    fn runFetch(base, ask) = match ask {
        ByDigest { digest } => install(base, digest)
        Newest { key } => installKey(base, key, anyEpoch)
        InEpoch { key, epoch } => installKey(base, key, epoch)
    }

    fn asked(target, base) = match parseTarget(target) {
        Error => Reports::usageFor(usageCode, usageText)
        Success { value } => runFetch(base, value)
    }

    /// The offline bundle's tree: its manifest must parse, then it is written
    /// and verified like a fetched one.
    fn offlineTree(served) = andThen(Install::manifestDigestOf(Release::filesOf(served)), fn(_valid) => written("", served))

    fn fromBundle(digest, path) = match Digests::parse(digest) {
        Error => Reports::usageFor(usageCode, usageText)
        Success => Reports::checked(andThen(perform Host::Files.read(path), fn(body) => andThen(Bundle::verify(body, digest), offlineTree)), fn(served) => fetchedReport("", served))
    }

    /// The whole command: parse `<target> [--registry <base-url>]` or
    /// `<digest> --bundle <file>`, choose the release — newest, newest of one
    /// epoch, or the digest's own — download and verify its source bundle,
    /// and write the tree under `.osprey/packages/@scope/name/<digest>/`.
    /// Implements [PACKAGE-FOLDER-REGISTRY].
    export fn run(args) = match commandLine(args) {
        Error => Reports::usageFor(usageCode, usageText)
        Success { value } => match value {
            FromBundle { digest, path } => fromBundle(digest, path)
            FromRegistry { target, base } => asked(target, base)
        }
    }
}
