namespace registry_tests;
import registry::Json
import registry::JsonRead

/// Reading the declarative fixtures under src/manager/tests/fixtures: every
/// suite loads, walks and reports fixture tables through these helpers so no
/// suite carries its own copy. A fixture is the normative table; code only
/// interprets it. Implements the fixture rule of [PACKAGE-CONFORMANCE].
module Fixtures {
    let root = "src/manager/tests/fixtures"

    /// The parsed fixture at `name` under the fixture root; an unreadable or
    /// malformed file becomes a string value naming the problem, so every
    /// assertion over it fails visibly.
    export fn load(name) = match Json::parse(readFile("${root}/${name}") ?: "") {
        Success { value } => value
        Error { message } => Json::Str { text: "fixture ${name} unreadable: ${message}" }
    }

    /// Member `key` of `value`, read through `read`: the one shape of every member reader below.
    fn member(value, key, read) = read(JsonRead::field(value, key))

    /// The text of member `key`, or "".
    export fn textOf(value, key) = member(value, key, JsonRead::text)

    /// The integer of member `key`, or -1.
    export fn numberOf(value, key) = member(value, key, JsonRead::number)

    /// The items of member `key`, or [].
    export fn itemsOf(value, key) = member(value, key, JsonRead::items)

    /// The texts of member `key`, or [].
    export fn textsOf(value, key) = member(value, key, JsonRead::texts)

    /// The items of member `key` of the fixture at `name`.
    export fn loadItems(name, key) = itemsOf(load(name), key)

    /// The texts of member `key` of the fixture at `name`.
    export fn loadTexts(name, key) = textsOf(load(name), key)

    /// Compare `run(input)` with its expected output for every table row.
    export fn mapsTo(inputs, expected, run) = structuralEquals(mapList(inputs, run), expected)

    /// Decimal byte lists for compact binary goldens.
    export fn ints(xs) = join(mapList(xs, fn(b) => "${b}"), ",")

    /// The cases for which `run` is false.
    export fn failures(cases, run) = foldList(cases, [], fn(bad, case) => if run(case) { bad } else { listAppend(bad, case) })

    /// One assertion over a whole table: every case must pass.
    export fn report(label, cases, run) = {
        let bad = failures(cases, run)
        check("${label}: ${length(bad)} of ${length(cases)} failed", 0, length(bad))
    }

    /// The error message of a result, or "" for success.
    export fn code(result) = match result {
        Success => ""
        Error { message } => message
    }
}
