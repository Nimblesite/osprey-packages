namespace registry_tests;
import registry::Conformance
import registry::Capabilities
import registry::Paths
import registry_host::Host
import registry_host::Native

/// The language gate over the checked-in tree. Directory listing is a blocked
/// capability (`files.directory`), so the live walk goes through the native
/// `Process` handler; the classification itself is tested without it.
module ConformanceTests {
    let roots = "src/manager"

    fn classification() = checkAll("only Osprey source and declarative inputs pass", [
        length(Conformance::violations(["src/manager/core/src/names.osp", "src/manager/x.ospml", "src/manager/schemas/package-registry.td"])) == 0,
        length(Conformance::violations(["src/manager/core/osprey.toml", "src/manager/tests/fixtures/manifest.json", "src/manager/README.md", "src/manager/sample-registry/@demo/pyadd/1.1/uv.lock"])) == 0,
        length(Conformance::violations(["src/manager/web/assets/registry.css", "src/manager/web/assets/registry-mark.svg", "src/manager/web/assets/_headers", "src/manager/web/assets/registry-form.mjs", "src/manager/web/assets/registry-catalog.mjs", "src/manager/web/assets/list-filter.mjs"])) == 0,
        length(Conformance::violations(["src/manager/web/assets/app.js", "src/manager/core/_headers"])) == 2,
        length(Conformance::violations(["src/manager/ops/Dockerfile", "src/manager/core/Dockerfile"])) == 1,
        length(Conformance::violations(["src/manager/supabase/migrations/schema.yaml", "src/manager/ops/terraform/api.tf", "src/manager/ops/terraform/.terraform.lock.hcl"])) == 0,
        join(Conformance::violations(["src/manager/host/shim.c", "src/manager/cli/launch.sh", "src/manager/web/app.js", "src/manager/ops/migrate.py", "src/manager/core/src/lib.rs", "src/manager/web/index.html"]), ",") == "src/manager/host/shim.c,src/manager/cli/launch.sh,src/manager/web/app.js,src/manager/ops/migrate.py,src/manager/core/src/lib.rs,src/manager/web/index.html",
        join(Conformance::violations(["src/manager/tests/golden.ospx", "src/manager/Makefile", "src/manager/core/src/notes"]), ",") == "src/manager/tests/golden.ospx,src/manager/Makefile,src/manager/core/src/notes"
    ])

    /// Delivered word primitives must not be reported as missing. Implements [PACKAGE-CONFORMANCE].
    fn bitwiseInventory() = checkAll("word builtins agree with the doctor inventory", [
        structuralEquals([bitAnd(12, 10), bitXor(12, 10), shiftRightLogical(-16, 2)], [8, 6, 4611686018427387900]),
        !contains(join(mapList(Capabilities::blocked(), fn(cap) => cap.id), ","), "int.bitwise")
    ])

    fn listed() = {
        let run = perform Host::Process.run("find ${roots} -type f -not -path '*/.osprey/*'")
        if run.status == 0 { filterList(lines(run.stdout), fn(line) => line != "" && !Paths::generatedCache(line)) } else { [] }
    }

    fn checkedInTree() = {
        let files = listed()
        let violations = Conformance::violations(files)
        checkAll("the checked-in package system contains no non-Osprey executable source", [
            length(files) > 10,
            length(violations) == 0,
            join(violations, ",") == ""
        ])
    }

    /// The language gate: classification by extension, the doctor inventory
    /// of word builtins, and a live walk of the checked-in package system.
    export fn run() = {
        test("conformance: available word builtins are not blocked", bitwiseInventory)
        test("conformance: classification", classification)
        test("conformance: checked-in tree", fn() => Native::process()(checkedInTree))
    }
}
