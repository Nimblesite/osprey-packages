namespace registry_host;

/// Operating-system handlers for `Host`, built only on Osprey builtins.
/// Process output is captured through shell redirection into `.osprey/scratch`
/// because `spawnProcess` streams chunks to a callback and Osprey has no
/// mutable accumulator outside handler arms.
module Native {
    let scratch = ".osprey/scratch"

    fn relay(result) = match result {
        Success { value } => Success { value: value }
        Error { message } => Error { message: message }
    }

    /// Files answered by `readFile`/`writeFile`.
    export fn files() = handler Host::Files {
        read path => relay(readFile(path))
        write path content => relay(writeFile(path, content))
        exists path => fileExists(path)
        remove path => pathOk("rm -f --", path, "host.remove")
    }

    fn quiet(_pid, _kind, text) = {
        let _dropped = text
    }

    fn status(spawned) = match spawned {
        Success { value } => {
            let code = awaitProcess(value)
            let _released = cleanupProcess(value)
            code
        }
        Error => -1
    }

    fn capture(command) = {
        let tag = "${random()}"
        let out = "${scratch}/${tag}.out"
        let err = "${scratch}/${tag}.err"
        let code = status(spawnProcess("umask 077; mkdir -p ${scratch} && ( ${command} ) >${out} 2>${err}", quiet))
        let result = Host::Run { status: code, stdout: readFile(out) ?: "", stderr: readFile(err) ?: "" }
        let removed = status(spawnProcess("rm -f -- ${out} ${err}", quiet))
        if removed == 0 { result }
        else { Host::Run { status: -1, stdout: "", stderr: "host.capture-cleanup" } }
    }

    /// Process answered by the system shell.
    export fn process() = handler Host::Process {
        run command => capture(command)
    }

    /// A failed shell command's error: `code` and its trimmed stderr.
    fn failure(code, run) = Error { message: "${code}: ${trim(run.stderr)}" }

    fn fileExists(path) = {
        let word = Host::shellWord(path)
        let run = capture("parent=$(dirname -- ${word}); if test -e ${word} || test -L ${word}; then printf present; elif test -r \"$parent\" && test -x \"$parent\"; then printf absent; else false; fi")
        if run.status != 0 { failure("host.exists", run) }
        else if run.stdout == "present" { Success { value: true } }
        else if run.stdout == "absent" { Success { value: false } }
        else { Error { message: "host.exists: unexpected response" } }
    }

    /// Run `command` over the shell-quoted `path`: status 0 is `0`, anything
    /// else is `code` with stderr.
    fn pathOk(command, path, code) = {
        let run = capture("${command} ${Host::shellWord(path)}")
        if run.status == 0 { Success { value: 0 } } else { failure(code, run) }
    }

    fn relative(line) = if startsWith(line, "./") { drop(line, 2) } else { line }

    fn listed(run) = listSort(mapList(filterList(split(run.stdout, "\n") ?: [], fn(l) => l != ""), relative))

    fn found(root, test) = capture("cd ${Host::shellWord(root)} && find . ${test}")

    /// The walk, or `host.tree.unreadable` with the OS reason. Osprey has no
    /// directory builtin yet (`files.directory`), so `find` lists the entries.
    fn walked(root) = {
        let regular = found(root, "-type f -links 1 ! -perm -u+x")
        let executable = found(root, "-type f -links 1 -perm -u+x")
        let special = found(root, "! -type d ! -type f -o -type f ! -links 1")
        let failed = if regular.status != 0 { regular } else if executable.status != 0 { executable } else { special }
        if failed.status != 0 { failure("host.tree.unreadable", failed) }
        else { Success { value: Host::Walk { regular: listed(regular), executable: listed(executable), special: listed(special) } } }
    }

    /// Tree answered by the system `find` and `mkdir -p`.
    export fn tree() = handler Host::Tree {
        walk root => walked(root)
        ensure dir => pathOk("mkdir -p", dir, "host.mkdir")
    }

    let timeoutMs = 10000

    fn replyOf(response) = {
        let reply = Host::Reply {
            status: httpResponseStatus(response),
            etag: httpResponseHeader(response, "etag") ?: "",
            body: httpResponseBody(response) ?: ""
        }
        let _freed = httpResponseFree(response)
        Success { value: reply }
    }

    fn transportFailure(message) = Error { message: "http.transport: ${message}" }

    /// The reply to one request already sent on `client`, which is then closed.
    fn closedAfter(client, sent) = {
        let answer = match sent {
            Success { value } => replyOf(value)
            Error { message } => transportFailure(message)
        }
        let _closed = httpCloseClient(client) ?: -1
        answer
    }

    /// One request against `base`, made by `request` on a fresh client.
    fn requested(base, request) = match httpCreateClient(base, timeoutMs) {
        Success { value } => closedAfter(value, request(value))
        Error { message } => transportFailure(message)
    }

    fn fetched(base, path) = requested(base, fn(client) => httpGetResponse(client, path, ""))

    fn posted(base, path, body, headers) = requested(base, fn(client) => httpPostResponse(client, path, body, headers))

    /// Web answered by the runtime HTTP client.
    export fn web() = handler Host::Web {
        get base path => fetched(base, path)
    }

    let callbackFile = ".osprey/login-callback"
    let callbackPolls = 480
    let pollMs = 250

    /// The loopback page of the CLI login: it records the request path for
    /// `awaited` and tells the person to return to the terminal. The listener
    /// calls a named function, so the path reaches the waiting command
    /// through a private file rather than a closure.
    export fn callbackReply(_method, path, _headers, _body) = {
        let _recorded = writeFile(callbackFile, path)
        HttpResponse {
            status: 200,
            headers: "Cache-Control: no-store\r\nReferrer-Policy: no-referrer\r\nX-Content-Type-Options: nosniff\r\n",
            contentType: "text/plain; charset=utf-8",
            streamFd: -1,
            isComplete: true,
            partialBody: "Signed in. Return to the terminal.\n"
        }
    }

    fn polled(i) = match readFile(callbackFile) {
        Success { value } => Success { value: value }
        Error => if i >= callbackPolls { Error { message: "auth.cli-timeout" } } else { pollAfterSleep(i) }
    }

    fn pollAfterSleep(i) = {
        sleep(pollMs)
        polled(i + 1)
    }

    fn forgotten() = pathOk("rm -f --", callbackFile, "host.remove")

    fn awaited(server) = {
        let path = polled(0)
        let _stopped = httpStopServer(server) ?: -1
        let _removed = forgotten()
        path
    }

    fn listened(server) = match httpListen(server, callbackReply) {
        Success => awaited(server)
        Error { message } => Error { message: "auth.cli-port: ${message}" }
    }

    /// Wait up to two minutes for one browser redirect to `127.0.0.1:port`.
    fn awaitCallback(port) = {
        let _ready = pathOk("mkdir -p", ".osprey", "host.mkdir")
        let _stale = forgotten()
        match httpCreateServer(port, "127.0.0.1") {
            Success { value } => listened(value)
            Error { message } => Error { message: "auth.cli-port: ${message}" }
        }
    }

    /// Auth answered by the runtime HTTP client and a one-shot loopback listener.
    export fn auth() = handler Host::Auth {
        post base path body headers => posted(base, path, body, headers)
        callback port => awaitCallback(port)
    }

    /// Console answered by standard output.
    export fn console() = handler Host::Console {
        line text => print(text)
    }

    /// Run `body` with every native handler installed.
    export fn session(body) = files()(fn() => process()(fn() => tree()(fn() => web()(fn() => auth()(fn() => console()(body))))))
}
