namespace registry_tests;
import registry::BuildPlan

/// Golden-vector proofs for canonical `BuildPlan` and `ReleaseIdentityEnvelope`
/// (`osprey.build-plan.v1` and `osprey.release.v1`) [PACKAGE-SOURCE-CANONICAL] [PACKAGE-TYPE-INVARIANTS].
module BuildPlanTests {
    fn samplePlan(caps) = BuildPlan::Plan {
        format: 1,
        scope: "demo",
        name: "report",
        sourceDigest: "sha256:a7a65655016bb7bff859bbd5f5a6561e6f231508ffccefa7bb4f5bdaf0aa5bdf",
        manifestDigest: "sha256:e79f867f038054cb369a62aba515a9c0aa5c0e9951f8ef86514a3d5739fb0d4c",
        resolutionContextDigest: "sha256:1f8b5f586f66d4dcab357b0e03e0e9b4020bda1f4e71358b0dea9816f04d3126",
        selectionDigest: "sha256:fe6103d2f4c515f2587923afe454d03bd0ff4d6e014b7fb7d2bb5a39eeafd3c0",
        moduleGraphDigest: "sha256:8dcdd504197676e0eef9a33e161a69e4481834253e7adb3cdd683652d050c02c",
        compilerInvocationDigest: "sha256:2aac7d77cd3914931c3fdafe05b3d7f1096c34db36aac11f8f3615c386012963",
        testPlanDigest: "sha256:99252a839000b3851b0d0cfe8ceca97c9f5defb907902badf0c7588dc080f9f7",
        outputLayoutDigest: "sha256:4ba1f526fd9e2e4ebe274e562660205d789d19cdaf2b42825cd3f6de9b52191e",
        inferredCapabilities: caps
    }

    fn sampleEnvelope() = BuildPlan::ReleaseEnvelope {
        scope: "demo",
        name: "maths",
        epoch: 1,
        sourceDigest: "sha256:8cad48375ce3a850639c3b94aeb9ee61e6a123926f1ed60e66081248d2cf1d12",
        manifestDigest: "sha256:94b73481640df98e2eef4576bf625ba2101792540b32c323634a1b9a1a658cfe",
        buildPlanDigest: "sha256:7efed15475a4032b13ec4e412ddf9501268a1921a3ca2e40270606659f5b29c6"
    }

    fn planVector() = {
        let expected = "sha256:d1afda20893f49e392dd51488f49bd1ea3bc77a89b11ec662c76d39343ed095a"
        let canonical = BuildPlan::canonicalPlan(samplePlan(["net.http"])) ?: ""
        let digest = BuildPlan::digest(samplePlan(["net.http"])) ?: ""
        let dedupDigest = BuildPlan::digest(samplePlan(["net.http", "net.http"])) ?: ""
        checkAll("BuildPlan canonical bytes and digest match build-plan.json golden vector", [
                byteLength(canonical) == 880,
                digest == expected,
                dedupDigest == expected
        ])
    }

    fn releaseVector() = {
        let expected = "sha256:bece9638d8acc5271e28944cba06dac6a161621592faf6bca5e3a48c7350b39f"
        let canonical = BuildPlan::canonicalRelease(sampleEnvelope()) ?: ""
        let digest = BuildPlan::releaseDigest(sampleEnvelope()) ?: ""
        checkAll("ReleaseIdentityEnvelope canonical bytes and digest match release-identity-envelope.json golden vector", [
                byteLength(canonical) == 325,
                digest == expected
        ])
    }

    fn refused(result, code) = match result {
        Error { message } => message == code
        Success => false
    }

    fn refusals() = {
        let badPlan = samplePlan(["net.http"])
        let badEnv = sampleEnvelope()
        checkAll("malformed BuildPlan and ReleaseIdentityEnvelope are refused", [
                refused(BuildPlan::digest(badPlan { format: 2 }), "build-plan.format"),
                refused(BuildPlan::digest(badPlan { scope: "" }), "build-plan.package"),
                refused(BuildPlan::digest(badPlan { sourceDigest: "not-a-digest" }), "build-plan.digest"),
                refused(BuildPlan::releaseDigest(badEnv { epoch: 0 }), "release.epoch"),
                refused(BuildPlan::releaseDigest(badEnv { name: "" }), "release.package"),
                refused(BuildPlan::releaseDigest(badEnv { buildPlanDigest: "bad" }), "release.digest")
        ])
    }

    export fn run() = {
        test("build plan: golden vector and deduplicated capabilities", planVector)
        test("release identity envelope: golden vector", releaseVector)
        test("build plan and release envelope: invalid inputs refused", refusals)
    }
}
