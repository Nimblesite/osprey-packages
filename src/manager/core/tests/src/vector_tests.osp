namespace registry_tests;
import registry::JsonRead
import registry::Bytes
import registry::Sha256
import registry::Digests
import registry::Canonical
import registry::Merkle
import registry::Dsse
import registry::Json

/// Primary-specification vectors — FIPS 180-4 SHA-256, RFC 8785 JCS, DSSE
/// PAE with the Registry Trust and Discovery spec WebAuthn challenge and EnvelopeDigest, digest
/// algorithm agility, and RFC 9162 Merkle inclusion/consistency proofs —
/// read from src/manager/core/tests/fixtures/vectors and asserted against the core
/// helpers. Every golden was computed independently of the code under test.
module VectorTests {
    /// The Merkle inclusion vector file the tree cases load.
    let merkleVectors = "vectors/merkle.json"

    fn shaCases() = Fixtures::report("sha256 FIPS 180-4 vectors", Fixtures::loadItems("vectors/sha256.json", "cases"), fn(c) =>
        Sha256::ofString(Fixtures::textOf(c, "text")) == Fixtures::textOf(c, "sha256"))

    fn parseOk(t) = match Digests::parse(t) {
        Success { value } => value == t
        Error => false
    }

    fn parseCode(c) = match Digests::parse(Fixtures::textOf(c, "text")) {
        Error { message } => message == Fixtures::textOf(c, "code")
        Success => false
    }

    fn agilityCases() = {
        let fx = Fixtures::load("vectors/digest-agility.json")
        Fixtures::report("digest agility accepted", Fixtures::textsOf(fx, "valid"), parseOk)
        FixtureTests::reportCases(fx, "digest agility rejected", "invalid", parseCode)
    }

    /// The successful `result`'s value equals the case's text at `key`.
    fn equalsText(result, c, key) = match result {
        Success { value } => value == Fixtures::textOf(c, key)
        Error => false
    }

    fn canonicalMatches(c, inputKey, outputKey) = equalsText(Canonical::canonicalize(Fixtures::textOf(c, inputKey)), c, outputKey)
    fn canonOk(c) = canonicalMatches(c, "input", "canonical")

    fn canonRejected(c) = match Canonical::canonicalize(Fixtures::textOf(c, "input")) {
        Error { message } => startsWith(message, Fixtures::textOf(c, "code"))
        Success => false
    }

    fn canonCases() = {
        let fx = Fixtures::load("vectors/rfc8785.json")
        FixtureTests::reportCases(fx, "rfc8785 canonical form", "cases", canonOk)
        FixtureTests::reportCases(fx, "rfc8785 rejected inputs", "rejected", canonRejected)
    }

    fn paeMatches(c, typeKey, payloadKey, decode) = Bytes::hex(Dsse::pae(Fixtures::textOf(c, typeKey), decode(Fixtures::textOf(c, payloadKey)))) == Fixtures::textOf(c, "paeHex")
    fn paeOk(c) = paeMatches(c, "type", "payloadHex", Bytes::fromHex)

    fn intentPae(intent) = paeMatches(intent, "payloadType", "payloadCanonical", Bytes::ofString)

    fn intentCanonical(intent) = canonicalMatches(intent, "payloadInput", "payloadCanonical")

    fn intentChallenge(intent) = Dsse::webAuthnChallenge(Bytes::fromHex(Fixtures::textOf(intent, "paeHex"))) == Fixtures::textOf(intent, "challenge")

    fn intentEnvelope(intent) = Dsse::envelopeDigest(Bytes::ofString(Fixtures::textOf(intent, "envelopeCanonical"))) == Fixtures::textOf(intent, "envelopeDigest")

    fn dsseCases() = {
        let fx = Fixtures::load("vectors/dsse.json")
        let intent = JsonRead::field(fx, "releaseIntent")
        Fixtures::report("dsse PAE bytes", Fixtures::itemsOf(fx, "pae"), paeOk)
        checkAll("dsse release intent detached forms", [
                structuralEquals([intentPae(intent), intentCanonical(intent), intentChallenge(intent)], [true, true, true]),
                intentEnvelope(intent)
        ])
    }

    fn merkleLeaves() = mapList(Fixtures::loadTexts(merkleVectors, "leaves"), Bytes::fromHex)

    fn merkleRoots() = Fixtures::loadTexts(merkleVectors, "roots")

    fn rootAt(size) = listGet(merkleRoots(), size) ?: ""

    fn firstLeaves(leaves, n) = range(0, n) |> map(fn(i) => listGet(leaves, i) ?: []) |> toList

    fn rootMatches(i) = Bytes::hex(Merkle::root(firstLeaves(merkleLeaves(), i))) == rootAt(i)

    fn hexProof(c) = mapList(Fixtures::textsOf(c, "proof"), Bytes::fromHex)

    fn hexes(hashes) = join(mapList(hashes, Bytes::hex), ",")

    fn leafAt(index) = Merkle::leafHash(listGet(merkleLeaves(), index) ?: [])

    /// True when the verifier accepted and its recomputed proof matches the case's.
    fn proofAgrees(verified, recomputed, proof) = match verified {
        true => hexes(recomputed) == hexes(proof)
        false => false
    }

    fn negativeRoot(c, size) = match Json::get(c, "root") {
        Success { value } => rootAt(JsonRead::number(value))
        Error => rootAt(size)
    }

    /// One inclusion/consistency vector: a positive case must be accepted and
    /// recompute the case's proof; a rejection case must be refused.
    fn numberAt(c, keys, index) = Fixtures::numberOf(c, listGet(keys, index) ?: "")

    fn merkleCase(c, kind, reject) = {
        let keys = if kind == "inclusion" { ["index", "size"] } else { ["first", "second"] }
        let a = numberAt(c, keys, 0)
        let b = numberAt(c, keys, 1)
        let proof = hexProof(c)
        let verified = if kind == "inclusion" {
            Merkle::verifyInclusion(a, b, leafAt(a), proof, Bytes::fromHex(inclusionRoot(c, b, reject)))
        } else {
            Merkle::verifyConsistency(a, b, consistencyRoot(c, a, b, reject), consistencyRoot(c, b, a, reject), proof)
        }
        let recomputed = if kind == "inclusion" { Merkle::inclusionProof(a, firstLeaves(merkleLeaves(), b)) } else { Merkle::consistencyProof(a, firstLeaves(merkleLeaves(), b)) }
        if reject { !verified } else { proofAgrees(verified, recomputed, proof) }
    }

    /// The trusted root a rejection case must be judged against.
    fn inclusionRoot(c, size, reject) = if reject { negativeRoot(c, size) } else { rootAt(size) }

    /// The proof's roots, swapped when a rejection case says so.
    fn consistencyRoot(c, root, other, swapped) = Bytes::fromHex(rootAt(if swapped && Fixtures::textOf(c, "label") == "swapped roots" { other } else { root }))

    fn merkleCases(kind) = Fixtures::report("merkle ${kind}", foldList(Fixtures::loadItems(merkleVectors, "negative"), [],
            fn(acc, c) => if Fixtures::textOf(c, "kind") == kind { listAppend(acc, c) } else { acc }), fn(c) => merkleCase(c, kind, true))

    fn positiveMerkle(fx, kind) = FixtureTests::reportCases(fx, "merkle ${kind} proofs", kind, fn(c) => merkleCase(c, kind, false))

    /// Every primary-specification vector group, in one run.
    export fn run() = {
        let fx = Fixtures::load(merkleVectors)
        test("vector: sha256", shaCases)
        test("vector: digest agility", agilityCases)
        test("vector: rfc8785", canonCases)
        test("vector: dsse", dsseCases)
        test("vector: merkle roots", fn() => Fixtures::report("merkle roots 0..8", range(0, 9) |> toList, rootMatches))
        test("vector: merkle inclusion", fn() => positiveMerkle(fx, "inclusion"))
        test("vector: merkle consistency", fn() => positiveMerkle(fx, "consistency"))
        test("vector: merkle rejection", fn() => {
                merkleCases("inclusion")
                merkleCases("consistency")
        })
    }
}
