namespace registry_editor
import ui::Doc
import ui::Lists
import registry::Names

// Implements [PACKAGE-EDITOR-GRAPH]: the editor consumes the canonical
// `osprey-pkg tree --graph` semantic report and never scans TOML, a lock or
// package sources itself.

type EntryIdentity =
    entryKey : string
    entryVersion : string
    entryDigest : string

type PackageEntry =
    entryIdentity : EntryIdentity
    entryDirect : bool
    entryPresent : bool
    entryDependencies : List<string>
    entryDependents : List<string>
    entryFindings : List<string>

type Graph =
    graphProject : string
    graphPackages : List<PackageEntry>
    graphDirect : List<string>
    graphFindings : List<string>

type CatalogEntry =
    catalogKey : string
    catalogVersions : List<string>
    catalogFindings : List<string>
    catalogEvidence : bool

(** The `tree --graph` report and the registry catalog as typed values, validated member by member. *)
module Packages
    failure message = Error(message = message)

    dataLabel = "Package data"

    canonical text = match Names::parse text
        Error _ => failure "${text} is not a canonical package key"
        Success key => match Names::display key == text
            true => Success(value = text)
            false => failure "${text} is not a canonical package key"

    keyText item = match jsonText item
        Error _ => failure "Package keys must be strings"
        Success text => canonical text

    appendParsed (parsed, parseItem, item) = match parsed
        Error problem => Error(message = problem)
        Success values => match parseItem item
            Error problem => Error(message = problem)
            Success value => Success(value = listAppend values value)

    collect (items, parseItem) = foldList (items, Success(value = []), \(parsed, item) => appendParsed (parsed, parseItem, item))

    /// The array member `key` of the document named `label`.
    arrayAt (doc, key, label, parse) = match jsonField doc key
        Error _ => failure "${label} is missing ${key}"
        Success value => match value
            JsonArray items => parse items
            _ => failure "${label} has a non-list ${key}"

    /// The array member `key` parsed one item at a time by `parseItem`.
    listAt (doc, key, parseItem) = arrayAt (doc, key, "Package data", \items => collect (items, parseItem))

    keyListAt (doc, key) = listAt (doc, key, keyText)

    textItem item = match jsonText item
        Error _ => failure "Package data has a non-string entry"
        Success text => Success(value = text)

    textListAt (doc, key) = listAt (doc, key, textItem)

    identityFor (doc, key) = andThen (Fields::stringField (doc, "version", dataLabel), \version =>
        andThen (Fields::stringField (doc, "digest", dataLabel), \digest => Success(value = EntryIdentity(entryKey = key, entryVersion = version, entryDigest = digest))))

    /// The document's package key once it is canonical, handed to `read` with the document.
    keyed (doc, read) = andThen (Fields::stringField (doc, "key", dataLabel), \text => andThen (canonical text, \key => read (doc, key)))

    identity doc = keyed (doc, identityFor)

    flags identityValue doc = andThen (Fields::boolField (doc, "direct", dataLabel), \direct =>
        andThen (Fields::boolField (doc, "present", dataLabel), \present => Success(value = PackageEntry(entryIdentity = identityValue, entryDirect = direct, entryPresent = present, entryDependencies = [], entryDependents = [], entryFindings = []))))

    linkedDraft (doc, draft, dependencies, dependents) = andThen (textListAt (doc, "findings"), \findings => Success(value = PackageEntry(entryIdentity = draft.entryIdentity, entryDirect = draft.entryDirect, entryPresent = draft.entryPresent, entryDependencies = dependencies, entryDependents = dependents, entryFindings = findings)))

    links draft doc = andThen (keyListAt (doc, "dependencies"), \dependencies =>
        andThen (keyListAt (doc, "dependents"), \dependents => linkedDraft (doc, draft, dependencies, dependents)))

    entry doc = andThen (identity doc, \identityValue => andThen (flags identityValue doc, \draft => links draft doc))

    entries items = collect (items, entry)

    keyOf item = item.entryIdentity.entryKey

    packagesField doc = arrayAt (doc, "packages", "Package graph", entries)

    checkedGraph (project, packages, direct, findings) = match Lists::distinct (mapList (packages, \item => keyOf item))
        false => failure "Package graph repeats a package key"
        true => Success(value = Graph(graphProject = project, graphPackages = packages, graphDirect = direct, graphFindings = findings))

    graphOf (doc, project, direct) = andThen (packagesField doc, \packages =>
        andThen (textListAt (doc, "findings"), \findings => checkedGraph (project, packages, direct, findings)))

    graph doc = andThen (Fields::stringField (doc, "project", dataLabel), \project =>
        andThen (keyListAt (doc, "direct"), \direct => graphOf (doc, project, direct)))

    intAt (doc, key) = Fields::intField (doc, key, dataLabel)

    release doc = andThen (intAt (doc, "epoch"), \epoch => andThen (intAt (doc, "ordinal"), \ordinal => Success(value = "e${epoch}.r${ordinal}")))

    releases items = collect (items, release)

    nonEmptyVersions versions = match isEmpty versions
        true => failure "Catalog package has no releases"
        false => Success(value = versions)

    catalogVersion doc = arrayAt (doc, "releases", "Catalog package", \items => andThen (releases items, \versions => nonEmptyVersions versions))

    catalogFindings doc = match Doc::has (doc, "findings")
        false => Success(value = [])
        true => textListAt (doc, "findings")

    catalogEntryAt (doc, key) = andThen (catalogVersion doc, \versions =>
        andThen (catalogFindings doc, \findings => Success(value = CatalogEntry(catalogKey = key, catalogVersions = versions, catalogFindings = findings, catalogEvidence = false))))

    catalogEntry doc = keyed (doc, catalogEntryAt)

    catalog doc = arrayAt (doc, "packages", "Registry catalog", \items => collect (items, catalogEntry))

    latestVersion item = match listGet item.catalogVersions (satSub (length item.catalogVersions) 1)
        Success version => version
        Error _ => "No release"

    keyOfCatalog item = item.catalogKey

    findBy (entries, nameOf, key) = Lists::find (entries, \item => nameOf item == key)

    localAuthority authority = authority == "localhost" || authority == "127.0.0.1" || authority == "[::1]"

    localPort (authority, prefix) = match startsWith authority prefix
        false => false
        true => match parseInt (drop authority (byteLength prefix))
            Success port => port > 0 && port <= 65535
            Error _ => false

    loopbackAuthority authority = localAuthority authority || localPort (authority, "localhost:") || localPort (authority, "127.0.0.1:") || localPort (authority, "[::1]:")

    servedFrom (registry, scheme) = match startsWith registry scheme
        true => loopbackAuthority (drop registry (byteLength scheme))
        false => false

    (** Whether an `http://` or `https://` registry is served from `localhost`, `127.0.0.1` or `[::1]`, with any valid port: the unverified local registry. *)
    export isLoopback registry = match servedFrom (registry, "http://")
        true => true
        false => servedFrom (registry, "https://")

    (** The member `name` holding `values` as a string array, for the comparison documents: every scalar slice of the store is spelled as text, in a fixed order. *)
    export strings (name, values) = JsonMember name (Doc::strings values)

    // Each entry is encoded by kind, in a fixed order, for the region comparison.
    encodePackage item = JsonObject [
        strings ("identity", [item.entryIdentity.entryKey, item.entryIdentity.entryVersion, item.entryIdentity.entryDigest]),
        strings ("flags", ["${item.entryDirect}", "${item.entryPresent}"]),
        strings ("dependencies", item.entryDependencies),
        strings ("dependents", item.entryDependents),
        strings ("findings", item.entryFindings),
    ]

    encodeCatalogEntry item = JsonObject [
        Doc::str ("key", item.catalogKey),
        strings ("versions", item.catalogVersions),
        strings ("findings", item.catalogFindings),
        Doc::bit ("evidence", item.catalogEvidence),
    ]

    encoded (items, encode) = JsonArray (mapList (items, encode))

    (** Package entries as the JSON array the region comparison reads. *)
    export encodePackages items = encoded (items, encodePackage)

    (** Catalog entries as the JSON array the region comparison reads. *)
    export encodeCatalog items = encoded (items, encodeCatalogEntry)

    (** The graph of a `tree --graph` JSON document, or why its data is invalid. *)
    export validGraph doc = graph doc

    (** The catalog of a `/v1/packages` JSON document, or why its data is invalid. *)
    export validCatalog doc = catalog doc

    (** The canonical key of a package entry. *)
    export packageKey item = keyOf item

    (** The last release listed for a catalog entry as `e<epoch>.r<ordinal>`, or "No release". *)
    export newest item = latestVersion item

    (** The installed-graph entry named `key`, or the failure of a missing entry. *)
    export packageAt (entries, key) = findBy (entries, keyOf, key)

    (** The catalog entry named `key`, or the failure of a missing entry. *)
    export catalogAt (entries, key) = findBy (entries, keyOfCatalog, key)
