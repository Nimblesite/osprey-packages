namespace hosted_tests;
import registry_api::HostedRequest
import registry_api::HostedHeaders
import registry::Maybe

/// The request gate in order: edge secret, host, method, URI and body
/// bounds, then the credentialed origin/CSRF chain. Implements
/// [PACKAGE-HOSTED-EDGE] and [PACKAGE-HOSTED-AUTH] request admission.
module RequestTests {
    let v1Packages = "/v1/packages"
    let contentLengthRefusal = "400:req.content-length"
    let hostRefusal = "421:req.host"

    fn policy() = HostedRequest::Policy {
        allowedOrigin: "https://packages.example.test",
        allowedHost: "api.example.test",
        edgeSecret: "s3cr3t-edge",
        edgeSecretOverlap: Maybe::none(),
        cookieName: "session",
        csrfToken: "csrf-tok",
        maxBody: 1024
    }

    fn incoming(method, uri, headerBlock, body) = HostedRequest::Incoming {
        method: method, uri: uri, headerBlock: headerBlock, body: body
    }

    fn verdictOf(v) = if HostedHeaders::isOk(v) { "admitted" }
        else { "${HostedHeaders::statusOf(v)}:${HostedHeaders::codeOf(v)}" }

    fn raw(method, uri, headers, body) = verdictOf(HostedRequest::admit(incoming(method, uri, headers, body), policy()))

    fn verdict(method, uri, extra, body) = raw(method, uri, "X-Edge-Secret: s3cr3t-edge\r\nHost: registry-abc-ts.a.run.app\r\nX-Edge-Host: api.example.test" + (if extra == "" { "" } else { "\r\n" + extra }), body)

    fn rawCase(c) = raw(c.method, c.uri, c.headers, c.body) == c.expected
    fn verdictCase(c) = verdict(c.method, c.uri, c.extra, c.body) == c.expected
    fn checkVerdicts(cases) = foldList(cases, true, fn(valid, c) => verdictCase(c) && valid)

    fn admitted() = {
        let cases = [
            { method: "GET", uri: v1Packages, extra: "", body: "", expected: "admitted" },
            { method: "GET", uri: v1Packages, extra: "Cookie: theme=1", body: "", expected: "admitted" },
            { method: "POST", uri: "/v1/auth/logout", extra: "Origin: https://packages.example.test\r\nCookie: session=abc\r\nX-Csrf-Token: csrf-tok", body: "", expected: "admitted" }
        ]
        checkAll("request: clean requests admitted", [
            match HostedRequest::admit(incoming("POST", "/v1/publish", "X-Edge-Host: api.example.test\r\nX-Edge-Secret: s3cr3t-edge", "release"), policy()) {
                HostedHeaders::Ok { value } => value.method == "POST" && value.uri == "/v1/publish" && value.body == "release"
                _ => false
            },
            checkVerdicts(cases)
        ])
    }

    fn edgeAndHost() = {
        let cases = [
            { method: "GET", uri: "/v1/health", headers: "X-Edge-Host: api.example.test", body: "", expected: "403:req.edge-secret" },
            { method: "GET", uri: "/v1/health", headers: "X-Edge-Secret: wrong\r\nX-Edge-Host: api.example.test", body: "", expected: "403:req.edge-secret" },
            { method: "GET", uri: "/v1/health", headers: "X-Edge-Secret: s3cr3t-edge\r\nX-Edge-Host: run.app", body: "", expected: hostRefusal },
            { method: "GET", uri: "/v1/health", headers: "X-Edge-Secret: s3cr3t-edge", body: "", expected: hostRefusal },
            { method: "GET", uri: "/v1/health", headers: "X-Edge-Secret: s3cr3t-edge\r\nHost: api.example.test", body: "", expected: hostRefusal },
            { method: "GET", uri: "/v1/health", headers: "X-Edge-Secret: s3cr3t-edge\r\nHost: api.example.test\r\nX-Edge-Host: evil.example.test", body: "", expected: hostRefusal },
            { method: "GET", uri: "/v1/health", headers: "X-Edge-Secret: s3cr3t-edge\r\nHost: registry-abc-ts.a.run.app\r\nX-Edge-Host: API.Example.Test", body: "", expected: "admitted" },
            { method: "GET", uri: "/v1/health", headers: "X-Edge-Secret: s3cr3t-edge\r\nX-Edge-Host: api.example.test\r\nx-edge-host: api.example.test", body: "", expected: "400:req.duplicate-header" }
        ]
        checkAll("request: edge secret and host gates", [foldList(cases, true, fn(valid, c) => rawCase(c) && valid)])
    }

    fn shape() = {
        let cases = [
            { method: "TRACE", uri: "/v1/health", extra: "", body: "", expected: "405:req.method" },
            { method: "post", uri: v1Packages, extra: "", body: "", expected: "405:req.method" },
            { method: "GET", uri: "v1/health", extra: "", body: "", expected: "400:req.uri" },
            { method: "GET", uri: "/v1/a b", extra: "", body: "", expected: "400:req.uri" },
            { method: "GET", uri: "/${repeat("a", 2100) ?: ""}", extra: "", body: "", expected: "414:req.uri" },
            { method: "POST", uri: "/v1/publish", extra: "Origin: https://packages.example.test\r\nContent-Length: 12", body: repeat("a", 2000) ?: "", expected: "413:req.body-size" },
            { method: "POST", uri: "/v1/publish", extra: "Origin: https://packages.example.test\r\nContent-Length: 1a", body: "", expected: contentLengthRefusal },
            { method: "POST", uri: v1Packages, extra: "Content-Length: 003", body: "猫", expected: "admitted" },
            { method: "POST", uri: v1Packages, extra: "Content-Length: 1", body: "猫", expected: contentLengthRefusal },
            { method: "POST", uri: v1Packages, extra: "Content-Length: 4", body: "abc", expected: contentLengthRefusal },
            { method: "POST", uri: v1Packages, extra: "Content-Length: 999999999999999999999999", body: "", expected: contentLengthRefusal }
        ]
        checkAll("request: method, URI and body bounds", [checkVerdicts(cases)])
    }

    fn credentialed() = {
        let cases = [
            { method: "POST", uri: "/v1/publish", extra: "Cookie: session=abc", body: "", expected: "403:req.origin-required" },
            { method: "POST", uri: "/v1/publish", extra: "Origin: https://evil.test\r\nCookie: session=abc", body: "", expected: "403:req.origin-mismatch" },
            { method: "POST", uri: "/v1/publish", extra: "Origin: https://packages.example.test\r\nCookie: session=abc\r\nX-Csrf-Token: nope", body: "", expected: "403:req.csrf-mismatch" },
            { method: "GET", uri: "/v1/private", extra: "Origin: https://packages.example.test\r\nCookie: session=abc", body: "", expected: "admitted" },
            { method: "POST", uri: "/v1/publish", extra: "Authorization: Bearer cli\r\nOrigin: https://evil.test", body: "", expected: "403:req.origin-mismatch" }
        ]
        checkAll("request: credentialed origin and CSRF chain", [checkVerdicts(cases)])
    }

    fn cliBearer() = {
        let cases = [
            { method: "POST", uri: "/v1/publish", extra: "Authorization: Bearer cli", body: "", expected: "admitted" },
            { method: "POST", uri: "/v1/publish", extra: "Authorization: Bearer cli", body: "x", expected: "admitted" }
        ]
        checkAll("request: CLI bearer requests need no browser challenge", [checkVerdicts(cases)])
    }

    /// The request gate in order: admission, edge secret and host, method,
    /// URI and body bounds, the credentialed origin/CSRF chain and CLI bearer requests.
    export fn run() = {
        test("hosted request: admitted", admitted)
        test("hosted request: edge and host", edgeAndHost)
        test("hosted request: shape and bounds", shape)
        test("hosted request: credentialed chain", credentialed)
        test("hosted request: CLI bearer", cliBearer)
    }
}
