namespace hosted_tests;
import registry_api::HostedRequest
import registry_api::HostedHeaders
import registry::Maybe

/// The request gate in order: edge secret, host, method, URI and body
/// bounds, then the credentialed origin/CSRF chain. Implements
/// [PACKAGE-HOSTED-EDGE] and [PACKAGE-HOSTED-AUTH] request admission.
module RequestTests {
    /// One request case. Sent raw, `headers` is the whole header block; sent
    /// behind the valid edge secret and host, it is the header lines that follow them.
    type Case = { method: string, uri: string, headers: string, body: string, expected: string }

    let v1Packages = "/v1/packages"
    let contentLengthRefusal = "400:req.content-length"
    let hostRefusal = "421:req.host"
    let publish = "/v1/publish"

    fn policy() = HostedRequest::Policy {
        allowedOrigin: "https://packages.example.test",
        allowedHost: "api.example.test",
        edgeSecret: "s3cr3t-edge",
        edgeSecretOverlap: Maybe::none(),
        cookieName: "session",
        csrfToken: "csrf-tok",
        maxBody: 1024
    }

    fn incoming(method, uri, headerBlock, body) = HostedRequest::Incoming { method: method, uri: uri, headerBlock: headerBlock, body: body }

    fn verdictOf(v) = if HostedHeaders::isOk(v) { "admitted" }
        else { "${HostedHeaders::statusOf(v)}:${HostedHeaders::codeOf(v)}" }

    fn raw(method, uri, headers, body) = verdictOf(HostedRequest::admit(incoming(method, uri, headers, body), policy()))

    fn verdict(method, uri, extra, body) = raw(method, uri, "X-Edge-Secret: s3cr3t-edge\r\nHost: registry-abc-ts.a.run.app\r\nX-Edge-Host: api.example.test" + (if extra == "" { "" } else { "\r\n" + extra }), body)

    fn case(method, uri, headers, expected) = Case { method: method, uri: uri, headers: headers, body: "", expected: expected }
    /// A case with a body.
    fn posting(method, uri, headers, body, expected) = withBody(case(method, uri, headers, expected), body)

    fn withBody(c, body) = c { body: body }
    /// A GET of the health endpoint with `headers` as its whole block.
    fn health(headers, expected) = case("GET", "/v1/health", headers, expected)
    /// A credentialed POST to publish: `headers` carries the cookie, origin, CSRF or bearer lines.
    fn cred(headers, expected) = case("POST", publish, headers, expected)

    /// Whether `run` admits the case to its expected verdict.
    fn sent(run, c) = run(c.method, c.uri, c.headers, c.body) == c.expected
    /// No case fails.
    export fn allHold(cases, holds) = isEmpty(filterList(cases, fn(c) => !holds(c)))

    fn admitted() = {
        let cases = [
            case("GET", v1Packages, "", "admitted"),
            case("GET", v1Packages, "Cookie: theme=1", "admitted"),
            posting("POST", "/v1/auth/logout", "Origin: https://packages.example.test\r\nCookie: session=abc\r\nX-Csrf-Token: csrf-tok", "", "admitted")
        ]
        let admitsIntact = match HostedRequest::admit(incoming("POST", publish, "X-Edge-Host: api.example.test\r\nX-Edge-Secret: s3cr3t-edge", "release"), policy()) {
            HostedHeaders::Ok { value } => value.method == "POST" && value.uri == publish && value.body == "release"
            _ => false
        }
        checkAll("request: clean requests admitted", [admitsIntact, allHold(cases, fn(c) => sent(verdict, c))])
    }

    fn edgeAndHost() = {
        let cases = [
            health("X-Edge-Host: api.example.test", "403:req.edge-secret"),
            health("X-Edge-Secret: wrong\r\nX-Edge-Host: api.example.test", "403:req.edge-secret"),
            health("X-Edge-Secret: s3cr3t-edge\r\nX-Edge-Host: run.app", hostRefusal),
            health("X-Edge-Secret: s3cr3t-edge", hostRefusal),
            health("X-Edge-Secret: s3cr3t-edge\r\nHost: api.example.test", hostRefusal),
            health("X-Edge-Secret: s3cr3t-edge\r\nHost: api.example.test\r\nX-Edge-Host: evil.example.test", hostRefusal),
            health("X-Edge-Secret: s3cr3t-edge\r\nHost: registry-abc-ts.a.run.app\r\nX-Edge-Host: API.Example.Test", "admitted"),
            health("X-Edge-Secret: s3cr3t-edge\r\nX-Edge-Host: api.example.test\r\nx-edge-host: api.example.test", "400:req.duplicate-header")
        ]
        checkAll("request: edge secret and host gates", [allHold(cases, fn(c) => sent(raw, c))])
    }

    fn shape() = {
        let cases = [
            case("TRACE", "/v1/health", "", "405:req.method"),
            case("post", v1Packages, "", "405:req.method"),
            case("GET", "v1/health", "", "400:req.uri"),
            case("GET", "/v1/a b", "", "400:req.uri"),
            case("GET", "/${repeat("a", 2100) ?: ""}", "", "414:req.uri"),
            posting("POST", publish, "Origin: https://packages.example.test\r\nContent-Length: 12", repeat("a", 2000) ?: "", "413:req.body-size"),
            case("POST", publish, "Origin: https://packages.example.test\r\nContent-Length: 1a", contentLengthRefusal),
            posting("POST", v1Packages, "Content-Length: 003", "猫", "admitted"),
            posting("POST", v1Packages, "Content-Length: 1", "猫", contentLengthRefusal),
            posting("POST", v1Packages, "Content-Length: 4", "abc", contentLengthRefusal),
            case("POST", v1Packages, "Content-Length: 999999999999999999999999", contentLengthRefusal)
        ]
        checkAll("request: method, URI and body bounds", [allHold(cases, fn(c) => sent(verdict, c))])
    }

    fn credentialed() = {
        let cases = [
            cred("Cookie: session=abc", "403:req.origin-required"),
            cred("Origin: https://evil.test\r\nCookie: session=abc", "403:req.origin-mismatch"),
            cred("Origin: https://packages.example.test\r\nCookie: session=abc\r\nX-Csrf-Token: nope", "403:req.csrf-mismatch"),
            case("GET", "/v1/private", "Origin: https://packages.example.test\r\nCookie: session=abc", "admitted"),
            cred("Authorization: Bearer cli\r\nOrigin: https://evil.test", "403:req.origin-mismatch")
        ]
        checkAll("request: credentialed origin and CSRF chain", [allHold(cases, fn(c) => sent(verdict, c))])
    }

    fn cliBearer() = {
        let cases = [
            cred("Authorization: Bearer cli", "admitted"),
            posting("POST", publish, "Authorization: Bearer cli", "x", "admitted")
        ]
        checkAll("request: CLI bearer requests need no browser challenge", [allHold(cases, fn(c) => sent(verdict, c))])
    }

    /// The request gate in order: admission, edge secret and host, method,
    /// URI and body bounds, the credentialed origin/CSRF chain and CLI bearer requests.
    export fn run() = {
        test("hosted request: admitted", admitted)
        test("hosted request: edge and host", edgeAndHost)
        test("hosted request: shape and bounds", shape)
        test("hosted request: credentialed chain", credentialed)
        test("hosted request: CLI bearer", cliBearer)
    }
}
