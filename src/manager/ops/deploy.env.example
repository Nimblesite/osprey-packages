# Copy to src/manager/ops/deploy.env (gitignored). One file for both environments.
# deploy.sh looks up the rest: billing account, Cloudflare account and zone IDs, the Supabase
# token from `supabase login`, and CI's Pages token (Terraform mints it).

# Created and billing-linked on the first run if missing.
GCP_PROJECT_ID=osprey-registry
# Zone apex on Cloudflare. Hostnames: packages[-staging], packages-api[-staging], packages-content[-staging].<DOMAIN>
DOMAIN=nimblesite.ai
SUPABASE_ORG_ID=married-green-canid
SUPABASE_REGION=ap-southeast-2
# Shared zone only: other hosts the zone's single free rate-limit rule must keep covering.
RATE_LIMIT_EXTRA_HOSTS=api.nimblesite.ai

# Secrets: never commit.
CLOUDFLARE_API_TOKEN=
# Optional on the first run: the script prints each environment's callback URL to register.
GITHUB_OAUTH_CLIENT_ID_STAGING=
GITHUB_OAUTH_CLIENT_SECRET_STAGING=
GITHUB_OAUTH_CLIENT_ID_PRODUCTION=
GITHUB_OAUTH_CLIENT_SECRET_PRODUCTION=
