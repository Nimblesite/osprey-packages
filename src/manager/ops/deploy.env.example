# Copy to src/manager/ops/deploy.env (gitignored) and fill every blank. docs/DEPLOY.md says where each comes from.
# One file for both environments; `make deploy ENV=staging|production` reads it.

GCP_PROJECT_ID=
GCP_BILLING_ACCOUNT=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
# Zone apex. Hostnames: packages[-staging], packages-api[-staging], packages-content[-staging].<DOMAIN>
DOMAIN=ospreylang.dev
SUPABASE_ORG_ID=
SUPABASE_REGION=ap-southeast-2

# Secrets: never commit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_TOKEN=
SUPABASE_ACCESS_TOKEN=
# Optional on the first run: the script prints each environment's callback URL to register.
GITHUB_OAUTH_CLIENT_ID_STAGING=
GITHUB_OAUTH_CLIENT_SECRET_STAGING=
GITHUB_OAUTH_CLIENT_ID_PRODUCTION=
GITHUB_OAUTH_CLIENT_SECRET_PRODUCTION=
