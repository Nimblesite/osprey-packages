namespace registry_api;
import registry::Bytes
import registry::Canonical
import registry::Checked
import registry::Json
import registry::JsonRead

/// Supabase Auth is the identity verifier, reached only over verified TLS at
/// a pinned origin. Application metadata, email and decoded JWT claims never
/// establish registry authority. Implements [PACKAGE-HOSTED-AUTH].
module Supabase {
    let refreshGrant = "refresh_token"
    /// A bounded provider response; raw errors and tokens never enter logs.
    export type Reply = { status: int, body: string }
    /// Stable identity returned by the authenticated /user endpoint.
    export type Identity = { authSubject: string, githubId: string }
    /// Provider session material kept on the API side of the browser boundary.
    export type Session = { accessToken: string, refreshToken: string, expiresIn: int, identity: Identity }

    /// A one-use WebAuthn sign-in challenge: its id, and the `{"publicKey"}` reply the browser signs.
    export type Challenge = { id: string, body: string }
    export let passkeyUnavailable = "auth.passkey-unavailable"
    export let passkeyRejected = "auth.passkey-rejected"
    let providerUnavailable = "auth.provider-unavailable"
    let passkeys = "/auth/v1/passkeys/authentication/"

    /// Handler inputs originate in trusted application code, not route JSON.
    export effect Provider {
        request: fn(string, string, string, string, string) -> Result<Reply, string>
    }

    fn bearerCode(text) = if text == "" || byteLength(text) > 16384 || contains(text, "\n")
    || contains(text, "\r") || contains(text, " ") { "auth.provider-token" } else { "" }

    fn identity(document) = {
        let identities = JsonRead::items(JsonRead::field(document, "identities"))
        let subject = AuthText::field(document, "id")
        let identity = listGet(identities, 0) ?: Json::Null
        let providerId = AuthText::field(identity, "id")
        if length(identities) != 1 || AuthText::field(identity, "provider") != "github" || !Bytes::canonicalUuid(subject)
        || AuthText::field(identity, "user_id") != subject || providerId == "" || startsWith(providerId, "0")
        || !Bytes::everyByte(providerId, Bytes::isDigit) { Error { message: "auth.github-identity" } }
        else { Success { value: Identity { authSubject: subject, githubId: providerId } } }
    }

    fn parseReply(reply: Reply) = if reply.status != 200 { Error { message: "auth.provider-rejected" } }
    else if byteLength(reply.body) > 131072 { Error { message: "auth.provider-size" } }
    else { Checked::mapError(Json::parse(reply.body), fn(_reason) => "auth.provider-json") }

    fn verifiedReply(reply) = match parseReply(reply) {
        Error { message } => Error { message: message }
        Success { value } => identity(value)
    }

    /// The API must still resolve the exact issuer/subject/GitHub-ID binding
    /// to its registry principal. A changed binding requires explicit linking.
    export fn verify(config: OAuth::Config, token) = match OAuth::configCode(config) {
        "" => match bearerCode(token) {
            "" => match perform Provider.request("GET", config.supabaseOrigin, "/auth/v1/user", "apikey: ${config.publishableKey}\r\nAuthorization: Bearer ${token}", "") {
                Success { value } => verifiedReply(value)
                Error => Error { message: providerUnavailable }
            }
            code => Error { message: code }
        }
        code => Error { message: code }
    }

    fn sessionOf(config, document) = {
        let access = AuthText::field(document, "access_token")
        let refresh = AuthText::field(document, refreshGrant)
        let expires = JsonRead::number(JsonRead::field(document, "expires_in"))
        if bearerCode(access) != "" || bearerCode(refresh) != "" || expires < 1 || expires > 86400 { Error { message: "auth.provider-session" } }
        else { match verify(config, access) {
                Error { message } => Error { message: message }
                Success { value } => Success { value: Session { accessToken: access, refreshToken: refresh, expiresIn: expires, identity: value } }
            } }
    }

    fn exchangeReply(config, reply) = match parseReply(reply) {
        Error { message } => Error { message: message }
        Success { value } => sessionOf(config, value)
    }

    fn payload(code, verifier) = Canonical::serialize(Json::Obj { members: [
                Json::Member { key: "auth_code", value: Json::Str { text: code } },
                Json::Member { key: "code_verifier", value: Json::Str { text: verifier } }
            ] })

    fn exchangeBody(config, grant, body) = match jsonRequest(config, "/auth/v1/token?grant_type=${grant}", body) {
        Error => Error { message: providerUnavailable }
        Success { value } => if grant == refreshGrant && listContains([400, 401, 403], value.status) {
            Error { message: "auth.refresh-rejected" }
        } else { exchangeReply(config, value) }
    }

    /// Call only after atomically claiming the matching unexpired, one-use
    /// server-side OAuth flow selected by its HttpOnly flow cookie.
    export fn exchange(config, code, verifier) = match OAuth::configCode(config) {
        "" => if code == "" || byteLength(code) > 1024 || OAuth::challengeCode(verifier) != "" { Error { message: "auth.callback" } }
        else { match payload(code, verifier) {
                Error => Error { message: "auth.callback" }
                Success { value } => exchangeBody(config, "pkce", value)
            } }
        problem => Error { message: problem }
    }

    fn jsonRequest(config, path, body) = perform Provider.request("POST", config.supabaseOrigin, path,
        "apikey: ${config.publishableKey}\r\nContent-Type: application/json", body)

    fn challengeOf(document) = {
        let id = AuthText::field(document, "challenge_id")
        let options = JsonRead::field(document, "options")
        if !Bytes::canonicalUuid(id) || AuthText::field(options, "challenge") == "" { Error { message: passkeyUnavailable } }
        else { match Canonical::serialize(Json::obj([Json::member("publicKey", options)])) {
                Error => Error { message: passkeyUnavailable }
                Success { value } => Success { value: Challenge { id: id, body: value } }
            } }
    }

    fn challengeReply(reply) = match parseReply(reply) {
        Error => Error { message: passkeyUnavailable }
        Success { value } => challengeOf(value)
    }

    /// Ask Supabase Auth passkeys for a sign-in challenge [PACKAGE-HOSTED-AUTH]. Supabase keeps the
    /// challenge and consumes it once; the API relays only its id and the request options.
    export fn passkeyChallenge(config) = if OAuth::configCode(config) != "" { Error { message: passkeyUnavailable } }
    else { match jsonRequest(config, passkeys + "options", "{}") {
            Error => Error { message: passkeyUnavailable }
            Success { value } => challengeReply(value)
        } }

    fn assertionReply(config, reply) = if reply.status >= 400 && reply.status < 500 { Error { message: passkeyRejected } }
    else { exchangeReply(config, reply) }

    /// Supabase verifies the assertion against the challenge; only its signed session for a
    /// GitHub-bound account returns, exactly as after the OAuth exchange.
    export fn passkeySession(config, challenge, credential) = if OAuth::configCode(config) != "" || !Bytes::canonicalUuid(challenge) {
        Error { message: passkeyRejected }
    } else { match Canonical::serialize(Json::obj([Json::member("challenge_id", Json::str(challenge)), Json::member("credential", credential)])) {
            Error => Error { message: passkeyRejected }
            Success { value } => match jsonRequest(config, passkeys + "verify", value) {
                Error => Error { message: providerUnavailable }
                Success { value } => assertionReply(config, value)
            }
        } }

    /// The caller must hold the database refresh claim for the stored credential pair.
    export fn refresh(config, token) = if OAuth::configCode(config) != "" || bearerCode(token) != "" {
        Error { message: "auth.refresh-rejected" }
    } else { andThen(Canonical::serialize(Json::obj([Json::member(refreshGrant, Json::str(token))])), fn(body) =>
            exchangeBody(config, refreshGrant, body)) }
}
