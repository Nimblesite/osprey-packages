namespace registry_api;
import registry::Bytes
import registry::Digests

/// The administrator confirms exactly the immutable submission and digest on screen.
module HostedReview {
    export type Operations = { approve: fn(string, string, string) -> Result<string, string>, receipt: fn(string, string) -> Result<string, string> }
    export let receipts = "/v1/publications/"
    export let missing = "publication.unknown-submission"
    export let prefix = "/v1/reviews/"
    export let denied = "publication.review-denied"
    export let badRequest = "publication.review-request"
    export fn route(path, token: string, approve) -> Result<string, string> = {
        let parts = split(drop(path, byteLength(prefix)), "/") ?: []
        let id = listGet(parts, 0) ?: ""
        let digest = listGet(parts, 1) ?: ""
        if length(parts) != 3 || !Bytes::canonicalUuid(id) || (listGet(parts, 2) ?: "") != "approve" { Error { message: badRequest } }
        else { match Digests::parse(digest) {
                Success => approve(token, id, digest)
                Error => Error { message: badRequest }
            } }
    }
}
