namespace registry_api;
import registry::Bytes
import registry::Canonical
import registry::Dsse
import registry::Json
import registry::JsonRead

/// Cloud KMS protection for the server-held OAuth verifier and session tokens.
module LoginKms {
    let unavailable = "auth.encryption-unavailable"
    fn unavailableError() = Error { message: unavailable }

    fn component(s) = AuthText::bounded(s, 63, [Bytes::hyphen, Bytes::underscore])

    /// Segment `index` of `parts` is `word`.
    fn named(parts, index, word) = (listGet(parts, index) ?: "") == word

    export fn validKey(key) = match split(key, "/") {
        Success { value } => length(value) == 8 && named(value, 0, "projects") && named(value, 2, "locations")
            && named(value, 4, "keyRings") && named(value, 6, "cryptoKeys")
            && foldList([1, 3, 5, 7], true, fn(ok, index) => ok && component(listGet(value, index) ?: ""))
        Error => false
    }

    fn b64(text) = Dsse::base64(Bytes::ofString(text))

    fn json(limit, reply: Supabase::Reply) = if reply.status == 200 && byteLength(reply.body) <= limit {
        match Json::parse(reply.body) {
            Success { value } => Success { value: value }
            Error => unavailableError()
        }
    } else { unavailableError() }

    /// `value` once `ok` holds, else the encryption-unavailable refusal.
    fn disclosed(ok, value) = if ok { Success { value: value } } else { unavailableError() }

    fn token(doc) = {
        let value = AuthText::field(doc, "access_token")
        disclosed(AuthText::field(doc, "token_type") == "Bearer"
            && AuthText::bounded(value, 4096, [Bytes::dot, Bytes::hyphen, Bytes::underscore]), value)
    }

    fn envelopeOk(limit, value) = AuthText::bounded(value, limit, [43, 47, 61])

    fn ciphertext(limit, doc) = disclosed(envelopeOk(limit, AuthText::field(doc, "ciphertext")), AuthText::field(doc, "ciphertext"))

    fn credentials() = andThen(perform Supabase::Provider.request("GET", "http://metadata.google.internal",
        "/computeMetadata/v1/instance/service-accounts/default/token", "Metadata-Flavor: Google", ""), fn(reply) => andThen(json(8192, reply), token))

    fn request(key, operation, token, body, limit, read) = andThen(perform Supabase::Provider.request("POST", "https://cloudkms.googleapis.com",
        "/v1/${key}:${operation}", "Authorization: Bearer ${token}\r\nContent-Type: application/json", body), fn(reply) => andThen(json(limit, reply), read))

    fn submit(key, operation, body, limit, read) = andThen(credentials(), fn(token) => request(key, operation, token, body, limit, read))

    fn textMember(name, text) = Json::member(name, Json::str(text))

    /// The KMS request body binding `aad` as additional authenticated data to the member `name`.
    fn kmsBody(aad, name, value) = Canonical::serialize(Json::obj([
        textMember("additionalAuthenticatedData", b64(aad)),
        textMember(name, value)
    ]))

    fn payload(aad, verifier) = kmsBody(aad, "plaintext", b64(verifier))

    fn encrypt(key, aad, text, limit) = if validKey(key) && byteLength(aad) <= 1024 {
        andThen(payload(aad, text), fn(body) => submit(key, "encrypt", body, limit + 1024, fn(doc) => ciphertext(limit, doc)))
    } else { unavailableError() }

    export fn seal(key, aad, verifier) = if OAuth::challengeCode(verifier) == "" { encrypt(key, aad, verifier, 4096) }
    else { unavailableError() }

    fn tokens(session: Supabase::Session) = Canonical::serialize(Json::obj([
        textMember("accessToken", session.accessToken),
        textMember("authSubject", session.identity.authSubject),
        Json::member("expiresIn", Json::num(session.expiresIn)),
        textMember("githubId", session.identity.githubId),
        textMember("refreshToken", session.refreshToken)
    ]))

    /// Persist only a bounded KMS envelope. The database never receives these tokens.
    export fn sealSession(key, aad, session) = andThen(tokens(session), fn(text) =>
        if byteLength(text) > 32768 { unavailableError() } else { encrypt(key, aad, text, 49152) })
    fn plaintext(doc) = {
        let encoded = AuthText::field(doc, "plaintext")
        if byteLength(encoded) != 60 || !endsWith(encoded, "==") { unavailableError() }
        else { verifierOf(encoded) }
    }

    fn ascii(bytes, encoded) = if Dsse::base64(bytes) == encoded && foldList(bytes, true, fn(ok, b) => ok && b > 0 && b < 128) {
        Success { value: join(mapList(bytes, fn(b) => fromCodePoint(b) ?: ""), "") }
    } else { unavailableError() }

    fn unpadded(encoded) = {
        let text = Bytes::before(encoded, "=")
        replace(replace(text, "+", "-") ?: text, "/", "_") ?: text
    }

    fn decodedText(encoded) = match Dsse::decodeBase64Url(unpadded(encoded)) {
        Error => unavailableError()
        Success { value } => ascii(value, encoded)
    }

    fn verifierOf(encoded) = andThen(decodedText(encoded), fn(clear) => disclosed(OAuth::challengeCode(clear) == "", clear))

    fn decryptPayload(aad, envelope) = kmsBody(aad, "ciphertext", envelope)

    /// Decrypt `envelope`, at most `limit` bytes bound to `aad`, with `key`; the reply is at most `replyLimit` bytes and is read by `read`.
    fn decrypting(key, aad, envelope, limit, replyLimit, read) = if validKey(key) && envelopeOk(limit, envelope) && byteLength(aad) <= 1024 {
        andThen(decryptPayload(aad, envelope), fn(body) => submit(key, "decrypt", body, replyLimit, read))
    } else { unavailableError() }

    /// KMS authenticates the callback and both browser-bound digests before disclosing the verifier.
    export fn unseal(key, aad, envelope) = decrypting(key, aad, envelope, 4096, 8192, plaintext)

    fn graphic(b) = b > 32 && b < 127

    fn tokenText(token) = token != "" && byteLength(token) <= 16384 && Bytes::everyByte(token, graphic)

    fn storedTokens(doc) = {
        let access = AuthText::field(doc, "accessToken")
        let refresh = AuthText::field(doc, "refreshToken")
        let subject = AuthText::field(doc, "authSubject")
        let provider = AuthText::field(doc, "githubId")
        let expires = JsonRead::number(JsonRead::field(doc, "expiresIn"))
        if tokenText(access) && tokenText(refresh) && Bytes::canonicalUuid(subject) && provider != "" && expires > 0 {
            Success { value: Supabase::Session { accessToken: access, refreshToken: refresh, expiresIn: expires,
                identity: Supabase::Identity { authSubject: subject, githubId: provider } } }
        } else { Error { message: "auth.session-required" } }
    }

    fn openedSession(doc) = andThen(decodedText(AuthText::field(doc, "plaintext")), fn(clear) =>
        if byteLength(clear) > 32768 { unavailableError() }
        else { andThen(Json::parse(clear), storedTokens) })

    /// Open a cookie-bound envelope for access-token revalidation on the API host.
    export fn openSession(key, aad, envelope) = decrypting(key, aad, envelope, 49152, 50176, openedSession)
}
