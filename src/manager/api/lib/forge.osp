namespace registry_api;
import registry::Release

/// The GitHub side of [PACKAGE-HOSTED-PUBLISH-FLOW], addressed only by stable numeric repository ID.
/// `admin` answers whether that GitHub account administers the repository; `files` reads the exact
/// commit's subdirectory, refusing a commit the branch cannot reach. Nothing else is ever fetched.
module Forge {
    export effect Repository {
        admin: fn(string, string) -> Result<bool, string>
        files: fn(string, string, string, string) -> Result<List<Release::File>, string>
    }
    export let unconfigured = "forge.unconfigured"

    /// Production until the registry's GitHub App is provisioned: every forge call fails closed.
    export fn closed() = handler Repository {
        admin _repository _github => Error { message: unconfigured }
        files _repository _branch _commit _subdirectory => Error { message: unconfigured }
    }

    /// A positive repository ID that fits the registry’s PostgreSQL bigint column.
    export fn repositoryOk(text) = byteLength(text) >= 1 && (byteLength(text) < 19 || (byteLength(text) == 19 && text <= "9223372036854775807"))
    && !startsWith(text, "0") && registry::Bytes::everyByte(text, registry::Bytes::isDigit)
    /// A full lowercase 40-character commit hash.
    export fn commitOk(text) = byteLength(text) == 40 && registry::Bytes::lowerHexBetween(text, 0, 40)
}
