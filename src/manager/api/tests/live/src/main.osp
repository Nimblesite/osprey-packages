let cacheControl = "cache-control"
let fixtureCiphertext = "c2VhbGVkLWZpeHR1cmU="
let sessionCiphertext = "c2VhbGVkLXNlc3Npb24="
let sessionPlaintext = "eyJhY2Nlc3NUb2tlbiI6ImZpeHR1cmUtcHJvdmlkZXItYWNjZXNzIiwiYXV0aFN1YmplY3QiOiIxMTExMTExMS0xMTExLTQxMTEtODExMS0xMTExMTExMTExMTEiLCJleHBpcmVzSW4iOjYwMCwiZ2l0aHViSWQiOiI0MjEiLCJyZWZyZXNoVG9rZW4iOiJmaXh0dXJlLXByb3ZpZGVyLXJlZnJlc2gifQ=="
let rotatedPlaintext = "eyJhY2Nlc3NUb2tlbiI6ImZpeHR1cmUtcHJvdmlkZXItcm90YXRlZCIsImF1dGhTdWJqZWN0IjoiMTExMTExMTEtMTExMS00MTExLTgxMTEtMTExMTExMTExMTExIiwiZXhwaXJlc0luIjo2MDAsImdpdGh1YklkIjoiNDIxIiwicmVmcmVzaFRva2VuIjoiZml4dHVyZS1wcm92aWRlci1uZXh0In0="
