namespace registry_live_tests;
import registry::PublicCatalog

/// The refresher publishes exactly the eligible releases of active packages in active
/// organizations [PACKAGE-HOSTED-ROUTES-CATALOG]: newest release first, the package's summary,
/// keywords and warnings from its newest eligible release, yanked and revoked releases left out,
/// a package with no eligible release, a draft package and a tombstoned organization left out.
/// The body the reader sees decodes as the API decodes it. Seeds and removes its own rows.
module CatalogReleases {
    let member = "atlas-member"
    fn id(name) = "md5('catalog-${name}')::uuid"
    fn digest(fill) = "'sha256:" + (repeat(fill, 64) ?: "") + "'"

    fn organization(name, slug, status) = "INSERT INTO registry.organizations (id,handle,display_name,state,governance_epoch,created_at) VALUES (${id(name)},'${slug}','${slug} org','${status}',1,now());"
    fn membership(name, org) = "INSERT INTO registry.memberships (id,organization_id,principal_id,role,principal_kind,state,authority_epoch,accepted_at) VALUES (${id(name)},${id(org)},${id("person")},'member','human','active',1,now());"
    fn package(name, org, member, status) = "INSERT INTO registry.packages (id,organization_id,name,admin_membership_id,admin_membership_state,admin_principal_kind,authority_epoch,state,created_at) VALUES (${id(name)},${id(org)},'${name}',${id(member)},'active','human',1,'${status}',now());"
    fn release(pkg, org, ordinal, fill, status, summary) = "INSERT INTO registry.releases (id,organization_id,package_id,epoch,ordinal,digest,publisher_principal_id,publisher_name,license_expression,summary,keywords,warnings,notices,state,published_at) VALUES (${id(pkg + ordinal)},${id(org)},${id(pkg)},1,${ordinal},${digest(fill)},${id("person")},'Atlas Engineering','MIT','${summary}','[\"networking\",\"web\"]','[\"Network access\"]','[{\"path\":\"NOTICE.md\",\"text\":\"Upstream\"}]','${status}',now());"

    fn seed() = join([
            "INSERT INTO registry.principals (id,kind,state,credential_epoch,created_at) VALUES (${id("person")},'human','active',1,now());",
            organization("atlas", "atlas", "active"), organization("gone", "gone", "tombstoned"),
            membership(member, "atlas"), membership("gone-member", "gone"),
            package("net", "atlas", member, "active"), package("render", "atlas", member, "active"),
            package("sketch", "atlas", member, "draft"), package("old", "gone", "gone-member", "active"),
            release("net", "atlas", "1", "a", "eligible", "HTTP tools"), release("net", "atlas", "2", "b", "eligible", "HTTP tools v2"),
            release("net", "atlas", "3", "c", "yanked", "Yanked tools"), release("render", "atlas", "1", "d", "revoked", "Revoked"),
            release("sketch", "atlas", "1", "e", "eligible", "Draft"), release("old", "gone", "1", "f", "eligible", "Gone")
        ], "\n")

    let unseed = "DELETE FROM registry.releases; DELETE FROM registry.packages; DELETE FROM registry.memberships; DELETE FROM registry.organizations; DELETE FROM registry.principals;"

    fn releasesOf(entry) = match PublicCatalog::field(entry, "releases") {
        JsonArray(items) => items
        _ => []
    }

    fn newest() = "sha256:" + (repeat("b", 64) ?: "")
    fn oldest() = "sha256:" + (repeat("a", 64) ?: "")

    fn releaseShape(releases) = length(releases) == 2
    && join(mapList(releases, fn(r) => toString(PublicCatalog::number(r, "ordinal")) + "|" + PublicCatalog::text(r, "digest")), ",") == "2|${newest()},1|${oldest()}"
    && match listGet(releases, 0) {
        Success { value } => PublicCatalog::text(value, "publisherId") == "484a9096-4c6e-dabe-7972-aa82759ac17d"
        && PublicCatalog::text(value, "publisherName") == "Atlas Engineering" && length(PublicCatalog::notices(value)) == 1
        Error => false
    }

    fn expected(entries) = length(entries) == 1 && match listGet(entries, 0) {
        Success { value } => PublicCatalog::text(value, "key") == "@atlas/net" && PublicCatalog::text(value, "summary") == "HTTP tools v2"
        && join(PublicCatalog::keywords(value), ",") == "networking,web" && releaseShape(releasesOf(value))
        Error => false
    }

    fn published(body) = match PublicCatalog::decode(body) {
        Success { value } => expected(value)
        Error => false
    }

    export fn check() = {
        let ready = CatalogWriter::applied()
        let seeded = CatalogWriter::sql(seed()).status == 0
        let refreshed = CatalogWriter::sql("SELECT registry.refresh_public_catalog()").status == 0
        let body = CatalogWriter::readerBody()
        let listed = published(body)
        let emptied = CatalogWriter::sql(unseed).status == 0 && CatalogWriter::sql("SELECT registry.refresh_public_catalog()").status == 0
        && CatalogWriter::readerBody() == "{\"packages\": []}"
        let clean = CatalogWriter::cleaned()
        checkAll("the refresher publishes eligible releases of active packages: " + body, [ready, seeded, refreshed, listed, emptied, clean])
    }
}
