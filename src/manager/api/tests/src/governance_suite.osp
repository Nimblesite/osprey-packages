namespace registry_api_tests;

module GovernanceSuite {
    /// Every governance suite in run order: each `run` registers its named cases.
    fn suites() = foldList([MembershipTests::run, IdentityTests::run, AdminTests::run, GrantTests::run, HandoverTests::run], 0, fn(count, run) => {
        run()
        count
    })
    export fn run() = suites()
}
