namespace registry_api_tests;
import registry_api::CatalogMemo

/// The in-process public catalog memo [PACKAGE-HOSTED-ROUTES-CATALOG] [PLAN-ROLLOUT-EDGE]: one
/// database read per refresh interval, never past the row's expires_at, a direct read when the
/// clock fails, and a malformed timed row is refused and never cached.
module MemoTests {
    let body = "{\"packages\":[]}"
    let dbFailed = "error:database.transaction-failed"
    fn row(expiry) = "${expiry} ${body}"

    fn bump(count) = {
        let n = recv(count)
        send(count, n + 1)
    }
    fn seen(count) = {
        let n = recv(count)
        send(count, n)
        n
    }
    fn answered(result) = match result {
        Success { value } => value
        Error { message } => "error:" + message
    }

    /// Run `body` with a fresh memo cell, a fetch counter and a settable clock.
    fn withMemo(rows, run) = match CatalogMemo::create() {
        Error { message } => check("memo cell", "", message)
        Success { value } => match Channel(1) {
            Error { message } => check("fetch counter", "", message)
            Success { value: count } => {
                send(count, 0)
                let memo = value
                let fetch = fn() => {
                    bump(count)
                    rows(seen(count))
                }
                run(fn(now) => answered(CatalogMemo::read(memo, fetch, fn() => Success { value: now })), fn() => seen(count),
                    fn() => answered(CatalogMemo::read(memo, fetch, fn() => Error { message: "host.clock-unavailable" })))
            }
        }
    }

    fn refreshInterval() = withMemo(fn(_n) => Success { value: row(5000) }, fn(at, fetches, _blind) => checkAll("one read per refresh interval", [
                at(1000) == body, fetches() == 1,
                at(1000) == body, at(1030) == body, at(1059) == body, fetches() == 1,
                at(1060) == body, fetches() == 2,
                at(1119) == body, fetches() == 2,
                at(999) == body, fetches() == 3
    ]))

    fn expiry() = withMemo(fn(n) => if n == 1 { Success { value: row(1010) } } else { Error { message: "database.transaction-failed" } },
        fn(at, fetches, _blind) => checkAll("never served past expires_at", [
                at(1000) == body, at(1009) == body, fetches() == 1,
                at(1010) == dbFailed, fetches() == 2,
                at(1011) == dbFailed, fetches() == 3
    ]))

    fn clockFailure() = withMemo(fn(_n) => Success { value: row(5000) }, fn(at, fetches, blind) => checkAll("a failed clock reads the database directly", [
                blind() == body, blind() == body, fetches() == 2,
                at(1000) == body, fetches() == 3, at(1001) == body, fetches() == 3,
                blind() == body, fetches() == 4
    ]))

    fn failureNotCached() = withMemo(fn(n) => if n == 1 { Error { message: "database.transaction-failed" } } else { Success { value: row(5000) } },
        fn(at, fetches, _blind) => checkAll("a failed read is not cached", [
                at(1000) == dbFailed, at(1000) == body, at(1001) == body, fetches() == 2
    ]))

    fn malformed() = {
        let rows = ["", "5000", "5000 ", " " + body, "abc " + body, "-5 " + body, "0 " + body, "5000x " + body, "50.5 " + body]
        let _checked = mapList(rows, fn(bad) => withMemo(fn(_n) => Success { value: bad }, fn(at, fetches, _blind) => checkAll("malformed timed row refused: " + bad, [
                        at(1000) == "error:catalog.invalid-projection", at(1000) == "error:catalog.invalid-projection", fetches() == 2
        ])))
        check("malformed timed rows checked", 9, length(rows))
    }

    fn bodyWithSpaces() = withMemo(fn(_n) => Success { value: "5000 {\"packages\": [ ]}" }, fn(at, fetches, _blind) => checkAll("only the first space splits", [
                at(1000) == "{\"packages\": [ ]}", at(1001) == "{\"packages\": [ ]}", fetches() == 1
    ]))

    export fn run() = {
        test("memo: one read per refresh interval", refreshInterval)
        test("memo: never past expires_at", expiry)
        test("memo: failed clock reads directly", clockFailure)
        test("memo: failed reads are not cached", failureNotCached)
        test("memo: malformed timed rows", malformed)
        test("memo: body keeps its spaces", bodyWithSpaces)
    }
}
