namespace registry_api_tests;
import registry_api::CatalogMemo

/// The in-process public catalog memo [PACKAGE-HOSTED-ROUTES-CATALOG] [PLAN-ROLLOUT-EDGE]: one
/// database read per refresh interval, never past the row's expires_at, a direct read when the
/// clock fails, and a malformed timed row is refused and never cached.
module MemoTests {
    let body = "{\"packages\":[]}"
    let dbFailed = "error:database.transaction-failed"
    fn row(expiry) = "${expiry} ${body}"

    fn bump(count) = {
        let n = recv(count)
        send(count, n + 1)
    }
    fn seen(count) = {
        let n = recv(count)
        send(count, n)
        n
    }
    fn answered(result) = match result {
        Success { value } => value
        Error { message } => "error:" + message
    }

    fn counter(run) = match Channel(1) {
        Error { message } => check("counter", "", message)
        Success { value } => {
            send(value, 0)
            run(value)
        }
    }

    fn tally(renewed, renew) = {
        bump(renewed)
        renew()
    }
    fn readAt(memo, fetch, renewed, renew: fn() -> Result<string, string>, clock) = CatalogMemo::read(memo, fetch, fn() => tally(renewed, renew), clock)

    /// Run `run` with a fresh memo cell, counted fetches and renewals, and a settable clock.
    fn withRenewal(rows, renew, run) = match CatalogMemo::create() {
        Error { message } => check("memo cell", "", message)
        Success { value } => counter(fn(count) => counter(fn(renewed) => {
            let memo = value
            let fetch = fn() => {
                bump(count)
                rows(seen(count))
            }
            run(fn(now) => answered(readAt(memo, fetch, renewed, renew, fn() => Success { value: now })), fn() => seen(count),
                fn() => answered(readAt(memo, fetch, renewed, renew, fn() => Error { message: "host.clock-unavailable" })), fn() => seen(renewed))
        }))
    }
    let refreshFailed = "error:database.refresh-failed"
    fn failedRenewal() = Error { message: "database.refresh-failed" }
    fn withMemo(rows, run) = withRenewal(rows, failedRenewal, fn(at, fetches, blind, _renewals) => run(at, fetches, blind))

    fn missingRow() = withRenewal(fn(n) => Success { value: if n == 1 { "" } else { row(5000) } }, fn() => Success { value: "" },
        fn(at, fetches, _blind, renewals) => checkAll("a missing row is refreshed, then read", [
            at(1000) == body, fetches() == 2, renewals() == 1, at(1001) == body, fetches() == 2, renewals() == 1
        ]))

    fn missingRowRefreshFails() = withRenewal(fn(_n) => Success { value: "" }, failedRenewal, fn(at, fetches, _blind, renewals) => checkAll("no row and no refresh fails closed", [
        at(1000) == refreshFailed, at(1000) == refreshFailed, fetches() == 2, renewals() == 2
    ]))

    fn renewal() = withRenewal(fn(n) => Success { value: if n == 1 { row(1300) } else { row(4600) } }, fn() => Success { value: "" },
        fn(at, fetches, _blind, renewals) => checkAll("a row within ten minutes of expiry is renewed", [
            at(1000) == body, fetches() == 2, renewals() == 1,
            at(1059) == body, at(1060) == body, fetches() == 3, renewals() == 1
        ]))

    fn renewalFailureKeepsRow() = withRenewal(fn(_n) => Success { value: row(1300) }, failedRenewal, fn(at, fetches, _blind, renewals) => checkAll("a failed renewal still serves the live row", [
        at(1000) == body, fetches() == 1, renewals() == 1, at(1030) == body, fetches() == 1, at(1300) == refreshFailed
    ]))

    fn refreshInterval() = withMemo(fn(_n) => Success { value: row(5000) }, fn(at, fetches, _blind) => checkAll("one read per refresh interval", [
                at(1000) == body, fetches() == 1,
                at(1000) == body, at(1030) == body, at(1059) == body, fetches() == 1,
                at(1060) == body, fetches() == 2,
                at(1119) == body, fetches() == 2,
                at(999) == body, fetches() == 3
    ]))

    fn expiry() = withMemo(fn(n) => if n == 1 { Success { value: row(1010) } } else { Error { message: "database.transaction-failed" } },
        fn(at, fetches, _blind) => checkAll("never served past expires_at", [
                at(1000) == body, at(1009) == body, fetches() == 1,
                at(1010) == dbFailed, fetches() == 2,
                at(1011) == dbFailed, fetches() == 3
    ]))

    fn clockFailure() = withMemo(fn(_n) => Success { value: row(5000) }, fn(at, fetches, blind) => checkAll("a failed clock reads the database directly", [
                blind() == body, blind() == body, fetches() == 2,
                at(1000) == body, fetches() == 3, at(1001) == body, fetches() == 3,
                blind() == body, fetches() == 4
    ]))

    fn failureNotCached() = withMemo(fn(n) => if n == 1 { Error { message: "database.transaction-failed" } } else { Success { value: row(5000) } },
        fn(at, fetches, _blind) => checkAll("a failed read is not cached", [
                at(1000) == dbFailed, at(1000) == body, at(1001) == body, fetches() == 2
    ]))

    fn malformed() = {
        let rows = ["5000", "5000 ", " " + body, "abc " + body, "-5 " + body, "0 " + body, "5000x " + body, "50.5 " + body]
        let _checked = mapList(rows, fn(bad) => withMemo(fn(_n) => Success { value: bad }, fn(at, fetches, _blind) => checkAll("malformed timed row refused: " + bad, [
                        at(1000) == "error:catalog.invalid-projection", at(1000) == "error:catalog.invalid-projection", fetches() == 2
        ])))
        check("malformed timed rows checked", 8, length(rows))
    }

    fn bodyWithSpaces() = withMemo(fn(_n) => Success { value: "5000 {\"packages\": [ ]}" }, fn(at, fetches, _blind) => checkAll("only the first space splits", [
                at(1000) == "{\"packages\": [ ]}", at(1001) == "{\"packages\": [ ]}", fetches() == 1
    ]))

    export fn run() = {
        test("memo: one read per refresh interval", refreshInterval)
        test("memo: never past expires_at", expiry)
        test("memo: failed clock reads directly", clockFailure)
        test("memo: failed reads are not cached", failureNotCached)
        test("memo: malformed timed rows", malformed)
        test("memo: body keeps its spaces", bodyWithSpaces)
        test("memo: missing row is refreshed", missingRow)
        test("memo: missing row, failed refresh", missingRowRefreshFails)
        test("memo: renewal near expiry", renewal)
        test("memo: failed renewal keeps the live row", renewalFailureKeepsRow)
    }
}
