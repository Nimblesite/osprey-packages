namespace registry_api_tests;
import registry_api::LoginKms
import registry_api::OAuth
import registry_api::HostedLogin
import registry_api::Supabase
import registry::Bytes
import registry::Kms

/// The Cloud KMS wire contract fails before exposing a verifier on transport or identity errors.
module KmsTests {
    let key = "projects/fixture/locations/global/keyRings/registry/cryptoKeys/login"
    let verifier = "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
    let aad = "test"
    let token = "{\"access_token\":\"fixture-token\",\"token_type\":\"Bearer\"}"
    let tokenHeader = "Authorization: Bearer fixture-token\r\nContent-Type: application/json"
    let clear = "ZEJqZnRKZVo0Q1ZQLW1COTJLMjd1aGJVSlUxcDFyX3dXMWdGV0ZPRWpYaw=="
    let encryptBody = "{\"additionalAuthenticatedData\":\"dGVzdA==\",\"plaintext\":\"${clear}\"}"
    let decryptBody = "{\"additionalAuthenticatedData\":\"dGVzdA==\",\"ciphertext\":\"YQ==\"}"

    fn kms(metadata, operation, payload, code, reply) = handler Supabase::Provider {
        request method base path headers body =>
        if Kms::isMetadataRequest(method, base, path, headers) {
            Success { value: Supabase::Reply { status: 200, body: metadata } }
        } else if method == "POST" && base == "https://cloudkms.googleapis.com" && path == "/v1/${key}:${operation}"
        && headers == tokenHeader && body == payload {
            Success { value: Supabase::Reply { status: code, body: reply } }
        } else { Error { message: "fixture.unexpected-kms-request" } }
    }

    fn seal(metadata, code, reply) = kms(metadata, "encrypt", encryptBody, code, reply)(fn() => LoginKms::seal(key, aad, verifier))

    fn unseal(code, encoded) = kms(token, "decrypt", decryptBody, code, "{\"plaintext\":\"${encoded}\"}")(
        fn() => LoginKms::unseal(key, aad, "YQ=="))

    let sealedReply = "{\"ciphertext\":\"YQ==\"}"

    fn sealCase(c) = (seal(c.metadata, c.status, c.reply) ?: "denied") == c.expected
    fn unsealCase(c) = (unseal(c.status, c.encoded) ?: "denied") == c.expected
    /// No case fails.
    fn allHold(cases, holds) = isEmpty(filterList(cases, fn(c) => !holds(c)))

    fn expectedResponses() = {
        let cases = [
            { metadata: token, status: 200, reply: sealedReply, expected: "YQ==" },
            { metadata: token, status: 302, reply: sealedReply, expected: "denied" },
            { metadata: token, status: 200, reply: "{\"ciphertext\":\"<bad>\"}", expected: "denied" },
            { metadata: "{\"access_token\":\"fixture-token\"}", status: 200, reply: sealedReply, expected: "denied" }
        ]
        checkAll("KMS sends padded base64 and accepts only ciphertext from a successful response", [
                allHold(cases, sealCase),
                !LoginKms::validKey(key + "/cryptoKeyVersions/1"),
                !LoginKms::validKey("projects/fixture/locations/global/keyRings/registry/cryptoKeys/../key")
        ])
    }

    fn alteredClear(from, to) = replace(clear, from, to) ?: ""

    /// The case of a successful reply whose verifier has `from` replaced by `to`: refused.
    fn altered(from, to) = { status: 200, encoded: alteredClear(from, to), expected: "denied" }

    fn expectedPlaintext() = {
        let cases = [
            { status: 200, encoded: clear, expected: verifier },
            { status: 403, encoded: clear, expected: "denied" },
            altered("aw==", "ax=="),
            altered("ZEJq", "////"),
            altered("==", "")
        ]
        checkAll("KMS accepts only a successful canonical encoded verifier", [allHold(cases, unsealCase)])
    }

    fn failStore(_flow: string, _browser: string, _sealed: string) -> Result<string, string> = Error { message: "fixture.storage-failed" }

    /// The fixture provider: this suite and `main.osp` share one definition.
    export fn oauthConfig(callback) = OAuth::Config {
        supabaseOrigin: "https://project.supabase.co",
        callback: callback,
        websiteOrigin: "https://packages.example.test",
        publishableKey: "sb_publishable_fixture"
    }

    fn oauth() = oauthConfig("https://api.example.test/v1/auth/github/callback")

    fn failedStart() = {
        let failure = "fixture.storage-failed"
        match HostedLogin::start(oauth(), fn(_aad, _verifier) => Success { value: "sealed" }, failStore) {
            Error { message } => check("login refuses the redirect when storage fails", failure, message)
            Success => check("login refuses the redirect when storage fails", true, false)
        }
    }

    let verified = Supabase::Session { accessToken: "access-fixture", refreshToken: "refresh-fixture", expiresIn: 600,
        identity: Supabase::Identity { authSubject: "11111111-1111-4111-8111-111111111111", githubId: "421" } }
    let receipt = "22222222-2222-4222-8222-222222222222"

    fn sessionSeal(aad, session) = if startsWith(aad, "registry.browser.session.tokens.v1\nhttps://project.supabase.co/auth/v1\nsha256:")
    && session.accessToken == verified.accessToken && session.refreshToken == verified.refreshToken {
        Success { value: "YQ==" }
    } else { Error { message: "fixture.invalid-context" } }

    fn sessionStore(digest, issuer, subject, github, envelope) =
    if startsWith(digest, "sha256:") && issuer == "https://project.supabase.co/auth/v1" && subject == verified.identity.authSubject
    && github == "421" && envelope == "YQ==" { Success { value: receipt } }
    else { Error { message: "fixture.invalid-storage" } }

    fn sessionResponse() = match HostedLogin::issue(oauth(), verified, sessionSeal, sessionStore) {
        Error { message } => check("approved sign-in creates an opaque browser session", "issued", message)
        Success { value } => {
            let cookie = Bytes::before(value.cookie, ";")
            let raw = drop(cookie, byteLength("__Host-registry="))
            checkAll("only a durable issuance can return a fixed redirect and an opaque cookie", [
                    value.location == "https://packages.example.test/release/",
                    startsWith(cookie, "__Host-registry=") && OAuth::challengeCode(raw) == "",
                    endsWith(value.cookie, "; Path=/; Max-Age=43200; Secure; HttpOnly; SameSite=Lax"),
                    !contains(value.cookie, "fixture") && !contains(value.cookie, receipt)
            ])
        }
    }

    fn issueError(seal, save) = match HostedLogin::issue(oauth(), verified, seal, save) {
        Error { message } => message
        Success => ""
    }

    fn issuanceFailures() = checkAll("token sealing and a committed approved session are required before setting a cookie", [
            issueError(sessionSeal, fn(_digest, _issuer, _subject, _github, _envelope) => Success { value: "" }) == HostedLogin::unapproved,
            issueError(sessionSeal, fn(_digest, _issuer, _subject, _github, _envelope) => Success { value: "invalid-receipt" }) == HostedLogin::sessionUnavailable,
            issueError(fn(_context, _session) => Error { message: "fixture.kms-offline" }, sessionStore) == "fixture.kms-offline"
    ])

    export fn run() = {
        test("auth: Cloud KMS verifier encryption", expectedResponses)
        test("auth: Cloud KMS verifier decryption", expectedPlaintext)
        test("auth: login redirect depends on durable storage", failedStart)
        test("auth: callback issues an opaque browser cookie", sessionResponse)
        test("auth: session issuance fails closed", issuanceFailures)
    }
}
