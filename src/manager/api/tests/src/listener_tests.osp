namespace registry_api_tests;
import registry_api::HostedService
import registry_api::HostedLogin
import registry_host::Host

/// Drive both real listeners and check their distinct public contracts [PACKAGE-HOSTED-TOPOLOGY].
module ListenerTests {
    let unavailableReply = "503|no-store|"
    let forbidden = "403|no-store|"
    let v1Packages = "/v1/packages"
    let publicCache = "public, max-age=60, s-maxage=300, stale-while-revalidate=600"
    let jsonReply = "200|" + publicCache + "|application/json|"
    let problemReply = "404|no-store|application/problem+json|"

    let valid = "{\"apiHost\":\"api.example.test\",\"websiteOrigin\":\"https://packages.example.test\",\"edgeSecret\":\"test-only-secret-with-at-least-32-bytes\"}"

    let oldSecret = "retiring-test-secret-with-at-least-32-bytes"

    fn withOverlap(config, overlap) = take(config, byteLength(config) - 1) + ",\"edgeSecretOverlap\":" + overlap + "}"
    fn overlap(secret, deadline) = "{\"secret\":${secret},\"expiresAtUnixSeconds\":${deadline}}"

    fn fetch(port, path, extra) = match httpCreateClient("http://127.0.0.1:${port}", 2000) {
        Error { message } => message
        Success { value } => {
            let client = value
            let observed = match httpGetResponse(client, path, extra) {
                Error { message } => message
                Success { value } => {
                    let data = "${httpResponseStatus(value)}|${httpResponseHeader(value, "cache-control") ?: ""}|${httpResponseHeader(value, "content-type") ?: ""}|${httpResponseHeader(value, "access-control-allow-origin") ?: ""}|${httpResponseBody(value) ?: ""}"
                    let _released = httpResponseFree(value)
                    data
                }
            }
            let _closed = httpCloseClient(client)
            observed
        }
    }

    /// The reply `path` serves behind `extra` starts with `prefix`.
    fn serving(port, path, extra, prefix) = startsWith(fetch(port, path, extra), prefix)

    /// `path` serves a `status` problem naming `code` behind `extra`.
    fn problem(port, path, extra, status, code) = {
        let reply = fetch(port, path, extra)
        startsWith(reply, "${status}|no-store|application/problem+json||") && contains(reply, code)
    }

    fn sessions(port, edge) = {
        let path = "/v1/auth/session"
        let browser = edge + "\r\nOrigin: https://packages.example.test"
        let cookie = "\r\nCookie: __Host-registry=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
        let signedOut = "401|no-store|application/problem+json|https://packages.example.test|{\"code\":\"auth.session-required\",\"status\":401}"
        let signedOutWith = fn(extra) => fetch(port, path, browser + extra) == signedOut
        checkAll("browser session absence versus unavailable verification", [
                signedOutWith(""),
                signedOutWith("\r\nCookie: theme=light"),
                signedOutWith("\r\nCookie: __Host-registry=opaque"),
                serving(port, path, browser + cookie, unavailableReply),
                serving(port, path, edge + cookie, forbidden),
                startsWith(fetch(port, path, browser + "\r\nAuthorization: Bearer opaque"), unavailableReply),
                startsWith(fetch(port, path, ""), forbidden)
        ])
    }

    let projection = "{\"packages\":[{\"key\":\"@atlas/net\",\"keywords\":[\"networking\",\"web\"],\"releases\":[{\"digest\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"epoch\":1,\"licenseExpression\":\"MIT\",\"notices\":[{\"path\":\"NOTICE.md\",\"text\":\"Adapted from Atlas upstream.\\nCopyright Atlas.\"}],\"ordinal\":1,\"publisherId\":\"11111111-1111-4111-8111-111111111111\",\"publisherName\":\"Atlas Engineering\"}],\"summary\":\"HTTP tools\",\"warnings\":[\"Network access\"]}]}"

    fn fetchEtag(port, path, extra) = match httpCreateClient("http://127.0.0.1:${port}", 2000) {
        Error => ""
        Success { value } => {
            let client = value
            let etag = match httpGetResponse(client, path, extra) {
                Error => ""
                Success { value } => {
                    let tag = httpResponseHeader(value, "etag") ?: ""
                    let _released = httpResponseFree(value)
                    tag
                }
            }
            let _closed = httpCloseClient(client)
            etag
        }
    }

    fn requests(port) = {
        let probe = fetch(port + 1, "/v1/ready", "")
        let private = fetch(port + 1, v1Packages, "")
        let edge = "X-Edge-Host: 127.0.0.1\r\nX-Edge-Secret: test-only-secret-with-at-least-32-bytes"
        sessions(port, edge)
        ReviewHttpTests::exercise(port, edge)
        let admitted = fetch(port, v1Packages, edge)
        let crossOrigin = fetch(port, v1Packages, edge + "\r\nOrigin: https://packages.example.test")
        let etag = fetchEtag(port, v1Packages, edge)
        let notModified = fetch(port, v1Packages, edge + "\r\nIf-None-Match: " + etag)
        let bearerCatalog = fetch(port, v1Packages, edge + "\r\nAuthorization: Bearer opaque")
        checkAll("live registry probe and ingress isolation", [
                serving(port, "/v1/packages/@atlas/net", edge, jsonReply) && contains(fetch(port, "/v1/packages/@atlas/net", edge), "Network access"),
                serving(port, "/v1/packages/@atlas/missing", edge, problemReply),
                serving(port, "/v1/publishers/11111111-1111-4111-8111-111111111111", edge, jsonReply),
                serving(port, "/v1/publishers/11111111-1111-4111-8111-111111111111/releases", edge, jsonReply),
                serving(port, "/v1/publishers/99999999-9999-4999-8999-999999999999", edge, problemReply),
                serving(port, "/v1/releases/sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/source", edge, problemReply),
                serving(port, HostedLogin::startPath, edge, unavailableReply),
                serving(port, HostedLogin::startPath, "", forbidden),
                probe == "200|no-store|text/plain||", private == "404|no-store|text/plain||",
                problem(port, v1Packages, "", 403, "req.edge-secret"),
                admitted == jsonReply + "|" + projection,
                crossOrigin == jsonReply + "https://packages.example.test|" + projection,
                startsWith(etag, "\"sha256:") && endsWith(etag, "\""),
                startsWith(notModified, "304|" + publicCache + "|"),
                startsWith(bearerCatalog, "200|no-store|application/json|"),
                problem(port, "/v1/ready", edge, 404, "api.not-found")
        ])
        Success { value: 0 }
    }

    fn live(source, exercise) = {
        let port = 20000 + random() % 15000
        let outcome = andThen(HostedService::config(source), fn(policy) => HostedService::withListeners(
                policy { allowedHost: "127.0.0.1" }, "content.example.test", "127.0.0.1", port, port + 1, fn() => Success { value: projection }, fn(_digest) => Error { message: "missing" }, HostedLogin::unavailable, fn(_path, _headers) => HostedLogin::unavailable(), fn(_method, _token) => HostedLogin::unavailable(), ReviewHttpTests::decide, fn() => exercise(port)))
        match outcome {
            Error { message } => check("two listeners start", "ready", message)
            Success { value } => check("listeners finish the request sequence", 0, value)
        }
    }

    fn refused(source) = match HostedService::config(source) {
        Error { message } => message == "hosted.config-invalid"
        Success => false
    }

    fn invalidConfig() = checkAll("invalid hosted config stops startup", [
            refused("{}"), refused("broken"), refused(replace(valid, "https://", "http://") ?: valid),
            refused(replace(valid, "test-only-secret-with-at-least-32-bytes", "") ?: valid),
            refused(replace(valid, "api.example.test", "packages.example.test") ?: valid)
    ])
    fn clock(seconds, status) = handler Host::Process {
        run command => Host::Run { status: if command == "date -u +%s" { status } else { 1 }, stdout: toString(seconds), stderr: "" }
    }

    fn overlapRequests(port, accepted) = {
        let host = "X-Edge-Host: 127.0.0.1\r\n"
        let edge = host + "X-Edge-Secret: ${oldSecret}"
        let current = host + "X-Edge-Secret: test-only-secret-with-at-least-32-bytes"
        checkAll("retiring edge secret uses the live bounded clock", [
                startsWith(fetch(port, v1Packages, edge), if accepted { jsonReply } else { forbidden }),
                startsWith(fetch(port, v1Packages, current), jsonReply),
                startsWith(fetch(port, v1Packages, "X-Edge-Secret: missing"), forbidden),
                startsWith(fetch(port, v1Packages, current + "\r\nX-Edge-Secret: ${oldSecret}"), "400|no-store|")
        ])
        Success { value: 0 }
    }

    fn quoted(text) = "\"${text}\""
    fn rotationAt(seconds, status, accepted) = clock(seconds, status)(fn() =>
        live(withOverlap(valid, overlap(quoted(oldSecret), "2000")), fn(port) => overlapRequests(port, accepted)))

    fn rotating() = {
        rotationAt(1099, 0, false)
        rotationAt(1100, 0, true)
        rotationAt(1999, 0, true)
        rotationAt(2000, 0, false)
        rotationAt(1999, 1, false)
    }

    /// Whether startup refuses an overlap retiring `secret` until `deadline`.
    fn refusesOverlap(secret, deadline) = refused(withOverlap(valid, overlap(quoted(secret), deadline)))

    fn invalidOverlap() = checkAll("malformed edge overlap prevents startup", [
            refused(withOverlap(valid, "null")),
            refused(withOverlap(valid, "{}")),
            refusesOverlap("short", "2000"),
            refusesOverlap("test-only-secret-with-at-least-32-bytes", "2000"),
            refusesOverlap(oldSecret, quoted("2000")),
            refusesOverlap(oldSecret, "900")
    ])

    export fn run() = {
        test("hosted configuration", invalidConfig)
        test("hosted API live listeners", fn() => live(valid, requests))
        test("hosted API edge rotation", rotating)
        test("hosted configuration edge overlap", invalidOverlap)
    }
}
