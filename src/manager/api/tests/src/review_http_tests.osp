namespace registry_api_tests;
import registry_api::HostedLogin
import registry_api::HostedReview

module ReviewHttpTests {
    let token = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    let submission = "11111111-1111-4111-8111-111111111111"
    let digest = "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

    export fn decide(cookie, id, pinned) = if cookie == token && id == submission && pinned == digest {
        Success { value: id }
    } else { Error { message: HostedReview::denied } }

    export fn receipt(cookie, id) = if cookie == token && id == submission { Success { value: "{}" } }
    else { Error { message: HostedReview::missing } }

    fn status(client, path, headers, body) = match httpPostResponse(client, path, body, headers) {
        Error => -1
        Success { value } => {
            let result = httpResponseStatus(value)
            let _released = httpResponseFree(value)
            result
        }
    }

    export fn exercise(port, edge) = match httpCreateClient("http://127.0.0.1:${port}", 5000) {
        Error { message } => check("review listener", "ready", message)
        Success { value } => {
            let path = HostedReview::prefix + submission + "/" + digest + "/approve"
            let origin = edge + "\r\nOrigin: https://packages.example.test"
            let cookie = origin + "\r\nCookie: __Host-registry=" + token
            let auth = cookie + "\r\nX-Csrf-Token: " + HostedLogin::csrfToken(token)
            checkAll("review POST requires the browser, origin, CSRF token and digest", [
                    status(value, path, origin, "") == 401, status(value, path, cookie, "") == 403,
                    status(value, path, auth, "data") == 400, status(value, path, auth, "") == 204,
                    status(value, replace(path, digest, "latest") ?: "", auth, "") == 400,
                    status(value, replace(path, digest, "sha256:" + (repeat("c", 64) ?: "")) ?: "", auth, "") == 403
            ])
            ListenerTests::receiptChecks(port, edge, cookie, submission)
            let _closed = httpCloseClient(value)
        }
    }
}
