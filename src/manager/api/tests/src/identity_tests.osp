namespace registry_api_tests;
import registry::Governance
import registry::GovernanceTransitions
import registry::Names

/// Org-bound package identity [PACKAGE-NAMES-NO-SITTING] and
/// [PACKAGE-OWNERSHIP-MODEL]: the leaf name is never a global resource, the
/// scope is the owning organization's handle, and `(organization, name)` is
/// the only uniqueness key — tombstones included.
module IdentityTests {
    let governancePackageDuplicateName = "governance.package.duplicate-name"

    /// The refusal of a package name no release occupies.
    let nameMissingAt = "name.missing-at"
    fn key(scope, name) = Names::Key { scope: scope, name: name }

    /// `org`'s custodian `custodian` (principal `p-<custodian>` on membership
    /// `m-<custodian>`) creates package `id` at key `k`, administered by
    /// `admin` whose proof `adminPrincipal` signs.
    fn create(world, org, custodian, k, id, admin, adminPrincipal) = {
        let statement = Governance::creationStatement(id, k, admin)
        GovernanceTransitions::createPackage(world, org, k, id, admin,
            Fixture::verified("p-${custodian}", "m-${custodian}", statement),
            Fixture::verified(adminPrincipal, admin, statement))
    }

    /// The reason code of that creation: "" once the package exists.
    fn createCode(world, org, custodian, k, id, admin, adminPrincipal) =
        Fixture::code(create(world, org, custodian, k, id, admin, adminPrincipal))

    /// The reason code of finch's custodian creating `k`'s package `id`, administered by bob.
    fn finchCode(world, k, id) = createCode(world, "o-finch", "alice", k, id, "m-bob", "p-bob")

    /// The reason code of wren's custodian creating `k`'s package `id`, administered by `admin` as `adminPrincipal` signs.
    fn wrenCode(world, k, id, admin, adminPrincipal) = createCode(world, "o-wren", "dave", k, id, admin, adminPrincipal)

    /// One leaf, two organizations, no interaction between them. The second
    /// organization's admin must be a human member: [PACKAGE-OWNERSHIP-ADMIN]
    /// constrains `admin_principal_kind` to `human` and requires that "Null
    /// admins, workflow admins, administrators from another org" fail, so the
    /// workflow principal m-ci can never hold the seat.
    fn sameLeafTwoOrganizations() = {
        let world = Fixture::world()
        let finchToolkitKey = key("finch", "toolkit")
        let wrenToolkitKey = key("wren", "toolkit")
        let finchToolkit = Fixture::orKeep(world, fn(w) => create(w, "o-finch", "alice", finchToolkitKey, "pkg-f2", "m-bob", "p-bob"))
        let bothToolkit = Fixture::orKeep(finchToolkit, fn(w) => create(w, "o-wren", "dave", wrenToolkitKey, "pkg-w2", "m-dave", "p-dave"))
        checkAll("the same leaf name serves two organizations independently", [
            finchCode(world, finchToolkitKey, "pkg-f2") == "",
            finchCode(world, key("finch", "ledger"), "pkg-f9") == governancePackageDuplicateName,
            wrenCode(finchToolkit, wrenToolkitKey, "pkg-w2", "m-dave", "p-dave") == "",
            wrenCode(world, key("wren", "ledger"), "pkg-w9", "m-dave", "p-dave") == governancePackageDuplicateName,
            // A workflow principal is refused the seat, so it never creates a package.
            wrenCode(world, wrenToolkitKey, "pkg-w2", "m-ci", "p-ci") == "governance.principal.workflow",
            Names::same(finchToolkitKey, wrenToolkitKey) == false,
            Names::compare(finchToolkitKey, wrenToolkitKey) != 0,
            length(bothToolkit.packages) == 4
        ])
    }

    /// The reason code of finch's custodian creating the package `name` under
    /// `scope`, administered by bob in a fresh world.
    fn keyProblem(scope, name) = finchCode(Fixture::world(), key(scope, name), "pkg-x")

    /// The scope is the owning organization's immutable handle, and the
    /// components keep the canonical grammar; unscoped and global spellings
    /// have no creation path at all.
    fn orgBoundKeys() = checkAll("a package key is bound to its organization's handle", [
        structuralEquals([keyProblem("wren", "ledger"), keyProblem("Finch", "toolkit"), keyProblem("finch", "Toolkit"), keyProblem("finch", "")],
            ["governance.package.org-handle-mismatch", "name.scope.chars", "name.name.chars", "name.name.length"]),
        Fixture::code(Names::parse("ledger")) == nameMissingAt,
        Fixture::code(Names::parse("finch/ledger")) == nameMissingAt,
        Fixture::code(Names::parse("HelperFunctions")) == nameMissingAt
    ])

    /// `wren`'s custodian tombstones `ledger`, the package `pkg-w1`: the transition's result.
    fn tombstone(world, statement) =
        GovernanceTransitions::tombstone(world, "pkg-w1", Fixture::verified("p-dave", "m-dave", statement))

    /// A tombstone keeps occupying its organization's key forever.
    fn tombstonedKeysStayTaken() = {
        let world = Fixture::world()
        let statement = Governance::tombstoneStatement(Names::Key { scope: "wren", name: "ledger" }, 1)
        let tombstoned = Fixture::orKeep(world, fn(w) => tombstone(w, statement))
        checkAll("tombstoned packages never free their key", [
            Fixture::code(tombstone(world, statement)) == "",
            wrenCode(tombstoned, key("wren", "ledger"), "pkg-w3", "m-ci", "p-ci") == governancePackageDuplicateName,
            finchCode(tombstoned, key("finch", "ledger"), "pkg-f3") == governancePackageDuplicateName,
            finchCode(tombstoned, key("finch", "ledger2"), "pkg-f4") == ""
        ])
    }

    /// The identity suite: one leaf name under two organizations,
    /// organization-bound keys, and tombstones keeping their key.
    export fn run() = {
        test("governance identity: one leaf serves two organizations", sameLeafTwoOrganizations)
        test("governance identity: keys are organization-bound", orgBoundKeys)
        test("governance identity: tombstones keep their key", tombstonedKeysStayTaken)
    }
}
