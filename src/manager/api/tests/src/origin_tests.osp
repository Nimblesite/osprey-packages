namespace registry_api_tests;
import registry_api::HostedOrigin
import registry_api::HostedHeaders

/// Origin validation for credentialed mutations and CSRF token checks.
/// Implements [PACKAGE-HOSTED-EDGE] credentialed browser request rules.
module OriginTests {
    let site = "https://packages.example.test"
    /// The located rejection of an origin other than the site's own.
    let originMismatch = "req.origin-mismatch"

    fn outcome(result) = if HostedHeaders::isOk(result) { "" } else { HostedHeaders::codeOf(result) }

    fn origins() = {
        let codeOf = fn(origin, method) => outcome(HostedOrigin::check(origin, site, method))
        checkAll("origin: exact site origin only", [
            codeOf("${site}", "POST") == "",
            codeOf("HTTPS://PACKAGES.EXAMPLE.TEST", "POST") == "",
            codeOf("${site}/", "POST") == originMismatch,
            codeOf("https://evil.test", "POST") == originMismatch,
            codeOf("", "POST") == "req.origin-required",
            codeOf("", "GET") == "",
            codeOf("https://evil.test", "GET") == originMismatch
        ])
    }

    fn tokens() = checkAll("csrf: token equality on mutations", [
        outcome(HostedOrigin::csrf("tok", "tok")) == "",
        outcome(HostedOrigin::csrf("tok", "other")) == "req.csrf-mismatch",
        outcome(HostedOrigin::csrf("", "tok")) == "req.csrf-missing",
        outcome(HostedOrigin::csrf("tok", "")) == "req.csrf-unconfigured"
    ])

    /// Site-origin validation for credentialed mutations, and CSRF token checks.
    export fn run() = {
        test("hosted origin: site origin", origins)
        test("hosted origin: csrf tokens", tokens)
    }
}
