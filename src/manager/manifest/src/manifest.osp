namespace registry;

/// `osprey.toml` to the canonical manifest, or one located reason code.
/// Parsing, every section rule and the cross-table rules run here; nothing
/// is parsed by the compiler's Rust project loader on this path.
/// Implements [PACKAGE-MANIFEST].
module Manifest {
    /// One located rejection: its stable reason code and the 1-based line and
    /// column where the problem starts.
    export type Problem = { code: string, line: int, column: int }
    /// The outcome of parsing one manifest text: the canonical manifest, or
    /// the first problem found.
    export type Verdict = Accepted { manifest: ManifestModel::Manifest } | Rejected { problem: Problem }

    let encodedSeparator = " at "
    let positionSeparator = ":"
    let topLevelKeys = ["project", "modules", "package", "dependencies", "build-dependencies", "test-dependencies", "system", "assets", "discipline", "lints"]

    /// The integer after (`part` is "after") or before the first `separator`, else `fallback`.
    fn numberAround(text, separator, part, fallback) = match indexOf(text, separator) {
        Success { value } => parseInt(if part == "after" { drop(text, value + 1) } else { take(text, value) }) ?: fallback
        Error => fallback
    }

    /// Decode `code at line:column`; a message without a position is at 1:1.
    export fn problemOf(message) = match indexOf(message, encodedSeparator) {
        Error => Problem { code: message, line: 1, column: 1 }
        Success { value } => {
            let position = drop(message, value + byteLength(encodedSeparator))
            Problem { code: take(message, value), line: numberAround(position, positionSeparator, "before", 1), column: numberAround(position, positionSeparator, "after", 1) }
        }
    }

    /// `code at line:column`.
    export fn describe(problem) = Toml::describe(problem)

    /// The dependency edges and the root's grants, parsed from the same tables.
    type Edges = { edges: List<ManifestModel::Edge>, grants: List<ManifestModel::Grant> }

    fn assemble(project: ManifestSections::Project, wildcard, publication, deps: Edges, systems, assets) = ManifestModel::Manifest {
        projectName: project.name,
        sourceRoots: project.sourceRoots,
        defaultNamespace: project.defaultNamespace,
        entry: project.entry,
        flavor: project.flavor,
        allowWildcardImports: wildcard,
        publication: publication,
        testRoots: project.testRoots,
        pythonSources: project.pythonSources,
        typescriptSources: project.typescriptSources,
        dependencies: deps.edges,
        grants: deps.grants,
        systemRequirements: systems,
        assets: assets
    }

    fn rejected(message) = Rejected { problem: problemOf(message) }

    /// A published manifest keeps every `python_sources` and
    /// `typescript_sources` entry inside one of its `source_roots` so the
    /// capability scan covers it ([PACKAGE-MANIFEST]).
    fn rooted(entry, roots) = foldList(roots, false, fn(found, root) => found || startsWith(entry, root + "/"))

    fn anyUnrooted(sources, roots) = foldList(sources, false, fn(found, entry) => found || !rooted(entry, roots))

    // The refusal for a flavor source outside `source_roots`, or "" for none.
    fn unrootedCode(project: ManifestSections::Project) = if anyUnrooted(project.pythonSources, project.sourceRoots) { "manifest.python-source-unrooted" }
        else if anyUnrooted(project.typescriptSources, project.sourceRoots) { "manifest.typescript-source-unrooted" }
        else { "" }

    fn projectLine(root) = ManifestSections::spanOf(ManifestSections::pairsOf(root), "project", ManifestSections::rootSpan()).line

    fn publishable(project, publication, root) = if Maybe::isPresent(publication) && unrootedCode(project) != "" {
        Error { message: "${unrootedCode(project)} at ${projectLine(root)}:1" }
    } else { withDependencies(project, publication, root) }

    fn withDependencies(project, publication, root) = andThen(ManifestDeps::dependencies(root), fn(value) => withGrants(project, publication, root, value))

    fn withGrants(project, publication, root, edges) = andThen(ManifestDeps::grants(root), fn(value) => withSystems(project, publication, root, Edges { edges: edges, grants: value }))

    fn withSystems(project, publication, root, dependencies) = andThen(ManifestDeps::systems(root), fn(value) => withAssets(project, publication, root, dependencies, value))

    fn withAssets(project, publication, root, dependencies, systems) = andThen(ManifestDeps::assets(root), fn(value) => withModules(project, publication, root, dependencies, systems, value))

    fn withModules(project, publication, root, dependencies, systems, assets) = andThen(ManifestSections::modules(root), fn(value) => Success { value: assemble(project, value, publication, dependencies, systems, assets) })

    fn withPublication(project, root) = andThen(ManifestSections::publication(root), fn(value) => publishable(project, value, root))

    fn checkedProject(root) = andThen(ManifestSections::unknownKeys(ManifestSections::pairsOf(root), topLevelKeys, "manifest.unknown-table"), fn(_) =>
        andThen(ManifestSections::discipline(root), fn(_) => andThen(ManifestSections::lints(root), fn(_) => ManifestSections::project(root))))

    fn fromTable(root) = match andThen(checkedProject(root), fn(project) => withPublication(project, root)) {
        Error { message } => rejected(message)
        Success { value } => Accepted { manifest: value }
    }

    /// The verdict for one manifest text.
    export fn parse(text) = match Toml::parse(text) {
        Error { message } => rejected(message)
        Success { value } => fromTable(value)
    }

    /// The manifest of an accepted verdict, for callers that already checked.
    export fn accepted(verdict) = match verdict {
        Accepted { manifest } => Success { value: manifest }
        Rejected { problem } => Error { message: describe(problem) }
    }
}
