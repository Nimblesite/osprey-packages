namespace registry;

/// Character-level scanning for the TOML subset Osprey manifests use: a byte
/// cursor with 1-based byte line/column, whitespace/comment trivia, bare-token
/// scanning and single-line string decoding with escape expansion. This module
/// knows nothing about the document structure; it only moves over bytes.
/// Failures are `code at line:column` strings, never prose.
/// Implements the lexical half of [PACKAGE-MANIFEST].
module TomlLexer {
    let tomlUnterminatedString = "toml.unterminated-string"
    let tomlBadEscape = "toml.bad-escape"

    /// A scan position: the whole text, the 0-based byte offset, and the
    /// 1-based line and column of that byte.
    export type Cursor = { text: string, at: int, line: int, column: int }
    /// One scanned bare token and the cursor just past it.
    export type Scan = { token: string, at: Cursor }
    /// One decoded string and the cursor just past its closing quote.
    export type Text = { text: string, at: Cursor }
    type Walk = { at: Cursor, text: string, finished: bool, reason: string }

    let space = 32
    let tab = 9
    let cr = 13
    let newline = 10
    let quote = 34
    let apostrophe = 39
    let backslash = 92
    let hash = 35
    let comma = 44
    let eq = 61
    let rbracket = 93
    let rbrace = 125
    let nonAsciiFloor = 128
    let del = 127

    fn failStr(code, c) = "${code} at ${c.line}:${c.column}"

    /// The cursor at the first byte of `text`, line 1, column 1.
    export fn start(text) = Cursor { text: text, at: 0, line: 1, column: 1 }

    /// True once the cursor has passed the last byte.
    export fn eof(c) = c.at >= byteLength(c.text)

    /// The byte under the cursor, or -1 past the end.
    export fn cur(c) = byteAt(c.text, c.at) ?: -1

    /// The byte `n` positions ahead of the cursor, or -1 past the end.
    export fn peek(c, n) = byteAt(c.text, c.at + n) ?: -1

    /// Advance one byte within the current line.
    export fn advance(c) = movedTo(c, c.at + 1)

    fn movedTo(c, offset) = Cursor { text: c.text, at: offset, line: c.line, column: c.column + (offset - c.at) }

    /// Advance past one newline byte onto the next line.
    export fn breakLine(c) = Cursor { text: c.text, at: c.at + 1, line: c.line + 1, column: 1 }

    fn isSpaceByte(b) = b == space || b == tab || b == cr

    /// Skip horizontal whitespace (space, tab, carriage return).
    export fn skipSpaces(c) = scannedRun(c, isSpaceByte)

    fn commentEnd(c) = scannedRun(c, fn(b) => b != newline)

    fn scannedRun(c, keep) = walkedFrom(c, fn(s) => runStep(s, keep)).at
    fn runStep(s, keep) = runAt(s, Bytes::runEnd(s.at.text, s.at.at, keep))
    /// A run of zero length finishes the walk; a longer one continues after it.
    fn runAt(s, offset) = match offset == s.at.at {
        true => done(movedTo(s.at, offset), "")
        false => continuing(movedTo(s.at, offset), "")
    }

    /// Skip whitespace, `#` comments and whole newlines; the cursor lands on
    /// the first significant byte or at EOF.
    export fn skipTrivia(c) = walkedFrom(c, triviaStep).at
    /// A comment runs to the end of its line, a newline opens the next one, and
    /// any other byte ends the trivia.
    fn triviaStep(s) = {
        let c1 = skipSpaces(s.at)
        if cur(c1) == hash { continuing(commentEnd(c1), "") }
        else if cur(c1) == newline { continuing(breakLine(c1), "") }
        else { done(c1, "") }
    }

    /// After a value or header: whitespace and one `#` comment are allowed;
    /// the cursor is left at the newline or EOF. Anything else is a reason.
    export fn skipLineTail(c) = skipLineTailUpTo(skipSpaces(c))
    fn skipLineTailUpTo(c) = match cur(c) == hash {
        true => Success { value: commentEnd(c) }
        false => match cur(c) == newline || eof(c) {
            true => Success { value: c }
            false => match cur(c) >= nonAsciiFloor {
                true => Error { message: failStr("toml.non-ascii", c) }
                false => Error { message: failStr("toml.trailing-text", c) }
            }
        }
    }

    /// The byte under the cursor as a one-byte string, or "" past the end.
    export fn oneByte(c) = substring(c.text, c.at, c.at + 1) ?: ""

    fn bareTerm(b) = isSpaceByte(b) || b == newline || b == comma || b == rbracket || b == rbrace || b == hash || b == eq || b == -1

    /// The bare token up to the next value terminator; a non-ASCII byte fails.
    export fn scanBare(c) = bareAt(c, scannedRun(c, fn(b) => !bareTerm(b) && b < nonAsciiFloor))
    fn bareAt(start, end) = if cur(end) >= nonAsciiFloor { Error { message: failStr("toml.non-ascii", end) } }
    else { Success { value: Scan { token: substring(start.text, start.at, end.at) ?: "", at: end } } }

    fn controlByte(b) = (b < 32 && b != tab) || b == del

    /// A basic `"..."` string from its opening quote, escapes decoded. Control
    /// bytes other than tab, newlines and the end of input are rejected.
    export fn basicString(c) = quotedString(c, quote, true)

    /// The three walk states: still walking with `text` so far, finished with
    /// it, or stopped with `text` and a `reason`.
    fn continuing(at, text) = Walk { at: at, text: text, finished: false, reason: "" }
    fn done(at, text) = Walk { at: at, text: text, finished: true, reason: "" }
    fn stopped(at, text, reason) = Walk { at: at, text: text, finished: true, reason: reason }

    fn stringFault(s, code, at) = stopped(s.at, s.text, failStr(code, at))
    fn decoded(c, text) = Success { value: Text { text: text, at: c } }

    fn quotedString(c, delimiter, basic) = {
        let result = walkedFrom(advance(c), fn(s) => stringStep(s, c, delimiter, basic))
        if result.reason != "" { Error { message: result.reason } }
        else { decoded(result.at, result.text) }
    }

    // Split the byte budget so stack depth is logarithmic without requiring tail calls.
    fn walkedFrom(c, step) = walkBlock(continuing(c, ""), byteLength(c.text) - c.at + 1, step)

    fn walkBlock(s, budget, step) -> Walk = if s.finished { s }
    else if budget <= 1 { step(s) }
    else { walkSplit(s, budget, step, intDiv(budget, 2)) }

    fn walkSplit(s, budget, step, leftBudget) = walkBlock(walkBlock(s, leftBudget, step), budget - leftBudget, step)

    fn stringStep(s, start, delimiter, basic) = if eof(s.at) { stringFault(s, tomlUnterminatedString, start) }
    else if cur(s.at) == delimiter { done(advance(s.at), s.text) }
    else if basic && cur(s.at) == backslash { escapedStep(s, start) }
    else if cur(s.at) == newline { stringFault(s, tomlUnterminatedString, start) }
    else if controlByte(cur(s.at)) { stringFault(s, "toml.control-character", s.at) }
    else { continuing(advance(s.at), s.text + oneByte(s.at)) }

    fn escapedStep(s, start) = match basicEscape(advance(s.at), s.text, start) {
        Error { message } => stopped(s.at, s.text, message)
        Success { value } => continuing(value.at, value.text)
    }

    fn basicEscape(c, acc, start) = match eof(c) {
        true => Error { message: failStr(tomlUnterminatedString, start) }
        false => escapeByte(cur(c), c, acc, start)
    }

    /// The text of the one-character escape `b` names, or "" when it names none.
    fn shortEscape(b) = {
        let escapes = [
            { code: quote, text: "\"" }, { code: backslash, text: "\\" }, { code: 98, text: fromCodePoint(8) ?: "" },
            { code: 116, text: "\t" }, { code: 110, text: "\n" }, { code: 102, text: fromCodePoint(12) ?: "" }, { code: 114, text: "\r" }
        ]
        match listGet(filterList(escapes, fn(e) => e.code == b), 0) {
            Success { value } => value.text
            Error => ""
        }
    }

    /// `b` is the byte after the backslash: `u` and `U` open a Unicode escape, a
    /// listed byte yields its text, and anything else is a bad escape.
    fn escapeByte(b, c, acc, start) = match b {
        117 => unicodeEscape(advance(c), acc, start, 4)
        85 => unicodeEscape(advance(c), acc, start, 8)
        _ => match shortEscape(b) {
            "" => Error { message: failStr(tomlBadEscape, c) }
            text => decoded(advance(c), acc + text)
        }
    }

    fn readHex(c, n, acc) = match n == 0 {
        true => Success { value: acc }
        false => match eof(c) {
            true => Error { message: failStr(tomlBadEscape, c) }
            false => {
                let d = Bytes::hexValue(cur(c))
                match d == -1 {
                    true => Error { message: failStr(tomlBadEscape, c) }
                    false => readHex(advance(c), n - 1, acc * 16 + d)
                }
            }
        }
    }

    fn unicodeEscape(c, acc, start, n) = andThen(readHex(c, n, 0), fn(value) => unicodeEscapeChar(c, n, acc, start, value))

    fn unicodeEscapeChar(c, n, acc, start, cp) = match fromCodePoint(cp) {
        Success { value } => decoded(afterHex(c, n), acc + value)
        Error => Error { message: failStr(tomlBadEscape, start) }
    }

    fn afterHex(c, n) = match n == 0 {
        true => c
        false => afterHex(advance(c), n - 1)
    }

    /// A `'...'` literal string from its opening quote: no escapes, same
    /// control-byte and termination rules as a basic string.
    export fn literalString(c) = quotedString(c, apostrophe, false)
}
